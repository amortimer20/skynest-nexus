---
import { Image } from "astro:assets";

export interface Props {
  /** An imported image. */
  image: ImageMetadata;
  /** Real description of the image. Required — it is what screen readers announce. */
  alt: string;
  /** Optional explicit id for the lightbox. Derived from the filename when omitted. */
  target?: string;
  /** Width of the inline thumbnail. The lightbox always shows the original. */
  thumbWidth?: number;
}

const { image, alt, target, thumbWidth = 1000 } = Astro.props;

// A hand-written target is easy to duplicate, and two lightboxes sharing an id
// silently break each other. Default to the filename instead.
const slug =
  image.src
    .split("/")
    .pop()
    ?.replace(/\.[a-z0-9]+$/i, "")
    .replace(/\W+/g, "-")
    .toLowerCase() ?? "image";
const dialogId = (target ?? `lightbox-${slug}`).replace(/^#/, "");

// SVG has no raster size to optimize and Astro passes it through untouched.
const isVector = image.format === "svg";
const thumbW = Math.min(thumbWidth, image.width);

// A slot can only be rendered once, so capture it and reuse the markup in both
// the figure and the lightbox.
const caption = Astro.slots.has("caption")
  ? await Astro.slots.render("caption")
  : null;
---

<figure class="lightbox-figure">
  <button
    type="button"
    class="lightbox-trigger"
    data-lightbox-open={dialogId}
    aria-label={`View full size: ${alt}`}
  >
    {
      isVector ? (
        <img
          src={image.src}
          width={image.width}
          height={image.height}
          class="img-fluid lightbox-thumb"
          alt={alt}
        />
      ) : (
        <Image
          src={image}
          width={thumbW}
          densities={[1, 2]}
          format="webp"
          class="img-fluid lightbox-thumb"
          alt={alt}
        />
      )
    }
    <span class="lightbox-hint" aria-hidden="true">Enlarge</span>
  </button>
  {caption && <figcaption class="lightbox-figcaption" set:html={caption} />}
</figure>

<dialog id={dialogId} class="lightbox-dialog" aria-label={alt}>
  <div class="lightbox-shell">
    <button
      type="button"
      class="btn btn-sm btn-outline-primary lightbox-close"
      data-lightbox-close
      aria-label="Close"
    >
      <i class="si-close" aria-hidden="true"></i>
    </button>

    <div class="lightbox-scroll">
      <img
        src={image.src}
        width={image.width}
        height={image.height}
        class="lightbox-full"
        alt={alt}
        loading="lazy"
        decoding="async"
        data-lightbox-zoom
      />
    </div>

    {caption && <p class="lightbox-caption" set:html={caption} />}
  </div>
</dialog>

<style>
  .lightbox-figure {
    margin: 0 0 1rem;
  }

  .lightbox-trigger {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  /*
    Square corners and a theme-colored edge, so a screenshot reads as part of
    the site rather than as a pasted-in picture. Same treatment .bottom-shadow
    gives the page headers: a one-pixel theme border plus a theme glow.
  */
  .lightbox-thumb {
    display: block;
    border: solid 1px rgba(var(--color-theme-rgb), 0.4);
    border-radius: 0;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .lightbox-trigger:hover .lightbox-thumb,
  .lightbox-trigger:focus-visible .lightbox-thumb {
    border-color: var(--color-theme);
    box-shadow: 0 0 10px var(--color-theme);
  }

  .lightbox-trigger:focus-visible {
    outline: solid 2px var(--color-theme);
    outline-offset: 4px;
  }

  .lightbox-hint {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.1rem 0.5rem;
    border: solid 1px var(--color-theme);
    background: var(--skynest-darker);
    color: var(--color-theme);
    font-family: var(--font-orbitron);
    font-size: 0.7rem;
    font-weight: bold;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
  }

  .lightbox-trigger:hover .lightbox-hint,
  .lightbox-trigger:focus-visible .lightbox-hint {
    opacity: 1;
  }

  .lightbox-figcaption {
    margin-top: 0.5rem;
    color: var(--bs-secondary-color);
    font-size: 0.875rem;
  }

  /*
    A native dialog renders in the browser's top layer, so no ancestor's
    stacking context, overflow or transform can clip or hide it. That is the
    whole reason for using one here.
  */
  .lightbox-dialog {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 3rem 1rem 1rem;
    border: 0;
    /*
      The theme wash lives on the dialog rather than on ::backdrop, because
      the switcher sets --color-theme on <body> and ::backdrop has inherited
      from different places across browser versions. The dialog element itself
      inherits normally, so the theme is guaranteed to follow the switcher.
    */
    background: rgba(var(--color-theme-rgb), 0.05);
    overflow: hidden;
  }

  .lightbox-dialog:not([open]) {
    display: none;
  }

  .lightbox-dialog[open] {
    display: grid;
    place-items: center;
  }

  /* rgb(5, 0, 20) is --skynest-darker, which has no rgb triplet to alpha. */
  .lightbox-dialog::backdrop {
    background: rgba(5, 0, 20, 0.92);
  }

  .lightbox-shell {
    position: relative;
    display: flex;
    flex-direction: column;
    max-width: 100%;
    max-height: 100%;
    min-width: 0;
  }

  .lightbox-close {
    position: absolute;
    top: -2.75rem;
    right: 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.6rem;
    line-height: 1;
  }

  /* btn-sm leaves the glyph at 14px, which is a small target to aim at. */
  .lightbox-close i {
    font-size: 1.25rem;
  }

  .lightbox-scroll {
    overflow: auto;
    min-height: 0;
    border: solid 1px var(--color-theme);
    box-shadow: 0 0 10px var(--color-theme);
  }

  /* Fitted by default; clicking swaps to true pixel size and the box scrolls. */
  .lightbox-full {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    height: auto;
    cursor: zoom-in;
  }

  .lightbox-full.is-actual {
    max-width: none;
    max-height: none;
    width: auto;
    cursor: zoom-out;
  }

  .lightbox-caption {
    flex: none;
    margin: 0.75rem 0 0;
    color: var(--bs-light);
    font-size: 0.875rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-thumb,
    .lightbox-hint {
      transition: none;
    }
  }
</style>

<style is:global>
  /* A dialog's backdrop does not stop the page behind it from scrolling. */
  html:has(dialog.lightbox-dialog[open]) {
    overflow: hidden;
  }
</style>

<script>
  // One delegated listener for every lightbox on the page. Astro bundles this
  // script once no matter how many times the component is used.
  document.addEventListener("click", (event) => {
    const el = event.target;
    if (!(el instanceof Element)) return;

    const opener = el.closest("[data-lightbox-open]");
    if (opener instanceof HTMLElement) {
      const id = opener.dataset.lightboxOpen;
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }

    if (el.closest("[data-lightbox-close]")) {
      el.closest("dialog")?.close();
      return;
    }

    const zoomable = el.closest("[data-lightbox-zoom]");
    if (zoomable) {
      zoomable.classList.toggle("is-actual");
      return;
    }

    // Clicking the dialog itself means the click landed outside the image,
    // which is the gesture everyone expects to dismiss a lightbox.
    if (el instanceof HTMLDialogElement) el.close();
  });

  // Reset the zoom state so a reopened lightbox starts fitted.
  //
  // A dialog's close event does not bubble, so a listener on document only sees
  // it during the capture phase. Without the third argument this never fires.
  document.addEventListener(
    "close",
    (event) => {
      const dialog = event.target;
      if (!(dialog instanceof HTMLDialogElement)) return;
      dialog
        .querySelectorAll("[data-lightbox-zoom].is-actual")
        .forEach((img) => img.classList.remove("is-actual"));
    },
    true,
  );
</script>

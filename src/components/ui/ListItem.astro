---
import { Image } from "astro:assets";
import bullet1 from "../../assets/ui/list-icons/li-bullet-1.svg";
import bullet2 from "../../assets/ui/list-icons/li-bullet-2.svg";
import bullet3 from "../../assets/ui/list-icons/li-bullet-3.svg";

export interface Props {
  variant?: string;
  className?: string;
  /** Short label shown as a badge after the item, e.g. "Optional" or "Extra Credit". */
  tag?: string;
  /** Badge color: "muted" (default) or "gold". */
  tone?: "muted" | "gold";
}

let {
  variant = "1",
  className = "",
  tag = "",
  tone = "muted",
} = Astro.props;

const bulletImages: Record<string, ImageMetadata> = {
  "1": bullet1,
  "2": bullet2,
  "3": bullet3
};
---

<li class={className}>
  {
    bulletImages[variant] && (
      <Image src={bulletImages[variant]} class="icon" alt="icon" />
    )
  }
  <slot />
  {tag && <span class:list={["item-tag", tone]}>{tag}</span>}
</li>

<style>
  li {
    list-style: none;
    width: fit-content;
    font-size: 1rem;

    .icon {
      width: 1.5rem;
      height: 1.5rem;
      margin: 0.25rem;
      animation: spin 5s linear infinite;
    }

    &:hover {
      .icon {
        animation: spin 1s linear infinite;
      }
    }

    .item-tag {
      display: inline-block;
      margin-left: 0.6rem;
      padding: 0.05rem 0.45rem;
      border: 1px solid currentColor;
      border-radius: 0.75rem;
      font-size: 0.7rem;
      line-height: 1.5;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      white-space: nowrap;
      vertical-align: 0.1em;
      opacity: 0.85;

      &.muted {
        color: #9aa4b2;
      }

      &.gold {
        color: var(--eds-gold);
      }
    }
  }
</style>

---
export interface Props {
  href: string;
  icon?: string;
  srLabel?: string;
  className?: string;
  /** Short label shown as a badge after the item, e.g. "Extra Credit". */
  tag?: string;
  /** Badge color: "muted" (default) or "gold". */
  tone?: "muted" | "gold";
}

const {
  href,
  icon = "si-terminal",
  srLabel = "Code challenge",
  className = "",
  tag = "",
  tone = "muted",
} = Astro.props;
---

<li class={`challenge-item ${className}`}>
  <i class={`${icon} icon`} aria-hidden="true"></i>
  <a href={href}>
    <span class="visually-hidden">{srLabel}: </span><slot />
  </a>
  {tag && <span class:list={["item-tag", tone]}>{tag}</span>}
</li>

<style>
  .challenge-item {
    list-style: none;
    width: fit-content;
    font-size: 1rem;
    margin-left: 2rem;
    display: flex;
    align-items: center;

    .icon {
      font-size: 1.1rem;
      margin: 0.25rem 0.5rem 0.25rem 0.25rem;
      color: var(--skynest-purple-lighten);
      flex-shrink: 0;
      transition: transform 0.2s ease-out;
    }

    &:hover .icon {
      transform: rotate(-15deg) scale(1.15);
    }

    .item-tag {
      display: inline-block;
      margin-left: 0.6rem;
      padding: 0.05rem 0.45rem;
      border: 1px solid currentColor;
      border-radius: 0.75rem;
      font-size: 0.7rem;
      line-height: 1.5;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      white-space: nowrap;
      opacity: 0.85;

      &.muted {
        color: #9aa4b2;
      }

      &.gold {
        color: var(--eds-gold);
      }
    }
  }
</style>

---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `My phone tells me my daily average screen time and it never
means anything to me. I want to see it as hours per week,
and as a percentage of the time I am actually awake, because
I think that number will be more upsetting.`;

const SampleOutput = `Daily screen time (minutes): 210

That is 1470 minutes per week
That is 24.5 hours per week
That is 21.9% of your waking hours`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-1/cc-set-1" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 1
        </a>

        <h1>Code Challenge: Screen Time</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code
            code={Brief}
            frame="code"
            lang="txt"
            title="What they asked for"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-1/cc-set-1">Set 1</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li>The phone reports minutes per day. The person wants hours per week. That is two conversions, not one.</li>
            <li>Time I am actually awake is not defined anywhere in the brief. You have to decide what counts, and write that decision down in your requirements list.</li>
            <li>Give the percentage to one decimal place.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-3">This sample assumes 16 waking hours a day. If you assumed something else your percentage will differ, and that is correct as long as your requirements list says what you assumed.</p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-screen-time</b>.
          </p>
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `I work the ticket counter and I keep having to look up which
ratings I can sell to a kid without a parent. Type in an age,
tell me what they can see on their own.`;

const SampleOutput = `Age: 14

They can see G, PG, and PG-13 on their own.
R requires an adult.`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="./cc-set-2" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 2
        </a>

        <h1>Code Challenge: Movie Rating</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code
            code={Brief}
            frame="code"
            lang="txt"
            title="What they asked for"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="./cc-set-2">Set 2</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li>The ratings are G, PG, PG-13, and R. Look up the age rules if you do not know them; getting the rules right is part of the job.</li>
            <li>One age is a boundary between two answers. Decide which side it falls on.</li>
            <li>Output should read like an answer to the question asked, not like a list of every rating.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-3">Your wording can differ. The rules cannot.</p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-movie-rating</b>.
          </p>
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

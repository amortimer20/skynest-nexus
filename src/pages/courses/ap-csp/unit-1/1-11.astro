---
import Presentation from "../../../../components/Presentation.astro";
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";
import { Code as CodeSnippet } from "astro:components";

//#region CodeSnippets
const Figure1 = `console.log(7 > 3);
console.log(7 < 3);`;
const Figure2 = `true
false`;
const Figure3 = `let score = 85;
let passed = score >= 60;

console.log("Score:", score);
console.log("Passed:", passed);`;
const Figure4 = `Score: 85
Passed: true`;
const Figure5 = `let a = 5;

a = 7;         // assignment: put 7 into a
console.log(a === 7);   // comparison: is a equal to 7?`;
const Figure6 = `console.log("7" === 7);
console.log("7" == 7);`;
const Figure7 = `false
true`;
const Figure8 = `let ready = confirm("Ready to start?");

console.log("Ready:", ready);`;
const Figure9 = `Ready to start? [y/N] y
Ready: true`;
const Figure10 = `let raw = prompt("Ready to start? (y/n)");
let ready = raw === "y";

let readyAgain = confirm("Ready to start?");`;
const NotationJs = `let score = 85;
let passed = score >= 60;
let perfect = score === 100;
let failed = score !== 100;`;
const NotationPseudo = `score ← 85
passed ← score ≥ 60
perfect ← score = 100
failed ← score ≠ 100`;
const Task1 = `let temperature = 31;

console.log("Temperature:", temperature);
console.log("Above freezing:", temperature > 0);
console.log("Below boiling:", temperature < 100);
`;
const Task2 = `let temperature = 31;
let humidity = 82;

console.log("Temperature:", temperature);
console.log("Above freezing:", temperature > 0);
console.log("Below boiling:", temperature < 100);
console.log("");

let isHot = temperature >= 30;
let isHumid = humidity >= 70;
let isExactlyFreezing = temperature === 0;

console.log("Hot:", isHot);
console.log("Humid:", isHumid);
console.log("Exactly freezing:", isExactlyFreezing);
`;
const Task3 = `let temperature = 31;
let humidity = 82;

console.log("Temperature:", temperature);
console.log("Above freezing:", temperature > 0);
console.log("Below boiling:", temperature < 100);
console.log("");

let isHot = temperature >= 30;
let isHumid = humidity >= 70;
let isExactlyFreezing = temperature === 0;

console.log("Hot:", isHot);
console.log("Humid:", isHumid);
console.log("Exactly freezing:", isExactlyFreezing);
console.log("");

// Ask the user for a wind speed and cast it to a number
// Store whether the wind is at or above 40
// Store whether the wind is NOT exactly zero
// Display both results with labels

// Ask with confirm() whether the boat is in open water
// Display that answer with a label
`;
const ExampleOutput = `Temperature: 31
Above freezing: true
Below boiling: true

Hot: true
Humid: true
Exactly freezing: false

Wind speed? 12
High wind: false
Wind is moving: true

In open water? [y/N] y
Open water: true
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Activity 1.11: Booleans and Comparison</h1>
        <Divider variant="8" classes="mb-5" />

        <!-- Launch / Concept -->
        <section id="launch">
          <Presentation>
            <section>
              <h2>Activity 1.11</h2>
              <h3 class="text-sn-theme">Booleans and Comparison</h3>
            </section>

            <section>
              <h2>Key Concepts</h2>
              <p>Comparisons Produce Values</p>
              <p>Storing a Comparison</p>
              <p>Assignment vs. Equality</p>
              <p>Asking the User Directly</p>
            </section>

            <section data-auto-animate>
              <h2>A Comparison Is a Question</h2>
              <p>And a question has an answer.</p>
            </section>

            <section data-auto-animate>
              <h2>A Comparison Is a Question</h2>
              <Code
                code={Figure1}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure2}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
              <p class="fragment">
                You met <CodeSnippet
                  code="true"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> and <CodeSnippet
                  code="false"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> in Activity 1.5 as things you typed. Now the computer is
                producing them.
              </p>
            </section>

            <section>
              <h2>The Six Comparisons</h2>
              <div class="text-start">
                <dl>
                  <dt>
                    <CodeSnippet code=">" lang={"javascript"} theme={"material-theme-ocean"} inline /> and <CodeSnippet code="<" lang={"javascript"} theme={"material-theme-ocean"} inline />
                  </dt>
                  <dd>greater than, less than</dd>
                  <dt>
                    <CodeSnippet code=">=" lang={"javascript"} theme={"material-theme-ocean"} inline /> and <CodeSnippet code="<=" lang={"javascript"} theme={"material-theme-ocean"} inline />
                  </dt>
                  <dd>greater or equal, less or equal</dd>
                  <dt>
                    <CodeSnippet code="===" lang={"javascript"} theme={"material-theme-ocean"} inline />
                  </dt>
                  <dd>is exactly equal to</dd>
                  <dt>
                    <CodeSnippet code="!==" lang={"javascript"} theme={"material-theme-ocean"} inline />
                  </dt>
                  <dd>is not equal to</dd>
                </dl>
              </div>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Storing the Answer</h2>
              <Code
                code={Figure3}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure4}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
            </section>

            <section data-auto-animate>
              <h2>Storing the Answer</h2>
              <p>
                <CodeSnippet
                  code="passed"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> does not hold 85. It holds the <i>answer to a question about</i>{" "}
                85.
              </p>
              <p class="fragment">
                Naming these well matters. <CodeSnippet
                  code="passed"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                />, <CodeSnippet
                  code="isHot"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                />, <CodeSnippet
                  code="hasKey"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> &mdash; a boolean's name should read like a yes-or-no question.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>One Equals Sign, or Three?</h2>
              <Code
                code={Figure5}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
              />
            </section>

            <section data-auto-animate>
              <h2>One Equals Sign, or Three?</h2>
              <div class="text-start">
                <ul>
                  <li class="fragment">
                    <CodeSnippet code="=" lang={"javascript"} theme={"material-theme-ocean"} inline /> <b>puts a value into</b> a variable
                  </li>
                  <li class="fragment">
                    <CodeSnippet code="===" lang={"javascript"} theme={"material-theme-ocean"} inline /> <b>asks whether</b> two things are equal
                  </li>
                </ul>
              </div>
              <p class="fragment">
                They look similar and do completely unrelated jobs. Mixing them
                up is one of the most common bugs there is.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Why Three and Not Two?</h2>
              <Code
                code={Figure6}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure7}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
            </section>

            <section data-auto-animate>
              <h2>Why Three and Not Two?</h2>
              <p>
                <CodeSnippet
                  code="=="
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> quietly converts types before comparing, so the text{" "}
                <CodeSnippet
                  code='"7"'
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> counts as equal to the number <CodeSnippet
                  code="7"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                />.
              </p>
              <p class="fragment">
                That is the same silent conversion that bit you in Activity 1.9.{" "}
                <b class="text-sn-theme">Use <CodeSnippet code="===" lang={"javascript"} theme={"material-theme-ocean"} inline /> in this class.</b>{" "}
                It compares the value <i>and</i> the type, with no surprises.
              </p>
            </section>

            <section data-auto-animate>
              <h2>A Boolean Without a Comparison</h2>
              <p>
                Every boolean so far came out of a comparison. There is one more
                way to get one: <b class="text-sn-theme">ask the person running
                the program.</b>
              </p>
              <Code
                code={Figure8}
                frame="code"
                lang="javascript"
                showLineNumbers={false}
                class="fragment"
              />
              <Code
                code={Figure9}
                frame="terminal"
                lang="txt"
                showLineNumbers={false}
                class="fragment"
              />
            </section>

            <section data-auto-animate>
              <h2>A Boolean Without a Comparison</h2>
              <p>
                <CodeSnippet
                  code="confirm()"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> asks a yes-or-no question and hands back a real boolean.
              </p>
              <p class="fragment">
                <b class="text-sn-theme">Nothing needs casting.</b>{" "}
                <CodeSnippet
                  code="prompt()"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> always gives you a string, which is why Activity 1.9 made you
                wrap it in <CodeSnippet code="Number()" lang={"javascript"} theme={"material-theme-ocean"} inline />.{" "}
                <CodeSnippet
                  code="confirm()"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> gives you <CodeSnippet code="true" lang={"javascript"} theme={"material-theme-ocean"} inline /> or{" "}
                <CodeSnippet code="false" lang={"javascript"} theme={"material-theme-ocean"} inline /> and nothing else.
              </p>
            </section>

            <section data-auto-animate>
              <h2>Only <CodeSnippet code="y" lang={"javascript"} theme={"material-theme-ocean"} inline /> Means Yes</h2>
              <p>
                Look at the <CodeSnippet code="[y/N]" lang={"txt"} theme={"material-theme-ocean"} inline /> hint. It is telling you
                the rule.
              </p>
              <p class="fragment">
                <b class="text-sn-theme">Only <CodeSnippet code="y" lang={"javascript"} theme={"material-theme-ocean"} inline /> or{" "}
                <CodeSnippet code="Y" lang={"javascript"} theme={"material-theme-ocean"} inline /> count as yes.</b> Everything
                else is a no &mdash; including the word{" "}
                <CodeSnippet code="yes" lang={"javascript"} theme={"material-theme-ocean"} inline />, which surprises people.
              </p>
              <p class="fragment">
                The capital <CodeSnippet code="N" lang={"txt"} theme={"material-theme-ocean"} inline /> is the default. Pressing
                Enter without typing anything is a no.
              </p>
            </section>

            <section data-auto-animate>
              <h2>Why Not Just Ask With <CodeSnippet code="prompt()" lang={"javascript"} theme={"material-theme-ocean"} inline />?</h2>
              <Code
                code={Figure10}
                frame="code"
                lang="javascript"
                showLineNumbers={false}
              />
              <p class="fragment">
                Both lines end up with a boolean. The first one takes two steps
                and a string comparison you have to get exactly right.{" "}
                <b class="text-sn-theme">The second is one step and cannot be
                spelled wrong.</b>
              </p>
            </section>

            <section>
              <h2>Today's Objectives</h2>
              <ul>
                <li>Writing comparisons with all six operators</li>
                <li>Storing a comparison's result in a variable</li>
                <li>Naming boolean variables as questions</li>
                <li>
                  Telling assignment and equality apart
                </li>
                <li>
                  Getting a boolean straight from the user with{" "}
                  <CodeSnippet code="confirm()" lang={"javascript"} theme={"material-theme-ocean"} inline />
                </li>
              </ul>
            </section>

            <section>
              <h2>Key Terms</h2>
              <div class="text-start">
                <dl>
                  <dt>Comparison operator</dt>
                  <dd>
                    A symbol that compares two values and produces a boolean.
                  </dd>
                  <dt>Boolean expression</dt>
                  <dd>
                    A piece of code that evaluates to <CodeSnippet code="true" lang={"javascript"} theme={"material-theme-ocean"} inline /> or <CodeSnippet code="false" lang={"javascript"} theme={"material-theme-ocean"} inline />.
                  </dd>
                  <dt>Assignment</dt>
                  <dd>
                    Putting a value into a variable, written with a single{" "}
                    <CodeSnippet code="=" lang={"javascript"} theme={"material-theme-ocean"} inline />.
                  </dd>
                  <dt>Equality</dt>
                  <dd>
                    Asking whether two values match, written with{" "}
                    <CodeSnippet code="===" lang={"javascript"} theme={"material-theme-ocean"} inline />.
                  </dd>
                  <dt>
                    <CodeSnippet code="confirm()" lang={"javascript"} theme={"material-theme-ocean"} inline />
                  </dt>
                  <dd>
                    Asks the user a yes-or-no question and returns a boolean.
                    Only <CodeSnippet code="y" lang={"javascript"} theme={"material-theme-ocean"} inline /> or{" "}
                    <CodeSnippet code="Y" lang={"javascript"} theme={"material-theme-ocean"} inline /> means{" "}
                    <CodeSnippet code="true" lang={"javascript"} theme={"material-theme-ocean"} inline />.
                  </dd>
                </dl>
              </div>
            </section>
          </Presentation>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Build -->
        <section id="build">
          <h2>Build</h2>

          <p>
            Create a new <b>JavaScript</b> program named{" "}
            <b class="text-sn-theme">1-11-booleans</b>.
          </p>

          <hr class="my-4" />

          <h3>Task 1: Compare Directly</h3>
          <ul>
            <li>Write the code below and run it.</li>
            <li>
              Both comparisons are written straight inside{" "}
              <CodeSnippet
                code="console.log()"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              />. That is allowed &mdash; a comparison is a value like any other.
            </li>
            <li>
              Change the temperature to a negative number and run again.
            </li>
          </ul>

          <Code
            code={Task1}
            frame="code"
            lang="javascript"
            title="Booleans and Comparison"
          />

          <hr class="my-4" />

          <h3>Task 2: Store the Answers</h3>
          <ul>
            <li>Add a humidity reading and three named boolean variables.</li>
            <li>
              Note the names: each one reads like a yes-or-no question about the
              data.
            </li>
            <li>
              <CodeSnippet
                code="isExactlyFreezing"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> uses three equals signs. One would mean something completely
              different &mdash; try it and see what happens, then change it back.
            </li>
            <li>
              <b class="text-sn-theme">Note</b>: the green lines with a + sign
              are new code. Don't type the + sign.
            </li>
          </ul>

          <Code
            code={Task2}
            frame="code"
            lang="javascript"
            title="Booleans and Comparison"
            ins={{ range: "2, 7-15" }}
          />

          <hr class="my-4" />

          <h3>Task 3: Plan, Then Compare Some Input</h3>
          <ul>
            <li>
              The four comments describe a wind-speed check. Write the code under
              them.
            </li>
            <li>
              Remember to cast the input. An uncast comparison can behave in ways
              you will not expect, and Activity 1.9 explained why.
            </li>
            <li>
              "NOT exactly zero" is one comparison, not two. Look back at the six
              operators.
            </li>
            <li>
              The last two comments do not need a comparison at all.{" "}
              <CodeSnippet
                code="confirm()"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> already hands you a boolean, so store it and display it.{" "}
              <b>Do not wrap it in <CodeSnippet code="Number()" lang={"javascript"} theme={"material-theme-ocean"} inline />.</b>
            </li>
          </ul>

          <Code
            code={Task3}
            frame="code"
            lang="javascript"
            title="Booleans and Comparison"
            ins={{ range: "16-24" }}
          />

          <hr class="my-4" />

          <h3>Challenge (Optional): Break It With One Character</h3>
          <ul>
            <li>
              Copy this line to the bottom of your program:{" "}
              <CodeSnippet
                code="let check = temperature === 50;"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> and display <CodeSnippet
                code="check"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> and <CodeSnippet
                code="temperature"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              />.
            </li>
            <li>
              Now delete two of the equals signs so it reads{" "}
              <CodeSnippet
                code="temperature = 50"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              />. Run it again.
            </li>
            <li>
              Write a comment explaining what happened to both variables, and why
              no error appeared.
            </li>
          </ul>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Exam Notation -->
        <section id="exam-notation">
          <h2>Same Idea, Exam Notation</h2>

          <div class="row g-3 my-4">
            <div class="col-md-6">
              <Code
                code={NotationJs}
                frame="code"
                lang="javascript"
                title="JavaScript"
                showLineNumbers={false}
              />
            </div>
            <div class="col-md-6">
              <Code
                code={NotationPseudo}
                frame="code"
                lang="txt"
                title="Exam Notation"
                showLineNumbers={false}
              />
            </div>
          </div>

          <p>
            <b class="text-sn-theme">
              This is the panel where the two notations disagree most.
            </b>{" "}
            Read the middle column carefully.
          </p>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Meaning</th>
                  <th>JavaScript</th>
                  <th>Exam notation</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Put a value into a variable</td>
                  <td><code>=</code></td>
                  <td><code>←</code></td>
                </tr>
                <tr>
                  <td><b>Is equal to</b></td>
                  <td><code>===</code></td>
                  <td><b><code>=</code></b></td>
                </tr>
                <tr>
                  <td>Is not equal to</td>
                  <td><code>!==</code></td>
                  <td><code>≠</code></td>
                </tr>
                <tr>
                  <td>Greater or equal</td>
                  <td><code>&gt;=</code></td>
                  <td><code>≥</code></td>
                </tr>
                <tr>
                  <td>Less or equal</td>
                  <td><code>&lt;=</code></td>
                  <td><code>≤</code></td>
                </tr>
              </tbody>
            </table>
          </div>

          <p>
            <b>
              A single <code>=</code> means assignment in JavaScript and equality
              on the exam.
            </b>{" "}
            The same character, two opposite jobs, depending on which notation
            you are reading.
          </p>

          <p>
            Because the exam uses <code>←</code> for assignment, there is no
            ambiguity <i>within</i> the notation &mdash; the confusion only
            happens when you switch between the two. When you see{" "}
            <code>score = 100</code> on an exam question, it is asking a
            question, not setting a value.
          </p>

          <div class="alert alert-secondary mt-4">
            <p class="mb-2">
              <b class="text-sn-theme">
                There is no <code>confirm()</code> on the exam.
              </b>{" "}
              The reference sheet has exactly one way to get input,{" "}
              <code>INPUT()</code>, and it is not typed &mdash; it just returns
              whatever the user gave.
            </p>
            <p class="mb-0">
              So a yes-or-no question on an exam question looks like{" "}
              <code>answer ← INPUT()</code> followed by a comparison. That is the{" "}
              <code>prompt()</code> shape, not the <code>confirm()</code> shape.{" "}
              <b>
                <code>confirm()</code> is a convenience JavaScript gives you and
                the exam does not.
              </b>
            </p>
          </div>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Checkpoint -->
        <section id="checkpoint">
          <h2>Checkpoint</h2>

          <p>Verify your program works correctly.</p>

          <Code
            code={ExampleOutput}
            frame="terminal"
            lang="txt"
            showLineNumbers={false}
            title="Example Output"
            mark={{
              label: "Yours depends on the wind speed you enter",
              range: "10-11",
            }}
          />
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Reflection -->
        <section id="reflection">
          <h2>Reflection</h2>

          <p>Answer the following questions before submitting your work.</p>

          <ol>
            <li>
              <code>passed</code> stores the answer to a question rather than a
              number. Why is that more useful than storing the score again?
            </li>
            <li>
              Explain the difference between <code>=</code> and <code>===</code>{" "}
              in JavaScript, as if to someone who has never programmed.
            </li>
            <li>
              On the exam, a single <code>=</code> means "is equal to." Describe a
              mistake you could make by forgetting that.
            </li>
          </ol>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Submit -->
        <section id="submit">
          <h2>Submit</h2>

          <p>Submit the required files to the appropriate dropbox.</p>

          <h1
            class="text-center mt-5 text-sn-theme border border-primary slow-flash"
          >
            Activity Complete
          </h1>
        </section>
      </div>
    </div>
  </div>
</Layout>

---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `Is a number prime? I want to type one in and find out. And
if it is not prime, tell me something that divides it, so I
can see why.`;

const SampleOutput = `Number: 91

91 is not prime.
It divides by 7.`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-1/cc-set-3" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 3
        </a>

        <h1>Code Challenge: Prime Check</h1>

        <p>
          <span class="badge text-bg-warning">Extra Credit</span>
          <span class="ms-2 text-body-secondary"
            >Not part of the five required for this set.</span
          >
        </p>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code
            code={Brief}
            frame="code"
            lang="txt"
            title="What they asked for"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-1/cc-set-3">Set 3</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li>A number is prime if nothing between 2 and one less than itself divides it evenly.</li>
            <li>You already have the tool for "divides evenly" &mdash; it is the remainder operator from Activity 1.4.</li>
            <li>Stopping early once you find a divisor is not required, but think about why you might want to.</li>
            <li>1 and 2 are both special cases. Handle them deliberately rather than by accident.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-3">Check 2 (prime), 1 (not, by definition), and 97 (prime). If 1 reports as prime, you have not handled it.</p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-prime-check</b>.
          </p>
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

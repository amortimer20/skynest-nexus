---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `I need to print seat labels for the theater. Rows are
lettered and seats are numbered. Give me every seat in the
house, in order, so I can cut them up.`;

const SampleOutput = `Rows: 3
Seats per row: 4

A1 A2 A3 A4
B1 B2 B3 B4
C1 C2 C3 C4`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-1/cc-set-3" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 3
        </a>

        <h1>Code Challenge: Seating Chart</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code
            code={Brief}
            frame="code"
            lang="txt"
            title="What they asked for"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-1/cc-set-3">Set 3</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li>Two things vary, so this needs a loop inside a loop.</li>
            <li>Rows are letters and seats are numbers. Decide how you turn a row count into a letter without any string tools &mdash; the simplest answer is fine.</li>
            <li>Print each label on its own line, or all the seats of one row on one line. Either is fine; say which you chose.</li>
            <li>Work out on paper how many labels a 3-row, 4-seat theater produces before you run it.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-3">Three rows of four is twelve labels. If you get four rows or three labels, your loops are the wrong way round.</p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-seating-chart</b>.
          </p>
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `You already worked out what a trip costs me in gas. Here is
the thing though: the pump rounds. I buy 13.1 gallons, not
13.125 gallons, and the price I actually pay is based on the
rounded number. Redo it so it matches my receipt.`;

const SampleOutput = `How far are you driving (miles)? 420
What is your car's mpg? 32
Price per gallon? 3.49

Gallons (rounded): 13.1
Trip cost: $45.72`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-1/cc-set-1" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 1
        </a>

        <h1>Code Challenge: Fuel Calculator</h1>

        <p>
          <span class="badge text-bg-warning">Extra Credit</span>
          <span class="ms-2 text-body-secondary"
            >Not part of the five required for this set.</span
          >
        </p>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code
            code={Brief}
            frame="code"
            lang="txt"
            title="What they asked for"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-1/cc-set-1">Set 1</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li>Round the gallons to one decimal place <b>before</b> you calculate the cost, not after.</li>
            <li>This is not the same as printing a rounded number at the end. Prove it: 420 miles at 32 mpg and $3.49 a gallon comes to 45.81 one way and 45.72 the other.</li>
            <li>The tool you use to round returns text, not a number. If you multiply that text by a price and get something strange, that is Activity 1.9 biting again.</li>
            <li>Compare your answer against Trip Cost. If they match, you rounded in the wrong place.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-3">Trip Cost gives 45.806250000000006 for the same inputs. The nine-cent difference is the whole point of this challenge.</p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-fuel-calculator</b>.
          </p>
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

---
import Presentation from "../../../../components/Presentation.astro";
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";
import { Code as CodeSnippet } from "astro:components";

//#region CodeSnippets
const Figure1 = `let crew = ["Ada", "Bo", "Cy"];

console.log(crew.length);
console.log(crew[crew.length - 1]);`;
const Figure2 = `3
Cy`;
const Figure3 = `let crew = ["Ada", "Bo", "Cy"];

console.log(crew[3]);`;
const Figure4 = `undefined`;
const Figure5 = `let crew = ["Ada", "Bo", "Cy"];

let name = crew[3];

console.log("Welcome, " + name + "!");
console.log(name.length);`;
const Figure6 = `Welcome, undefined!
TypeError: undefined is not an object (evaluating 'name.length')`;
const Figure7 = `let crew = ["Ada", "Bo"];

crew.push("Cy");

console.log(crew);
console.log(crew.length);`;
const Figure8 = `[ "Ada", "Bo", "Cy" ]
3`;
const NotationJs = `let n = crew.length;
let last = crew[crew.length - 1];
crew.push("Dee");`;
const NotationPseudo = `n ← LENGTH(crew)
last ← crew[LENGTH(crew)]
APPEND(crew, "Dee")`;
const Task1 = `let crew = ["Ada", "Bo", "Cy", "Dee"];

console.log("Crew:", crew);
console.log("How many:", crew.length);
console.log("First:", crew[0]);
console.log("Last:", crew[crew.length - 1]);
`;
const Task2 = `let crew = ["Ada", "Bo", "Cy", "Dee"];

console.log("Crew:", crew);
console.log("How many:", crew.length);
console.log("First:", crew[0]);
console.log("Last:", crew[crew.length - 1]);
console.log("");

console.log("Off the end:", crew[4]);
console.log("");

crew.push("Eze");

console.log("After push:", crew);
console.log("How many now:", crew.length);
console.log("Last now:", crew[crew.length - 1]);
`;
const Task3 = `let crew = ["Ada", "Bo", "Cy", "Dee"];

console.log("Crew:", crew);
console.log("How many:", crew.length);
console.log("First:", crew[0]);
console.log("Last:", crew[crew.length - 1]);
console.log("");

console.log("Off the end:", crew[4]);
console.log("");

crew.push("Eze");

console.log("After push:", crew);
console.log("How many now:", crew.length);
console.log("Last now:", crew[crew.length - 1]);
console.log("");

// Ask the user for an index and cast it
// If it is a valid index for this array, show the name there
// Otherwise say the index is out of range, and say what the valid range is
`;
const ExampleOutput = `Crew: [ "Ada", "Bo", "Cy", "Dee" ]
How many: 4
First: Ada
Last: Dee

Off the end: undefined

After push: [ "Ada", "Bo", "Cy", "Dee", "Eze" ]
How many now: 5
Last now: Eze

Which index? 7
Out of range. Valid indexes are 0 to 4.
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Activity 1.24: Length and Safe Access</h1>
        <Divider variant="8" classes="mb-5" />

        <!-- Launch / Concept -->
        <section id="launch">
          <Presentation>
            <section>
              <h2>Activity 1.24</h2>
              <h3 class="text-sn-theme">Length and Safe Access</h3>
            </section>

            <section>
              <h2>Key Concepts</h2>
              <p>How Long Is It?</p>
              <p>Off By One</p>
              <p>Growing an Array</p>
            </section>

            <section data-auto-animate>
              <h2>length</h2>
              <Code
                code={Figure1}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure2}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
            </section>

            <section data-auto-animate>
              <h2>The Most Important Minus One</h2>
              <p>
                <CodeSnippet code="length" lang={"javascript"} theme={"material-theme-ocean"} inline /> counts the elements. Indexes start at 0.
              </p>
              <p class="fragment">
                So the last index is always{" "}
                <b class="text-sn-theme">length &minus; 1</b>. Three elements,
                last index 2.
              </p>
              <p class="fragment">
                <CodeSnippet code="crew[crew.length - 1]" lang={"javascript"} theme={"material-theme-ocean"} inline /> looks awkward and is worth
                memorizing as one unit: "the last one."
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Going Off the End</h2>
              <Code
                code={Figure3}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure4}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
              <p class="fragment">
                <b class="text-sn-theme">No error.</b> JavaScript hands back{" "}
                <CodeSnippet code="undefined" lang={"javascript"} theme={"material-theme-ocean"} inline /> and carries on.
              </p>
            </section>

            <section data-auto-animate>
              <h2>Why That Is Worse Than Crashing</h2>
              <Code
                code={Figure5}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure6}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
            </section>

            <section>
              <h2>The Damage Shows Up Late</h2>
              <p>
                The bad index was on line 3. The greeting printed happily. The
                crash came two lines later, pointing at somewhere the mistake
                is not.
              </p>
              <p class="fragment">
                Same shape as <CodeSnippet code="NaN" lang={"javascript"} theme={"material-theme-ocean"} inline /> in Activity 1.9 &mdash; a bad
                value travels quietly until something finally chokes on it.
              </p>
              <p class="fragment">
                <b class="text-sn-theme">
                  When you see undefined, look upstream.
                </b>
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Growing an Array</h2>
              <Code
                code={Figure7}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure8}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
              <p class="fragment">
                <CodeSnippet code="push()" lang={"javascript"} theme={"material-theme-ocean"} inline /> adds to the end, and{" "}
                <CodeSnippet code="length" lang={"javascript"} theme={"material-theme-ocean"} inline /> goes up to match. An array is not a fixed
                size.
              </p>
            </section>

            <section>
              <h2>Checking Before You Look</h2>
              <p>
                A valid index is <b>0 or more</b> and <b>less than length</b>.
              </p>
              <p class="fragment">
                Note that is <CodeSnippet code="< length" lang={"javascript"} theme={"material-theme-ocean"} inline />, not{" "}
                <CodeSnippet code="<= length" lang={"javascript"} theme={"material-theme-ocean"} inline />. The same off-by-one, in a new place.
              </p>
            </section>

            <section>
              <h2>Today's Objectives</h2>
              <ul>
                <li>Finding how many elements an array holds</li>
                <li>Reaching the last element without hard-coding its index</li>
                <li>Recognizing undefined and tracing it upstream</li>
                <li>Adding to an array and checking an index before using it</li>
              </ul>
            </section>

            <section>
              <h2>Key Terms</h2>
              <div class="text-start">
                <dl>
                  <dt><CodeSnippet code="length" lang={"javascript"} theme={"material-theme-ocean"} inline /></dt>
                  <dd>How many elements an array currently holds.</dd>
                  <dt>Off-by-one error</dt>
                  <dd>
                    A mistake of exactly one position, usually at the start or end
                    of a range.
                  </dd>
                  <dt><CodeSnippet code="undefined" lang={"javascript"} theme={"material-theme-ocean"} inline /></dt>
                  <dd>What JavaScript returns when a value does not exist.</dd>
                  <dt>Bounds check</dt>
                  <dd>Testing that an index is valid before using it.</dd>
                </dl>
              </div>
            </section>
          </Presentation>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Build -->
        <section id="build">
          <h2>Build</h2>

          <p>
            Create a new <b>JavaScript</b> program named{" "}
            <b class="text-sn-theme">1-24-length</b>.
          </p>

          <hr class="my-4" />

          <h3>Task 1: Length and the Last One</h3>
          <ul>
            <li>Write the code below and run it.</li>
            <li>
              Add a fifth name to the array literal and run again{" "}
              <b>without changing anything else</b>. The last-element line should
              still be right. That is why it is written with{" "}
              <CodeSnippet code="length - 1" lang={"javascript"} theme={"material-theme-ocean"} inline /> instead of a number.
            </li>
            <li>Remove the fifth name again before continuing.</li>
          </ul>

          <Code
            code={Task1}
            frame="code"
            lang="javascript"
            title="Length and Safe Access"
          />

          <hr class="my-4" />

          <h3>Task 2: Off the End, and Growing</h3>
          <ul>
            <li>
              Add a deliberate out-of-range read, then a{" "}
              <CodeSnippet code="push()" lang={"javascript"} theme={"material-theme-ocean"} inline />.
            </li>
            <li>
              Notice that <CodeSnippet code="crew[4]" lang={"javascript"} theme={"material-theme-ocean"} inline /> was invalid at first and became
              valid after the push. Nothing about the code changed &mdash; the
              array did.
            </li>
            <li>
              <b class="text-sn-theme">Note</b>: the green lines with a + sign
              are new code. Don't type the + sign.
            </li>
          </ul>

          <Code
            code={Task2}
            frame="code"
            lang="javascript"
            title="Length and Safe Access"
            ins={{ range: "7-16" }}
          />

          <hr class="my-4" />

          <h3>Task 3: Plan, Then Check Before You Look</h3>
          <ul>
            <li>
              The comments describe a bounds check. Write the code under them.
            </li>
            <li>
              The condition needs two comparisons joined with AND, from Activity
              1.15. An index can be too small as well as too big.
            </li>
            <li>
              The valid range message must use <CodeSnippet code="length" lang={"javascript"} theme={"material-theme-ocean"} inline />, not the
              number 4. Your array grew by one in Task 2, and it might grow
              again.
            </li>
            <li>Test with &minus;1, with 2, and with 99.</li>
          </ul>

          <Code
            code={Task3}
            frame="code"
            lang="javascript"
            title="Length and Safe Access"
            ins={{ range: "17-21" }}
          />

          <hr class="my-4" />

          <h3>Challenge (Optional): Catch It Early</h3>
          <ul>
            <li>
              Recreate the crash from the slides: read an out-of-range element
              into a variable, then try to use <CodeSnippet code=".length" lang={"javascript"} theme={"material-theme-ocean"} inline /> on it.
            </li>
            <li>
              Read the error message. Note which line it blames and which line
              actually caused it.
            </li>
            <li>
              Then add a check that stops the program from ever reaching that
              line with a bad value, and write a comment about which version you
              would rather debug at 2am.
            </li>
          </ul>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Exam Notation -->
        <section id="exam-notation">
          <h2>Same Idea, Exam Notation</h2>

          <div class="row g-3 my-4">
            <div class="col-md-6">
              <Code
                code={NotationJs}
                frame="code"
                lang="javascript"
                title="JavaScript"
                showLineNumbers={false}
              />
            </div>
            <div class="col-md-6">
              <Code
                code={NotationPseudo}
                frame="code"
                lang="txt"
                title="Exam Notation"
                showLineNumbers={false}
              />
            </div>
          </div>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Meaning</th>
                  <th>JavaScript</th>
                  <th>Exam notation</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>How many elements</td>
                  <td><code>crew.length</code></td>
                  <td><code>LENGTH(crew)</code></td>
                </tr>
                <tr>
                  <td>Add to the end</td>
                  <td><code>crew.push(x)</code></td>
                  <td><code>APPEND(crew, x)</code></td>
                </tr>
                <tr>
                  <td>Insert at a position</td>
                  <td>&mdash;</td>
                  <td><code>INSERT(crew, i, x)</code></td>
                </tr>
                <tr>
                  <td>Remove at a position</td>
                  <td>&mdash;</td>
                  <td><code>REMOVE(crew, i)</code></td>
                </tr>
              </tbody>
            </table>
          </div>

          <p>
            <code>INSERT</code> and <code>REMOVE</code> have no simple JavaScript
            equivalent, so you will only ever <i>read</i> those two. Know that{" "}
            <code>INSERT</code> shifts later elements right and <code>REMOVE</code>{" "}
            shifts them left, and that both change the length.
          </p>

          <h4 class="mt-4">The Last Element Has No Minus One</h4>

          <p>
            Because exam lists start at 1, the last element is at{" "}
            <code>LENGTH(crew)</code> exactly &mdash; not{" "}
            <code>LENGTH(crew) - 1</code>.
          </p>

          <p>
            That is genuinely tidier than JavaScript, and it is a trap in both
            directions. Writing <code>crew[LENGTH(crew) - 1]</code> on the exam
            gets you the <i>second to last</i>.
          </p>

          <h4 class="mt-4">And Going Off the End Stops the Program</h4>

          <p>
            The reference sheet is explicit: if an index is less than 1 or greater
            than the length, <b>an error is produced and the program terminates</b>.
          </p>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th></th>
                  <th>Reading an invalid index</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>JavaScript</td>
                  <td><code>undefined</code>, and the program keeps running</td>
                </tr>
                <tr>
                  <td>Exam notation</td>
                  <td>Error, and the program <b>stops immediately</b></td>
                </tr>
              </tbody>
            </table>
          </div>

          <p>
            Same mistake, opposite symptom. If an exam question walks a list one
            step too far, the answer is not "it displays undefined" &mdash; it is
            that <b>nothing after that point happens at all</b>.
          </p>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Checkpoint -->
        <section id="checkpoint">
          <h2>Checkpoint</h2>

          <p>Verify your program works correctly.</p>

          <Code
            code={ExampleOutput}
            frame="terminal"
            lang="txt"
            showLineNumbers={false}
            title="Example Output"
            mark={[
              { label: "No error — just undefined", range: "6" },
              { label: "Range comes from length, not a typed-in number", range: "13" },
            ]}
          />

          <p class="mt-3">
            Your bounds check must reject &minus;1 as well as 99. If only large
            numbers are caught, half the condition is missing.
          </p>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Reflection -->
        <section id="reflection">
          <h2>Reflection</h2>

          <p>Answer the following questions before submitting your work.</p>

          <ol>
            <li>
              Why is <code>crew[crew.length - 1]</code> better than{" "}
              <code>crew[3]</code>, even when the array happens to have four
              elements?
            </li>
            <li>
              JavaScript returns <code>undefined</code> for a bad index; the exam
              notation stops the program. Which behavior would you rather have
              while writing code, and which while running a finished program?
            </li>
            <li>
              You have now met <code>NaN</code> and <code>undefined</code>. What
              do they have in common, and what should you do when you see either
              one?
            </li>
          </ol>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Submit -->
        <section id="submit">
          <h2>Submit</h2>

          <p>Submit the required files to the appropriate dropbox.</p>

          <h1
            class="text-center mt-5 text-sn-theme border border-primary slow-flash"
          >
            Activity Complete
          </h1>
        </section>
      </div>
    </div>
  </div>
</Layout>

---
import Presentation from "../../../../components/Presentation.astro";
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";
import { Code as CodeSnippet } from "astro:components";

//#region CodeSnippets
const Figure1 = `let playerName = prompt("What is your name?");
console.log("Welcome aboard,", playerName);`;
const Figure2 = `What is your name? Jordan
Welcome aboard, Jordan`;
const Figure3 = `let color = prompt("Favorite color?");
let animal = prompt("Favorite animal?");

console.log("Your callsign is the", color, animal + ".");`;
const Figure4 = `Favorite color? Silver
Favorite animal? Hawk
Your callsign is the Silver Hawk.`;
const Figure5 = `let age = prompt("How old are you?");
console.log(age + 1);`;
const Figure6 = `How old are you? 16
161`;
const NotationJs = `let name = prompt("Name?");
console.log("Hello,", name);`;
const NotationPseudo = `DISPLAY("Name?")
name ← INPUT()
DISPLAY("Hello,")
DISPLAY(name)`;
const Task1 = `let pilotName = prompt("Pilot name?");

console.log("Welcome aboard,", pilotName);
`;
const Task2 = `let pilotName = prompt("Pilot name?");
let homePort = prompt("Home port?");
let shipName = prompt("Name your ship:");

console.log("");
console.log("=== FLIGHT REGISTRATION ===");
console.log("Pilot:", pilotName);
console.log("Port:", homePort);
console.log("Ship:", shipName);
`;
const Task3 = `let pilotName = prompt("Pilot name?");
let homePort = prompt("Home port?");
let shipName = prompt("Name your ship:");

console.log("");
console.log("=== FLIGHT REGISTRATION ===");
console.log("Pilot:", pilotName);
console.log("Port:", homePort);
console.log("Ship:", shipName);

// Ask for a destination
// Ask for a cargo type
// Print a one-line summary using all five answers
`;
const ExampleOutput = `Pilot name? Jordan
Home port? Ganymede
Name your ship: Vega
Destination? Titan
Cargo type? ice

=== FLIGHT REGISTRATION ===
Pilot: Jordan
Port: Ganymede
Ship: Vega
Jordan is flying Vega from Ganymede to Titan carrying ice.
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Activity 1.7: Console Input</h1>
        <Divider variant="8" classes="mb-5" />

        <!-- Launch / Concept -->
        <section id="launch">
          <Presentation>
            <section>
              <h2>Activity 1.7</h2>
              <h3 class="text-sn-theme">Console Input</h3>
            </section>

            <section>
              <h2>Key Concepts</h2>
              <p>Asking the User a Question</p>
              <p>Storing the Answer</p>
              <p>Input Is Always Text</p>
            </section>

            <section data-auto-animate>
              <h2>Programs That Ask</h2>
              <p>
                Everything you have written so far does exactly the same thing
                every time it runs.
              </p>
              <p class="fragment">
                <CodeSnippet
                  code="prompt()"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> changes that. It asks a question and hands back whatever the
                user typed.
              </p>
            </section>

            <section data-auto-animate>
              <h2>Programs That Ask</h2>
              <Code
                code={Figure1}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure2}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
            </section>

            <section>
              <h2>Reading That Line</h2>
              <div class="text-start">
                <ul>
                  <li class="fragment">
                    The text in the parentheses is the question shown to the user
                  </li>
                  <li class="fragment">
                    The answer comes back out and gets stored in the variable
                  </li>
                  <li class="fragment">
                    Nothing is saved unless you put it in a variable
                  </li>
                </ul>
              </div>
              <p class="fragment">
                That last one catches people. Calling <CodeSnippet
                  code="prompt()"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> on its own asks the question and then throws the answer away.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Several Questions</h2>
              <Code
                code={Figure3}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure4}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
            </section>

            <section data-auto-animate>
              <h2>Several Questions</h2>
              <p>
                Each answer needs its own variable, or the second answer
                overwrites the first.
              </p>
              <p class="fragment">
                Notice <CodeSnippet
                  code='animal + "."'
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> &mdash; using <CodeSnippet
                  code="+"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> instead of a comma joins the period on with no space in front
                of it.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>The Catch</h2>
              <p>
                Whatever the user types comes back as <b class="text-sn-theme"
                  >text</b
                >. Always. Even when it looks like a number.
              </p>
            </section>

            <section data-auto-animate>
              <h2>The Catch</h2>
              <Code
                code={Figure5}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure6}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
            </section>

            <section>
              <h2>Why 161?</h2>
              <p>
                The user typed <CodeSnippet
                  code="16"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                />, so <CodeSnippet
                  code="age"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> holds the <i>text</i> <CodeSnippet
                  code='"16"'
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                />, not the number 16.
              </p>
              <p class="fragment">
                Adding to text does not do arithmetic &mdash; it sticks things
                together. So <CodeSnippet
                  code='"16" + 1'
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> becomes <CodeSnippet
                  code='"161"'
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                />.
              </p>
              <p class="fragment">
                No error. No warning. Just a wrong answer. We fix this next
                activity.
              </p>
            </section>

            <section>
              <h2>Today's Objectives</h2>
              <ul>
                <li>Asking the user a question and storing the answer</li>
                <li>Using several inputs in one program</li>
                <li>
                  Explaining why input is always text, even when it looks numeric
                </li>
              </ul>
            </section>

            <section>
              <h2>Key Terms</h2>
              <div class="text-start">
                <dl>
                  <dt>Input</dt>
                  <dd>Information a program receives while it is running.</dd>
                  <dt>Prompt</dt>
                  <dd>The question shown to the user when input is requested.</dd>
                  <dt>Return value</dt>
                  <dd>
                    The value a function hands back, which you can store in a
                    variable.
                  </dd>
                  <dt>Concatenation</dt>
                  <dd>Joining two pieces of text end to end.</dd>
                </dl>
              </div>
            </section>
          </Presentation>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Build -->
        <section id="build">
          <h2>Build</h2>

          <p>
            Create a new <b>JavaScript</b> program named{" "}
            <b class="text-sn-theme">1-7-input</b>.
          </p>

          <hr class="my-4" />

          <h3>Task 1: One Question</h3>
          <ul>
            <li>Write the code below and run it.</li>
            <li>Answer the question when it appears.</li>
            <li>
              Run it a second time with a different answer, and confirm the
              output changes. That is the whole point of input.
            </li>
          </ul>

          <Code
            code={Task1}
            frame="code"
            lang="javascript"
            title="Console Input"
          />

          <hr class="my-4" />

          <h3>Task 2: A Registration Form</h3>
          <ul>
            <li>Add two more questions, each with its own variable.</li>
            <li>
              Ask all three questions first, then print the summary. Don't
              alternate question, answer, question, answer.
            </li>
            <li>
              <b class="text-sn-theme">Note</b>: the green lines with a + sign
              are new code. Don't type the + sign.
            </li>
          </ul>

          <Code
            code={Task2}
            frame="code"
            lang="javascript"
            title="Console Input"
            ins={{ range: "2-3, 5-9" }}
          />

          <hr class="my-4" />

          <h3>Task 3: Plan, Then Add Two More</h3>
          <ul>
            <li>
              The three comments at the bottom are a plan. Write the code for
              them.
            </li>
            <li>
              The last line should read as a sentence using all five answers, not
              as another list.
            </li>
            <li>
              Watch your spaces. Commas add one for you; <CodeSnippet
                code="+"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> does not.
            </li>
            <li>
              The two new questions have to be asked <i>before</i> the summary
              prints. Think about where they go.
            </li>
          </ul>

          <Code
            code={Task3}
            frame="code"
            lang="javascript"
            title="Console Input"
            ins={{ range: "11-13" }}
          />

          <hr class="my-4" />

          <h3>Challenge (Optional): Prove the Catch</h3>
          <ul>
            <li>
              At the bottom, ask the user for a number, then display that value{" "}
              <CodeSnippet
                code="+ 1"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              />.
            </li>
            <li>
              Then display the same value <CodeSnippet
                code="* 2"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              />.
            </li>
            <li>
              One of them behaves like arithmetic and the other does not. Write a
              comment saying which, and what you think is going on.
            </li>
            <li>
              You are not expected to know the answer yet. Guessing carefully is
              the exercise.
            </li>
          </ul>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Exam Notation -->
        <section id="exam-notation">
          <h2>Same Idea, Exam Notation</h2>

          <div class="row g-3 my-4">
            <div class="col-md-6">
              <Code
                code={NotationJs}
                frame="code"
                lang="javascript"
                title="JavaScript"
                showLineNumbers={false}
              />
            </div>
            <div class="col-md-6">
              <Code
                code={NotationPseudo}
                frame="code"
                lang="txt"
                title="Exam Notation"
                showLineNumbers={false}
              />
            </div>
          </div>

          <ul>
            <li>
              <CodeSnippet
                code="INPUT()"
                lang={"txt"}
                theme={"material-theme-ocean"}
                inline
              /> takes <b class="text-sn-theme">nothing in its parentheses</b>.
              There is no place to put the question.
            </li>
            <li>
              So the question is displayed separately, on its own line, before
              the input is collected. Two statements where JavaScript uses one.
            </li>
            <li>
              The answer still has to be stored with <CodeSnippet
                code="←"
                lang={"txt"}
                theme={"material-theme-ocean"}
                inline
              /> or it is lost, exactly as in JavaScript.
            </li>
          </ul>

          <p>
            If an exam question shows <CodeSnippet
              code="INPUT()"
              lang={"txt"}
              theme={"material-theme-ocean"}
              inline
            /> with no prompt text anywhere, nothing is missing. That is how it
            is written.
          </p>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Checkpoint -->
        <section id="checkpoint">
          <h2>Checkpoint</h2>

          <p>
            Verify your program works correctly. Your answers will differ from
            the example.
          </p>

          <Code
            code={ExampleOutput}
            frame="terminal"
            lang="txt"
            showLineNumbers={false}
            title="Example Output"
            mark={{
              label: "One sentence, all five answers",
              range: "11",
            }}
          />
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Reflection -->
        <section id="reflection">
          <h2>Reflection</h2>

          <p>Answer the following questions before submitting your work.</p>

          <ol>
            <li>
              What happens if you call <code>prompt()</code> without storing the
              result in a variable? Why is that rarely useful?
            </li>
            <li>
              A user types <code>16</code> and the program displays{" "}
              <code>161</code> instead of <code>17</code>. Explain the cause in
              your own words.
            </li>
            <li>
              In exam notation, <code>INPUT()</code> has no place for a question.
              What does a program have to do instead, and why does that mean two
              statements rather than one?
            </li>
          </ol>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Submit -->
        <section id="submit">
          <h2>Submit</h2>

          <p>Submit the required files to the appropriate dropbox.</p>

          <h1
            class="text-center mt-5 text-sn-theme border border-primary slow-flash"
          >
            Activity Complete
          </h1>
        </section>
      </div>
    </div>
  </div>
</Layout>

---
import Presentation from "../../../../components/Presentation.astro";
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";
import { Code as CodeSnippet } from "astro:components";

//#region CodeSnippets
const Figure1 = `if (crewSize >= 2 && cargoMass < 500)
{
  console.log("LAUNCH APPROVED");
}
else
{
  console.log("LAUNCH DENIED");
}`;
const Figure2 = `if (crewSize >= 2 && cargoMass < 500)
{
  console.log("LAUNCH APPROVED");
}
else
{
  if (crewSize < 2)
  {
    console.log("DENIED: crew too small");
  }
  else
  {
    console.log("DENIED: cargo too heavy");
  }
}`;
const Figure3 = `console.log(Math.random());
console.log(Math.random());`;
const Figure4 = `0.8367284419102708
0.14092376601478842`;
const Figure5 = `let roll = Math.floor(Math.random() * 6) + 1;
console.log("You rolled:", roll);`;
const Figure6 = `You rolled: 4`;
const Task1 = `let crewSize = 1;
let cargoMass = 300;

if (crewSize >= 2 && cargoMass < 500)
{
  console.log("LAUNCH APPROVED");
}
else
{
  if (crewSize < 2)
  {
    console.log("DENIED: crew too small");
  }
  else
  {
    console.log("DENIED: cargo too heavy");
  }
}
`;
const Task2 = `let crewSize = 1;
let cargoMass = 300;

if (crewSize >= 2 && cargoMass < 500)
{
  console.log("LAUNCH APPROVED");
}
else
{
  if (crewSize < 2)
  {
    console.log("DENIED: crew too small");
  }
  else
  {
    console.log("DENIED: cargo too heavy");
  }
}

console.log("");

let roll = Math.floor(Math.random() * 6) + 1;
console.log("Solar flare check, rolled:", roll);

if (roll >= 5)
{
  console.log("Flare detected.");
}
else
{
  console.log("Skies clear.");
}
`;
const Task3 = `let crewSize = 1;
let cargoMass = 300;

if (crewSize >= 2 && cargoMass < 500)
{
  console.log("LAUNCH APPROVED");
}
else
{
  if (crewSize < 2)
  {
    console.log("DENIED: crew too small");
  }
  else
  {
    console.log("DENIED: cargo too heavy");
  }
}

console.log("");

let roll = Math.floor(Math.random() * 6) + 1;
console.log("Solar flare check, rolled:", roll);

if (roll >= 5)
{
  console.log("Flare detected.");
}
else
{
  console.log("Skies clear.");
}

console.log("");

// Roll a second die, 1 to 6, into its own variable
// If both dice match, it is a critical event
//   inside that, if the matched value is 6, say "CRITICAL: total systems failure"
//   otherwise say "CRITICAL: minor fault" and show the value
// If they do not match, say "No event."
`;
const ExampleOutput = `DENIED: crew too small

Solar flare check, rolled: 5
Flare detected.

Second die: 5
CRITICAL: minor fault, value 5
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Activity 1.16: Nested Conditions and Randomness</h1>
        <Divider variant="8" classes="mb-5" />

        <!-- Launch / Concept -->
        <section id="launch">
          <Presentation>
            <section>
              <h2>Activity 1.16</h2>
              <h3 class="text-sn-theme">Nested Conditions and Randomness</h3>
            </section>

            <section>
              <h2>Key Concepts</h2>
              <p>A Decision Inside a Decision</p>
              <p>Nesting vs. AND</p>
              <p>Random Numbers</p>
            </section>

            <section data-auto-animate>
              <h2>Unfinished Business, Again</h2>
              <Code
                code={Figure1}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
              />
              <p class="fragment">
                This works, but "DENIED" does not tell the crew what to fix.
              </p>
            </section>

            <section data-auto-animate>
              <h2>A Decision Inside a Decision</h2>
              <Code
                code={Figure2}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
              />
              <p class="fragment">
                The inner <CodeSnippet code="if" lang={"javascript"} theme={"material-theme-ocean"} inline /> only runs when the outer one already
                failed. By then you know something is wrong &mdash; the inner
                question is just <i>which thing</i>.
              </p>
            </section>

            <section>
              <h2>Reading a Nest</h2>
              <div class="text-start">
                <ul>
                  <li class="fragment">Indentation shows the depth</li>
                  <li class="fragment">
                    An inner condition is only ever asked if the outer one led
                    there
                  </li>
                  <li class="fragment">
                    Every <CodeSnippet code="{" lang={"javascript"} theme={"material-theme-ocean"} inline /> needs its partner, and they stack up
                    at the bottom
                  </li>
                </ul>
              </div>
              <p class="fragment">
                If your braces stop matching, your indentation was probably
                lying to you before the computer noticed.
              </p>
            </section>

            <section>
              <h2>Nest, or Use AND?</h2>
              <div class="text-start">
                <ul>
                  <li class="fragment">
                    <b>AND</b> when you only care whether everything passed
                  </li>
                  <li class="fragment">
                    <b>Nesting</b> when you need to respond differently to each
                    reason it failed
                  </li>
                </ul>
              </div>
              <p class="fragment">
                Both are correct code. They answer different questions, and the
                one you want depends on what the program has to say next.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Random Numbers</h2>
              <Code
                code={Figure3}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure4}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
              <p class="fragment">
                Long decimals, always <b>0 or more and less than 1</b>. Never 1
                itself.
              </p>
            </section>

            <section data-auto-animate>
              <h2>Turning That Into a Die</h2>
              <Code
                code={Figure5}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure6}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
            </section>

            <section>
              <h2>Reading That Line, Inside Out</h2>
              <div class="text-start">
                <ol>
                  <li class="fragment">
                    <CodeSnippet code="Math.random()" lang={"javascript"} theme={"material-theme-ocean"} inline /> gives something like 0.61
                  </li>
                  <li class="fragment">
                    <CodeSnippet code="* 6" lang={"javascript"} theme={"material-theme-ocean"} inline /> stretches it to 0 up to just under 6
                  </li>
                  <li class="fragment">
                    <CodeSnippet code="Math.floor()" lang={"javascript"} theme={"material-theme-ocean"} inline /> chops the decimal off, giving 0 to 5
                  </li>
                  <li class="fragment">
                    <CodeSnippet code="+ 1" lang={"javascript"} theme={"material-theme-ocean"} inline /> shifts it to 1 to 6
                  </li>
                </ol>
              </div>
            </section>

            <section>
              <h2>The General Recipe</h2>
              <p>
                For a whole number from <b>min</b> to <b>max</b>, both included:
              </p>
              <p class="fragment">
                <CodeSnippet
                  code="Math.floor(Math.random() * (max - min + 1)) + min"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                />
              </p>
              <p class="fragment">
                Worth remembering: the exam reference sheet does this with{" "}
                <CodeSnippet code="RANDOM(1, 6)" lang={"txt"} theme={"material-theme-ocean"} inline />, which you met back in Activity 1.6.
                One call, no arithmetic. JavaScript makes you do it by hand.
              </p>
            </section>

            <section>
              <h2>Today's Objectives</h2>
              <ul>
                <li>Placing a conditional inside another conditional</li>
                <li>Choosing between nesting and AND</li>
                <li>Generating a random whole number in a range</li>
                <li>Testing a program whose output changes every run</li>
              </ul>
            </section>

            <section>
              <h2>Key Terms</h2>
              <div class="text-start">
                <dl>
                  <dt>Nested conditional</dt>
                  <dd>A conditional written inside another conditional's block.</dd>
                  <dt>Nesting depth</dt>
                  <dd>How many levels deep a piece of code sits.</dd>
                  <dt>
                    <CodeSnippet code="Math.floor()" lang={"javascript"} theme={"material-theme-ocean"} inline />
                  </dt>
                  <dd>Rounds a decimal down to the whole number below it.</dd>
                </dl>
              </div>
            </section>
          </Presentation>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Build -->
        <section id="build">
          <h2>Build</h2>

          <p>
            Create a new <b>JavaScript</b> program named{" "}
            <b class="text-sn-theme">1-16-nested</b>.
          </p>

          <hr class="my-4" />

          <h3>Task 1: Say Which One Failed</h3>
          <ul>
            <li>Write the code below and run it.</li>
            <li>
              Test all four combinations by editing the two numbers. You should
              be able to produce approval, a crew failure, and a cargo failure.
            </li>
            <li>
              <b>Worth noticing:</b> with crew 1 and mass 900, both are wrong but
              only the crew is reported. Is that acceptable? Hold that thought
              for the reflection.
            </li>
          </ul>

          <Code
            code={Task1}
            frame="code"
            lang="javascript"
            title="Nested Conditions and Randomness"
          />

          <hr class="my-4" />

          <h3>Task 2: Add a Die Roll</h3>
          <ul>
            <li>Add a random roll and a decision based on it.</li>
            <li>
              <b>Run this one five or six times.</b> The output should change.
              Every program you have written until now gave the same answer every
              time.
            </li>
            <li>
              <b class="text-sn-theme">Note</b>: the green lines with a + sign
              are new code. Don't type the + sign.
            </li>
          </ul>

          <Code
            code={Task2}
            frame="code"
            lang="javascript"
            title="Nested Conditions and Randomness"
            ins={{ range: "19-32" }}
          />

          <hr class="my-4" />

          <h3>Task 3: Plan, Then Roll Two Dice</h3>
          <ul>
            <li>
              The comments describe a doubles check with a nested decision inside
              it. Write the code under them.
            </li>
            <li>
              Look at the indentation in the comments &mdash; it is telling you
              the shape. Two of those lines are indented further because they
              belong <i>inside</i> the match check.
            </li>
            <li>
              Run it until you see a match. It takes about six tries on average,
              which is itself worth noticing.
            </li>
          </ul>

          <Code
            code={Task3}
            frame="code"
            lang="javascript"
            title="Nested Conditions and Randomness"
            ins={{ range: "34-40" }}
          />

          <hr class="my-4" />

          <h3>Challenge (Optional): Test Something Random</h3>
          <ul>
            <li>
              A program that behaves differently every run is hard to test. Add a
              line near the top that lets you <i>force</i> a value:{" "}
              <CodeSnippet code="let roll = 6;" lang={"javascript"} theme={"material-theme-ocean"} inline /> instead of the random version.
            </li>
            <li>
              Use it to check that your "total systems failure" branch works,
              without waiting for double sixes.
            </li>
            <li>
              Write a comment explaining why a programmer might want to switch
              randomness off on purpose. Restore the random line before
              submitting.
            </li>
          </ul>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Checkpoint -->
        <section id="checkpoint">
          <h2>Checkpoint</h2>

          <p>
            Verify your program works. Because it uses randomness,{" "}
            <b>your output will differ every run</b> &mdash; that is correct, not
            a bug.
          </p>

          <Code
            code={ExampleOutput}
            frame="terminal"
            lang="txt"
            showLineNumbers={false}
            title="Example Output"
            mark={{
              label: "Different every run",
              range: "3-4, 6-7",
            }}
          />

          <p class="mt-3">
            Run it enough times to have seen all three outcomes at least once: no
            event, a minor fault, and total systems failure.
          </p>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Reflection -->
        <section id="reflection">
          <h2>Reflection</h2>

          <p>Answer the following questions before submitting your work.</p>

          <ol>
            <li>
              In Task 1, when both requirements fail, only one is reported.
              Explain why, and decide whether you think that is a bug.
            </li>
            <li>
              When would you use <code>&amp;&amp;</code> instead of nesting, and
              when is nesting the better choice?
            </li>
            <li>
              Randomness makes a program harder to test. Describe how you checked
              that a rare branch actually works.
            </li>
          </ol>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Submit -->
        <section id="submit">
          <h2>Submit</h2>

          <p>Submit the required files to the appropriate dropbox.</p>

          <h1
            class="text-center mt-5 text-sn-theme border border-primary slow-flash"
          >
            Activity Complete
          </h1>
        </section>
      </div>
    </div>
  </div>
</Layout>

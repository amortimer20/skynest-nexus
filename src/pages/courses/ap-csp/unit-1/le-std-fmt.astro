---
import Presentation from "../../../../components/Presentation.astro";
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";
import { Code as CodeSnippet } from "astro:components";

//#region CodeSnippets
const Figure1 = `SYSTEM CHECK
Oxygen: ok
Coolant: LOW
Power: ok
Hull: BREACH
Comms: ok`;
const Figure2 = `import { green, red } from "@std/fmt/colors";

console.log(green("Oxygen: ok"));
console.log(red("Hull: BREACH"));`;
const Figure3 = `import { bold, yellow, bgRed, white } from "@std/fmt/colors";

console.log(bold("This is bold."));
console.log(yellow("This is yellow."));
console.log(bold(yellow("This is both.")));
console.log(bgRed(white("White on red.")));`;
const Figure4 = `import { red, dim } from "@std/fmt/colors";

let fuel = 12;
console.log("Fuel:", red(String(fuel)));
console.log(dim("(reading taken at 04:12)"));`;
const Task1 = `import { bold, green } from "@std/fmt/colors";

console.log(bold("=== SYSTEM CHECK ==="));
console.log(green("Oxygen: ok"));
console.log(green("Power: ok"));
`;
const Task2 = `import { bold, green, yellow, red, dim } from "@std/fmt/colors";

console.log(bold("=== SYSTEM CHECK ==="));
console.log(green("Oxygen: ok"));
console.log(green("Power: ok"));
console.log(yellow("Coolant: LOW"));
console.log(bold(red("Hull: BREACH")));
console.log(dim("Comms: idle"));
`;
const Task3 = `import { bold, green, yellow, red, dim } from "@std/fmt/colors";

let shipName = "Vega";
let crewCount = 7;
let fuelPercent = 12;

console.log(bold("=== SYSTEM CHECK ==="));
console.log(green("Oxygen: ok"));
console.log(green("Power: ok"));
console.log(yellow("Coolant: LOW"));
console.log(bold(red("Hull: BREACH")));
console.log(dim("Comms: idle"));
console.log("");

// Print the ship name in bold
// Print the crew count in plain text
// Print the fuel percent in red, because it is low
`;
const ExampleOutput = `=== SYSTEM CHECK ===
Oxygen: ok
Power: ok
Coolant: LOW
Hull: BREACH
Comms: idle

Ship: Vega
Crew: 7
Fuel: 12
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Library Exploration: @std/fmt/colors</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <!-- Launch / Concept -->
        <section id="launch">
          <Presentation>
            <section>
              <h2>Library Exploration</h2>
              <h3 class="text-sn-theme">@std/fmt/colors</h3>
            </section>

            <section>
              <h2>Key Concepts</h2>
              <p>Using Someone Else's Code</p>
              <p>Color and Emphasis</p>
              <p>Styling a Value</p>
            </section>

            <section data-auto-animate>
              <h2>Plain Text Has a Problem</h2>
              <Code
                code={Figure1}
                frame="terminal"
                title="Demo"
                lang="txt"
                showLineNumbers={false}
              />
            </section>

            <section data-auto-animate>
              <h2>Plain Text Has a Problem</h2>
              <p>
                Two of those six lines are emergencies. Nothing about the output
                says so.
              </p>
              <p class="fragment">
                Output is read by people. Making the important part <i>look</i>{" "}
                important is part of the job.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Using Someone Else's Code</h2>
              <p>
                <b class="text-sn-theme">@std/fmt/colors</b> is a library &mdash;
                code somebody else wrote and shared, that you can use in your own
                program.
              </p>
            </section>

            <section data-auto-animate>
              <h2>Using Someone Else's Code</h2>
              <Code
                code={Figure2}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
              />
              <p class="fragment">
                The <CodeSnippet
                  code="import"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> line goes at the very top, once. It is already available here
                &mdash; you do not have to fetch or install anything.
              </p>
              <p class="fragment">
                Notice the names in the curly braces. You borrow exactly the ones
                you list, and <b class="text-sn-theme">a style you did not list
                does not exist</b> in your program.
              </p>
            </section>

            <section>
              <h2>This Is Abstraction</h2>
              <p>
                You are about to make text red without knowing how a terminal
                renders color.
              </p>
              <p class="fragment">
                Someone solved that once, packaged it, and now you get to skip
                it. That idea has a name in this course &mdash;{" "}
                <b class="text-sn-theme">abstraction</b> &mdash; and it is one of
                the Big Ideas the exam tests.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Colors and Styles</h2>
              <Code
                code={Figure3}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
              />
            </section>

            <section data-auto-animate>
              <h2>Colors and Styles</h2>
              <div class="text-start">
                <ul>
                  <li class="fragment">
                    Colors: <CodeSnippet
                      code="red green yellow blue cyan magenta white gray"
                      lang={"txt"}
                      theme={"material-theme-ocean"}
                      inline
                    />
                  </li>
                  <li class="fragment">
                    Styles: <CodeSnippet
                      code="bold dim italic underline"
                      lang={"txt"}
                      theme={"material-theme-ocean"}
                      inline
                    />
                  </li>
                  <li class="fragment">
                    Backgrounds: <CodeSnippet
                      code="bgRed bgGreen bgYellow"
                      lang={"txt"}
                      theme={"material-theme-ocean"}
                      inline
                    />
                  </li>
                </ul>
              </div>
              <p class="fragment">
                Wrap one inside another to combine them.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Styling a Variable</h2>
              <Code
                code={Figure4}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
              />
              <p class="fragment">
                A variable goes inside the parentheses just like text does. No
                quotes around it.
              </p>
              <p class="fragment">
                <b class="text-sn-theme">Styles work on text only.</b> A number
                has to be turned into text first, with{" "}
                <CodeSnippet
                  code="String()"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> &mdash; the mirror of the <CodeSnippet
                  code="Number()"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> you met in Activity 1.9. Hand a style a bare number and the
                program stops.
              </p>
            </section>

            <section>
              <h2>A Word of Restraint</h2>
              <p>
                If everything is colored, nothing stands out. Color should mean
                something: red for a problem, yellow for a warning, dim for
                detail nobody needs to read.
              </p>
            </section>

            <section>
              <h2>Today's Objectives</h2>
              <ul>
                <li>Importing and using a library</li>
                <li>Applying color and emphasis to output</li>
                <li>Combining styles</li>
                <li>Styling the value in a variable</li>
              </ul>
            </section>

            <section>
              <h2>Key Terms</h2>
              <div class="text-start">
                <dl>
                  <dt>Library</dt>
                  <dd>
                    Code written by someone else that you can use in your own
                    program.
                  </dd>
                  <dt>Import</dt>
                  <dd>A statement that makes a library available to your code.</dd>
                  <dt>Abstraction</dt>
                  <dd>
                    Hiding complicated detail behind something simpler to use.
                  </dd>
                </dl>
              </div>
            </section>
          </Presentation>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Build -->
        <section id="build">
          <h2>Build</h2>

          <p>
            <b class="text-sn-theme">This one is optional and worth extra credit.</b>{" "}
            Nothing later in the course depends on it &mdash; it is here because styled
            output makes your own programs nicer to use, and because using someone else's
            code is worth doing once before it matters.
          </p>

          <p>
            Create a new <b>JavaScript</b> program named{" "}
            <b class="text-sn-theme">le-std-fmt</b>.
          </p>

          <hr class="my-4" />

          <h3>Task 1: Import and Color</h3>
          <ul>
            <li>Write the code below and run it.</li>
            <li>
              The <CodeSnippet
                code="import"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> line must be the first line of the program, and you only write
              it once no matter how many times you use these styles.
            </li>
            <li>
              If the colors do not appear, tell me. That is a setup problem, not
              a mistake you made.
            </li>
          </ul>

          <Code
            code={Task1}
            frame="code"
            lang="javascript"
            title="Library Exploration: @std/fmt/colors"
          />

          <hr class="my-4" />

          <h3>Task 2: Say What Matters</h3>
          <ul>
            <li>Add three more status lines, styled to match their severity.</li>
            <li>
              Note that <CodeSnippet
                code="bold(red())"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> combines two styles by wrapping one inside the other.
            </li>
            <li>
              Two new style names appear, so <b class="text-sn-theme">the import
              line changes too</b>. Use a style you did not import and the
              program stops with{" "}
              <CodeSnippet
                code="ReferenceError"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              />.
            </li>
            <li>
              <b class="text-sn-theme">Note</b>: the green lines with a + sign
              are new code. Don't type the + sign.
            </li>
          </ul>

          <Code
            code={Task2}
            frame="code"
            lang="javascript"
            title="Library Exploration: @std/fmt/colors"
            ins={{ range: "1, 6-8" }}
          />

          <hr class="my-4" />

          <h3>Task 3: Plan, Then Style Some Variables</h3>
          <ul>
            <li>
              Three variables are declared at the top and three comments at the
              bottom describe what to display. Write the code under them.
            </li>
            <li>
              Style the <i>value</i>, not the label. Look at the demo slide again
              if you are unsure what that means.
            </li>
            <li>
              The fuel percent is a number. <b class="text-sn-theme">A style only
              takes text</b>, so wrap it in{" "}
              <CodeSnippet
                code="String()"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> before styling it &mdash; and read the error if you forget, because
              it tells you exactly this.
            </li>
            <li>Run after each line.</li>
          </ul>

          <Code
            code={Task3}
            frame="code"
            lang="javascript"
            title="Library Exploration: @std/fmt/colors"
            ins={{ range: "3-5, 13-17" }}
          />

          <hr class="my-4" />

          <h3>Challenge (Optional): Too Much of a Good Thing</h3>
          <ul>
            <li>
              Copy your system check to the bottom and give every single line a
              different bright color and a background.
            </li>
            <li>
              Look at both versions side by side and decide which one you could
              read faster.
            </li>
            <li>Delete the copy before submitting.</li>
          </ul>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Checkpoint -->
        <section id="checkpoint">
          <h2>Checkpoint</h2>

          <p>
            Verify your program works correctly. Colors do not show in the
            example below, so check these by eye:
          </p>

          <ul>
            <li>The heading is bold.</li>
            <li>Both <i>ok</i> lines are green.</li>
            <li>The coolant line is yellow, and the hull line is bold red.</li>
            <li>The comms line is dim.</li>
            <li>
              In the second block, the ship name is bold and the fuel number is
              red &mdash; but the labels in front of them are not.
            </li>
          </ul>

          <Code
            code={ExampleOutput}
            frame="terminal"
            lang="txt"
            showLineNumbers={false}
            title="Example Output"
            mark={{
              label: "Values styled, labels plain",
              range: "8-10",
            }}
          />
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Reflection -->
        <section id="reflection">
          <h2>Reflection</h2>

          <p>Answer the following questions before submitting your work.</p>

          <ol>
            <li>
              You made text red without knowing how a terminal produces color.
              Explain what abstraction means, using this as your example.
            </li>
            <li>
              Task 3 asked you to style the value but not the label. Why might
              that be easier to read than coloring the whole line?
            </li>
            <li>
              Libraries let you use code you did not write. Name one risk that
              comes with depending on somebody else's code.
            </li>
          </ol>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Submit -->
        <section id="submit">
          <h2>Submit</h2>

          <p>Submit the required files to the appropriate dropbox.</p>

          <h1
            class="text-center mt-5 text-sn-theme border border-primary slow-flash"
          >
            Exploration Complete
          </h1>
        </section>
      </div>
    </div>
  </div>
</Layout>

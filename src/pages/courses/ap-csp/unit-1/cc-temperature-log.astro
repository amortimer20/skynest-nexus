---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `A week of readings from the greenhouse sensor. Give me the
lowest, the highest, and the average, and tell me which days
went above the safe line so I know when to check the vents.`;

const SampleOutput = `Readings: 18, 22, 27, 31, 24, 19, 29

Low:  18
High: 31
Average: 24.3

Above 25 on days: 3 4 7`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-1/cc-set-4" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 4
        </a>

        <h1>Code Challenge: Temperature Log</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code
            code={Brief}
            frame="code"
            lang="txt"
            title="What they asked for"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-1/cc-set-4">Set 4</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li>Start with the readings in an array.</li>
            <li>The lowest and the highest are two running comparisons. Set both starting values from the first reading rather than from zero, or a week of warm days gives you a minimum of 0.</li>
            <li>That last note is the trap in this one.</li>
            <li>Report the day numbers that went over, not just how many.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />

          <p class="mt-3">If your low comes out as 0, you started the comparison from zero instead of from the first reading.</p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-temperature-log</b>.
          </p>
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

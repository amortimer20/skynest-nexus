---
import Presentation from "../../../../components/Presentation.astro";
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";
import { Code as CodeSnippet } from "astro:components";

//#region CodeSnippets
const Figure1 = `let playerName = "Ada";
console.log(playerName);`;
const Figure2 = `Ada`;
const Figure3 = `let score = 0;
console.log("Score:", score);

score = 250;
console.log("Score:", score);`;
const Figure4 = `Score: 0
Score: 250`;
const Figure5 = `let title = "Commander";   // string
let level = 7;             // number
let isOnDuty = true;       // boolean`;
const Figure6 = `let crewCount = 12;    // good
let crew_count = 12;   // works, but not the JavaScript style
let c = 12;            // works, but what is c?`;
const NotationJs = `let score = 0;
score = 250;
console.log("Score:", score);`;
const NotationPseudo = `score ← 0
score ← 250
DISPLAY("Score:")
DISPLAY(score)`;
const Task1 = `let callSign = "Vega";
let crewCount = 7;

console.log("Call sign:", callSign);
console.log("Crew:", crewCount);
`;
const Task2 = `let callSign = "Vega";
let crewCount = 7;
let fuelPercent = 84.5;
let isDocked = true;

console.log("Call sign:", callSign);
console.log("Crew:", crewCount);
console.log("Fuel:", fuelPercent);
console.log("Docked:", isDocked);
`;
const Task3 = `let callSign = "Vega";
let crewCount = 7;
let fuelPercent = 84.5;
let isDocked = true;

console.log("=== BEFORE LAUNCH ===");
console.log("Call sign:", callSign);
console.log("Crew:", crewCount);
console.log("Fuel:", fuelPercent);
console.log("Docked:", isDocked);

// Two crew members board and the ship undocks
crewCount = 9;
isDocked = false;

console.log("");
console.log("=== AFTER LAUNCH ===");
console.log("Crew:", crewCount);
console.log("Docked:", isDocked);
`;
const ExampleOutput = `=== BEFORE LAUNCH ===
Call sign: Vega
Crew: 7
Fuel: 84.5
Docked: true

=== AFTER LAUNCH ===
Crew: 9
Docked: false
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Activity 1.5: Variables and Data Types</h1>
        <Divider variant="8" classes="mb-5" />

        <!-- Launch / Concept -->
        <section id="launch">
          <Presentation>
            <section>
              <h2>Activity 1.5</h2>
              <h3 class="text-sn-theme">Variables and Data Types</h3>
            </section>

            <section>
              <h2>Key Concepts</h2>
              <p>Storing a Value</p>
              <p>Changing a Value</p>
              <p>Three Data Types</p>
            </section>

            <section data-auto-animate>
              <h2>A Variable Is a Named Box</h2>
              <p>
                You put a value in it, give it a name, and use the name from
                then on.
              </p>
            </section>

            <section data-auto-animate>
              <h2>A Variable Is a Named Box</h2>
              <Code
                code={Figure1}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure2}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
              <p class="fragment">
                No quotes around <CodeSnippet
                  code="playerName"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> &mdash; quotes would print the word itself.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>The Value Can Change</h2>
              <p>
                That is what makes it a <i>variable</i>.
              </p>
            </section>

            <section data-auto-animate>
              <h2>The Value Can Change</h2>
              <Code
                code={Figure3}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
                class="mb-3"
              />
              <Code
                code={Figure4}
                frame="terminal"
                lang="txt"
                title="Demo"
                showLineNumbers={false}
                class="fragment"
              />
              <p class="fragment">
                You write <CodeSnippet
                  code="let"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> once, when the variable is created. Never again.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Three Kinds of Value</h2>
              <Code
                code={Figure5}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
              />
            </section>

            <section data-auto-animate>
              <h2>Three Kinds of Value</h2>
              <div class="text-start">
                <ul>
                  <li class="fragment">
                    <b>String</b> &mdash; text, always in quotes
                  </li>
                  <li class="fragment">
                    <b>Number</b> &mdash; whole or decimal, never in quotes
                  </li>
                  <li class="fragment">
                    <b>Boolean</b> &mdash; only <CodeSnippet
                      code="true"
                      lang={"javascript"}
                      theme={"material-theme-ocean"}
                      inline
                    /> or <CodeSnippet
                      code="false"
                      lang={"javascript"}
                      theme={"material-theme-ocean"}
                      inline
                    />
                  </li>
                </ul>
              </div>
              <p class="fragment">
                <CodeSnippet
                  code='"7"'
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> and <CodeSnippet
                  code="7"
                  lang={"javascript"}
                  theme={"material-theme-ocean"}
                  inline
                /> are not the same thing. That will matter a lot in Activity 1.9.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Naming Variables</h2>
              <Code
                code={Figure6}
                frame="code"
                title="Demo"
                lang="javascript"
                showLineNumbers={false}
              />
            </section>

            <section data-auto-animate>
              <h2>Naming Variables</h2>
              <p>
                JavaScript uses <b class="text-sn-theme">camelCase</b>: first
                word lowercase, every word after that capitalized, no spaces.
              </p>
              <p class="fragment">
                Names should say what the value <i>is</i>. You will read your own
                code weeks later and be grateful.
              </p>
            </section>

            <section>
              <h2>Today's Objectives</h2>
              <ul>
                <li>Creating variables and displaying their values</li>
                <li>Changing a variable's value after creating it</li>
                <li>Telling strings, numbers, and booleans apart</li>
                <li>Naming variables in camelCase</li>
              </ul>
            </section>

            <section>
              <h2>Key Terms</h2>
              <div class="text-start">
                <dl>
                  <dt>Variable</dt>
                  <dd>A named place to store a value.</dd>
                  <dt>Assignment</dt>
                  <dd>Putting a value into a variable.</dd>
                  <dt>String</dt>
                  <dd>A piece of text, written inside quotes.</dd>
                  <dt>Number</dt>
                  <dd>A numeric value, whole or decimal, with no quotes.</dd>
                  <dt>Boolean</dt>
                  <dd>
                    A value that is either <CodeSnippet
                      code="true"
                      lang={"javascript"}
                      theme={"material-theme-ocean"}
                      inline
                    /> or <CodeSnippet
                      code="false"
                      lang={"javascript"}
                      theme={"material-theme-ocean"}
                      inline
                    />.
                  </dd>
                  <dt>camelCase</dt>
                  <dd>
                    A naming style where the first word is lowercase and later
                    words are capitalized.
                  </dd>
                </dl>
              </div>
            </section>
          </Presentation>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Build -->
        <section id="build">
          <h2>Build</h2>

          <p>
            Create a new <b>JavaScript</b> program named{" "}
            <b class="text-sn-theme">1-5-variables</b>.
          </p>

          <hr class="my-4" />

          <h3>Task 1: Two Variables</h3>
          <ul>
            <li>Create the two variables below and display them.</li>
            <li>
              Run it, then try removing the quotes around{" "}
              <CodeSnippet
                code="callSign"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> in the last two lines to see what changes. Put them back.
            </li>
          </ul>

          <Code
            code={Task1}
            frame="code"
            lang="javascript"
            title="Variables and Data Types"
          />

          <hr class="my-4" />

          <h3>Task 2: One of Each Type</h3>
          <ul>
            <li>
              Add a decimal number and a boolean, so you have all three types.
            </li>
            <li>Display them too.</li>
            <li>
              <b class="text-sn-theme">Note</b>: the green lines with a + sign
              are new code. Don't type the + sign.
            </li>
          </ul>

          <Code
            code={Task2}
            frame="code"
            lang="javascript"
            title="Variables and Data Types"
            ins={{ range: "3-4, 8-9" }}
          />

          <hr class="my-4" />

          <h3>Task 3: Change the Values</h3>
          <ul>
            <li>
              Add a second report that shows the values <i>after</i> two crew
              members board and the ship undocks.
            </li>
            <li>
              Change <CodeSnippet
                code="crewCount"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> and <CodeSnippet
                code="isDocked"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> without writing <CodeSnippet
                code="let"
                lang={"javascript"}
                theme={"material-theme-ocean"}
                inline
              /> again.
            </li>
            <li>
              The first report must still show the old values. If it doesn't,
              your changes are in the wrong place.
            </li>
          </ul>

          <Code
            code={Task3}
            frame="code"
            lang="javascript"
            title="Variables and Data Types"
            ins={{ range: "6, 11-19" }}
          />

          <hr class="my-4" />

          <h3>Challenge (Optional): Name Things Badly, Then Well</h3>
          <ul>
            <li>
              Copy your program to the bottom of the file and rename every
              variable to a single letter.
            </li>
            <li>
              Read it back. Ask a classmate to tell you what it does without
              running it.
            </li>
            <li>Delete the copy before submitting.</li>
          </ul>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Exam Notation -->
        <section id="exam-notation">
          <h2>Same Idea, Exam Notation</h2>

          <p>
            The AP exam does not show code in JavaScript. It uses its own
            notation, and you will be handed a reference sheet for it on exam
            day. You will see a short panel like this one whenever we learn
            something that appears on that sheet.
          </p>

          <div class="row g-3 my-4">
            <div class="col-md-6">
              <Code
                code={NotationJs}
                frame="code"
                lang="javascript"
                title="JavaScript"
                showLineNumbers={false}
              />
            </div>
            <div class="col-md-6">
              <Code
                code={NotationPseudo}
                frame="code"
                lang="txt"
                title="Exam Notation"
                showLineNumbers={false}
              />
            </div>
          </div>

          <p>Two things to notice:</p>
          <ul>
            <li>
              Assignment is an arrow, <CodeSnippet
                code="←"
                lang={"txt"}
                theme={"material-theme-ocean"}
                inline
              />, not an equals sign. It points at the variable receiving the
              value.
            </li>
            <li>
              <CodeSnippet
                code="DISPLAY()"
                lang={"txt"}
                theme={"material-theme-ocean"}
                inline
              /> takes one value at a time, so two displays are needed where
              JavaScript used one comma.
            </li>
          </ul>

          <p>
            You will never write exam notation in this class's programs. You only
            need to <i>read</i> it, which is what the multiple-choice section
            asks you to do.
          </p>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Checkpoint -->
        <section id="checkpoint">
          <h2>Checkpoint</h2>

          <p>Verify your program works correctly.</p>

          <Code
            code={ExampleOutput}
            frame="terminal"
            lang="txt"
            showLineNumbers={false}
            title="Example Output"
            mark={{
              label: "Old values, still correct",
              range: "2-5",
            }}
          />
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Reflection -->
        <section id="reflection">
          <h2>Reflection</h2>

          <p>Answer the following questions before submitting your work.</p>

          <ol>
            <li>
              Why do you only write <code>let</code> once per variable, even
              though the value changes several times?
            </li>
            <li>
              Explain the difference between <code>"7"</code> and <code>7</code>.
              Give a situation where treating one as the other would cause a
              problem.
            </li>
            <li>
              In exam notation, assignment is written <code>score ← 250</code>.
              Why might an arrow be a clearer symbol for this than an equals
              sign?
            </li>
          </ol>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Submit -->
        <section id="submit">
          <h2>Submit</h2>

          <p>Submit the required files to the appropriate dropbox.</p>

          <h1
            class="text-center mt-5 text-sn-theme border border-primary slow-flash"
          >
            Activity Complete
          </h1>
        </section>
      </div>
    </div>
  </div>
</Layout>

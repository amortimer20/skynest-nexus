---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `Three procedures, one receipt. One works out the subtotal
from a price and quantity, one adds tax, one formats a
line for printing. I want them to hand values to each
other rather than each printing their own bit.`;

const SampleOutput = `Widget       x3   @ 4.50   =  13.50
Tax (8%)                       1.08
TOTAL                         14.58`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-2/cc-set-5" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 5
        </a>

        <h1>Code Challenge: Receipt Total</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code code={Brief} frame="code" lang="txt" title="What they asked for" showLineNumbers={false} class="mt-3" />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-2/cc-set-5">Set 5</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li>This is a composition exercise. Two of the three procedures must return values, not print.</li>
            <li>Only one procedure should contain a <code>console.log</code>. Decide which and say why.</li>
            <li>Call them nested &mdash; one procedure's return value as another's argument &mdash; at least once.</li>
            <li>Money formatting is a display concern. Keep it in the procedure that displays.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code code={SampleOutput} frame="terminal" title="Sample Output" lang="txt" showLineNumbers={false} class="mt-3" />

          <p class="mt-3">3 x 4.50 is 13.50, and 8% of that is 1.08. Check both by hand.</p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-receipt-total</b>.
          </p>
        </section>

        <h1 class="text-center mt-5 text-sn-theme border border-primary slow-flash">
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

---
import Presentation from "../../../../components/Presentation.astro";
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Figure1 = `function largestA(list) {
  let best = list[0];

  for (let i = 1; i < list.length; i++) {
    if (list[i] > best) {
      best = list[i];
    }
  }

  return best;
}`;

const Figure2 = `function largestB(list) {
  for (let i = 0; i < list.length; i++) {
    let beatsEveryone = true;

    for (let j = 0; j < list.length; j++) {
      if (list[j] > list[i]) {
        beatsEveryone = false;
      }
    }

    if (beatsEveryone) {
      return list[i];
    }
  }
}`;

const Figure3 = `for (let i = 0; i < list.length; i++) {
  if (list[i] === target) {
    return i;
  }
}

return -1;`;

const Task1 = `let crew = ["Vega", "Orion", "Lyra", "Draco", "Cygnus"];

function findCrew(name) {
  let checks = 0;

  for (let i = 0; i < crew.length; i++) {
    checks = checks + 1;

    if (crew[i] === name) {
      console.log(name + " found at index " + i + " after " + checks + " checks");
      return i;
    }
  }

  console.log(name + " not found after " + checks + " checks");
  return -1;
}

findCrew("Vega");
`;

const Task2 = `let crew = ["Vega", "Orion", "Lyra", "Draco", "Cygnus"];

function findCrew(name) {
  let checks = 0;

  for (let i = 0; i < crew.length; i++) {
    checks = checks + 1;

    if (crew[i] === name) {
      console.log(name + " found at index " + i + " after " + checks + " checks");
      return i;
    }
  }

  console.log(name + " not found after " + checks + " checks");
  return -1;
}

findCrew("Vega");
findCrew("Cygnus");
findCrew("Rigel");
`;

const Task3 = `let readings = [12, 40, 7, 63, 22, 91];

// Write findFirstOver(list, threshold).
//   It returns the index of the first value greater than threshold.
//   If nothing is over it, return -1.
//   Count the checks the same way findCrew does, and print the count.
//
// Then call it three times:
//   once where the answer is early in the list
//   once where the answer is late in the list
//   once where there is no answer at all
`;

const ExampleOutput = `Vega found at index 0 after 1 checks
Cygnus found at index 4 after 5 checks
Rigel not found after 5 checks`;

const NotationJs = `function findIndex(list, target) {
  for (let i = 0; i < list.length; i++) {
    if (list[i] === target) {
      return i;
    }
  }
  return -1;
}`;

const NotationPseudo = `PROCEDURE findIndex(aList, target)
{
  i ← 1
  REPEAT UNTIL(i > LENGTH(aList))
  {
    IF(aList[i] = target)
    {
      RETURN(i)
    }
    i ← i + 1
  }
  RETURN(-1)
}`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Activity 2.9: Algorithms and Linear Search</h1>
        <Divider variant="8" classes="mb-5" />

        <!-- Launch / Concept -->
        <section id="launch">
          <Presentation>
            <section>
              <h2>Activity 2.9</h2>
              <h3 class="text-sn-theme">Algorithms and Linear Search</h3>
            </section>

            <section>
              <h2>Key Concepts</h2>
              <p>What an Algorithm Is</p>
              <p>Many Algorithms, One Problem</p>
              <p>Linear Search</p>
            </section>

            <section>
              <h2>You Have Been Writing These All Year</h2>
              <p>An <b>algorithm</b> is a finite set of instructions that accomplishes a task.</p>
              <p class="fragment">Finite: it ends.</p>
              <p class="fragment">Every loop you have written was one.</p>
            </section>

            <section>
              <h2>Same Problem, Two Algorithms</h2>
              <p>Find the largest number in a list.</p>
              <Code code={Figure1} frame="code" lang="javascript" title="Algorithm A" showLineNumbers={false} />
              <p class="fragment">Remember the best so far. Look at each one once.</p>
            </section>

            <section>
              <h2>Same Answer, Different Work</h2>
              <Code code={Figure2} frame="code" lang="javascript" title="Algorithm B" showLineNumbers={false} />
              <p class="fragment">Check whether each number beats everyone else.</p>
              <p class="fragment">Also correct. On five numbers: <b>4 comparisons versus 15</b>.</p>
            </section>

            <section>
              <h2>That Gap Is the Whole Unit</h2>
              <p>Both algorithms are right.</p>
              <p class="fragment">Correctness is not the only thing worth measuring.</p>
              <p class="fragment">We come back to this at 2.13 with real numbers.</p>
            </section>

            <section>
              <h2>Linear Search</h2>
              <p>Start at the beginning. Check each one. Stop when you find it.</p>
              <Code code={Figure3} frame="code" lang="javascript" title="The Shape" showLineNumbers={false} />
              <p class="fragment">The <code>return</code> inside the loop is doing real work &mdash; it stops early.</p>
            </section>

            <section>
              <h2>Why -1</h2>
              <p>Every index is 0 or bigger.</p>
              <p class="fragment">So <code>-1</code> can only mean <i>not here</i>.</p>
              <p class="fragment">A value chosen because it cannot be mistaken for a real answer.</p>
            </section>

            <section>
              <h2>Three Cases, Not One</h2>
              <p><b>Best case:</b> it is first. One check.</p>
              <p class="fragment"><b>Worst case:</b> it is last, or missing. Every check.</p>
              <p class="fragment">You measure an algorithm by its worst case, because that is the one that hurts.</p>
            </section>

            <section>
              <h2>When This Is All You Have</h2>
              <p>Linear search works on <b>any</b> list.</p>
              <p class="fragment">Sorted, unsorted, numbers, names. It never fails.</p>
              <p class="fragment">Next session: give up that guarantee, and go far faster.</p>
            </section>

            <section>
              <h2>Today's Objectives</h2>
              <ul>
                <li>Defining an algorithm as a finite set of instructions</li>
                <li>Showing that one problem has many correct algorithms</li>
                <li>Writing a linear search that reports where it found something</li>
                <li>Counting the checks in the best, worst, and not-found cases</li>
              </ul>
            </section>

            <section>
              <h2>Key Terms</h2>
              <div class="text-start">
                <dl>
                  <dt>Algorithm</dt>
                  <dd>A finite set of instructions that accomplishes a task.</dd>
                  <dt>Linear search</dt>
                  <dd>Check each element in order until you find the target or run out.</dd>
                  <dt>Worst case</dt>
                  <dd>The input that makes an algorithm do the most work.</dd>
                </dl>
              </div>
            </section>
          </Presentation>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Build -->
        <section id="build">
          <h2>Build</h2>

          <p>
            Create a new <b>JavaScript program</b> named{" "}
            <b class="text-sn-theme">2-9-search</b>.
          </p>

          <hr class="my-4" />

          <h3>Task 1: Find Someone</h3>
          <ul>
            <li>Write the code below and run it.</li>
            <li><b>Before you run it, predict the check count.</b> Write your prediction in a comment.</li>
          </ul>
          <Code code={Task1} frame="code" lang="javascript" title="Linear Search" class="mt-3" />

          <hr class="my-4" />

          <h3>Task 2: Three Cases</h3>
          <ul>
            <li>Add the two extra calls and run it again.</li>
            <li>
              One of these is the best case, one is the worst case, and one is
              neither &mdash; but costs the same as the worst case.{" "}
              <b>Label all three in comments.</b>
            </li>
            <li>In a comment: why does searching for someone who is not there cost the same as searching for the last person?</li>
          </ul>
          <Code code={Task2} frame="code" lang="javascript" title="Linear Search" class="mt-3" />

          <hr class="my-4" />

          <h3>Task 3: Your Own Search</h3>
          <ul>
            <li>Fill in the comment block.</li>
          </ul>
          <Code code={Task3} frame="code" lang="javascript" title="Linear Search" class="mt-3" />

          <h5 class="mt-4">Challenge (optional)</h5>
          <ul>
            <li>
              Write <code>countMatches(list, target)</code>, which returns how
              many times the target appears. Then explain why this one{" "}
              <b>cannot</b> stop early, and what that does to its best case.
            </li>
          </ul>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Exam Notation -->
        <section id="exam-notation">
          <h2>Same Idea, Exam Notation</h2>

          <div class="row g-3 my-4">
            <div class="col-md-6">
              <Code
                code={NotationJs}
                frame="code"
                lang="javascript"
                title="JavaScript"
                showLineNumbers={false}
              />
            </div>
            <div class="col-md-6">
              <Code
                code={NotationPseudo}
                frame="code"
                lang="txt"
                title="Exam Notation"
                showLineNumbers={false}
              />
            </div>
          </div>

          <p>Three differences, and all three cost points if you miss them.</p>
          <ul>
            <li>
              <b>The exam has no <code>for</code> loop.</b> You keep the counter
              yourself: set <code>i</code> before the loop, and add to it inside.
            </li>
            <li>
              <b><code>REPEAT UNTIL</code> is the inverse of <code>while</code>.</b>{" "}
              JavaScript repeats <i>while</i> there is more list; the exam repeats{" "}
              <i>until</i> you have run off the end.
            </li>
            <li>
              <b>Exam lists start at index 1.</b> The same search over the same
              list returns a number one higher than JavaScript does.
            </li>
          </ul>

          <p>
            <b>That last one is the trap.</b> Finding <code>"Vega"</code> at the
            front of the list is index <code>0</code> in your program and index{" "}
            <code>1</code> on the exam. Both are correct. Read which notation you
            are in before you answer.
          </p>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Checkpoint -->
        <section id="checkpoint">
          <h2>Checkpoint</h2>

          <p>Task 2 should produce exactly this.</p>

          <Code
            code={ExampleOutput}
            frame="terminal"
            lang="txt"
            showLineNumbers={false}
            title="Example Output"
          />

          <p class="mt-3">
            Your Task 3 output will use your own numbers, but all three calls must
            report a check count.
          </p>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Reflection -->
        <section id="reflection">
          <h2>Reflection</h2>

          <p>Answer these before submitting your work.</p>

          <ol>
            <li>Algorithm B is correct and does almost four times the work. Is it a bad algorithm? Defend your answer.</li>
            <li>Linear search never fails, on any list. Name the price you pay for that guarantee.</li>
            <li>Your program returns <code>-1</code> for not-found. What would go wrong if it returned <code>0</code> instead?</li>
          </ol>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Submit -->
        <section id="submit">
          <h2>Submit</h2>

          <p>Submit the required files to the appropriate dropbox.</p>

          <h1
            class="text-center mt-5 text-sn-theme border border-primary slow-flash"
          >
            Activity Complete
          </h1>
        </section>
      </div>
    </div>
  </div>
</Layout>

---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `Thousands of holiday photos on a slow drive. I want to find the
ones from a particular month and know how much space they take
before I copy anything. Do not make me wait while it opens
every picture.`;

const SampleOutput = `Photos from May:
  IMG_0412  Paris  4.2 MB
  IMG_0413  Paris  3.8 MB
  2 photos, 8.0 MB total
Photos from Jul:
  IMG_0602  Nice  2.9 MB
  IMG_0603  Nice  6.4 MB
  2 photos, 9.3 MB total
Photos from Dec:
  none

Images opened: 0`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-2/cc-set-7" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 7
        </a>

        <h1>Code Challenge: Metadata Search</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code code={Brief} frame="code" lang="txt" title="What they asked for" showLineNumbers={false} class="mt-3" />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-2/cc-set-7">Set 7</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li>Everything you need is in the <b>metadata</b>. The images are never touched, and that is the whole point of the brief.</li>
            <li>Parallel lists: filename, month, place, size. They must stay lined up.</li>
            <li>Report the count and the total size, not just the matches. <i>Before I copy anything</i> is a requirement.</li>
            <li>Handle a month with no photos in it.</li>
            <li><b>Print how many images you opened.</b> The answer should be zero, and printing it is how you prove you met the brief.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code code={SampleOutput} frame="terminal" title="Sample Output" lang="txt" showLineNumbers={false} class="mt-3" />

          <p class="mt-3">
            <b>That last line is the deliverable.</b> Metadata is what lets you answer a
            question about a thousand files without reading any of them.
          </p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-metadata-search</b>.
          </p>
        </section>

        <h1 class="text-center mt-5 text-sn-theme border border-primary slow-flash">
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

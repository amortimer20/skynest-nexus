---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `The greenhouse controller needs to know what to do at a
given temperature. Too cold, fine, or too hot, and what
action to take. One reading in, one instruction out.`;

const SampleOutput = `12 -> Turn heaters on
21 -> No action
34 -> Open vents`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-2/cc-set-5" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 5
        </a>

        <h1>Code Challenge: Temperature Band</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code code={Brief} frame="code" lang="txt" title="What they asked for" showLineNumbers={false} class="mt-3" />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-2/cc-set-5">Set 5</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li>Return the instruction as text rather than printing it.</li>
            <li>Three bands means two boundaries. Both need deciding and recording.</li>
            <li>Call it with a reading right on a boundary and confirm you get exactly one answer.</li>
          </ul>
        </section>

        <hr />

        <section id="where-to-start">
          <h2>Where to Start</h2>

          <p>
            <b>Only one-star challenges have this section.</b> If you already know how to
            begin, skip it &mdash; and when you move up to two stars, working out the order
            yourself is part of the job.
          </p>

          <ol>
            <li>Decide your two boundary temperatures and write them down first.</li>
            <li>Write the procedure with one parameter.</li>
            <li>Use <code>return</code> for each of the three cases.</li>
            <li>Print the result of three calls to prove it works.</li>
          </ol>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code code={SampleOutput} frame="terminal" title="Sample Output" lang="txt" showLineNumbers={false} class="mt-3" />

          <p class="mt-3">Test your two boundary values exactly. They should each give one answer, not two and not none.</p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-temperature-band</b>.
          </p>
        </section>

        <h1 class="text-center mt-5 text-sn-theme border border-primary slow-flash">
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

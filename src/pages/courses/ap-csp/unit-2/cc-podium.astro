---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `Swim meet. I have the names and the finishing times. I need
gold, silver and bronze on the board within a minute of the
race ending. Fastest time wins, so smallest number first.`;

const SampleOutput = `Gold: Ravi 54.9s
Silver: Nadia 55.7s
Bronze: Priya 56.4s`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-2/cc-set-6" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 6
        </a>

        <h1>Code Challenge: Podium</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code code={Brief} frame="code" lang="txt" title="What they asked for" showLineNumbers={false} class="mt-3" />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-2/cc-set-6">Set 6</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li>The names have to move with the times. If they do not, you will award someone else's medal.</li>
            <li>You do not need the whole list sorted. Three passes of selection sort is enough to fix the first three places.</li>
            <li>Times are decimals. Decide how many places you show, and be consistent.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code code={SampleOutput} frame="terminal" title="Sample Output" lang="txt" showLineNumbers={false} class="mt-3" />

          <p class="mt-3">
            <b>Smallest first</b>, because this is a race. A sort you copied
            from the activity will put the slowest swimmer on the top step.
          </p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-podium</b>.
          </p>
        </section>

        <h1 class="text-center mt-5 text-sn-theme border border-primary slow-flash">
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

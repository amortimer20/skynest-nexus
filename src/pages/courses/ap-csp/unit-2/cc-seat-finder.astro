---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `Box office. Someone walks up with a seat number and I need to
know fast whether it has been sold. The sold list is kept in
order. Do not make me wait while it checks all of them.`;

const SampleOutput = `sorted? true
Seat 55: row index 4 (3 checks)
Seat 12: row index 0 (3 checks)
Seat 50: not sold (3 checks)`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-2/cc-set-6" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 6
        </a>

        <h1>Code Challenge: Seat Finder</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code code={Brief} frame="code" lang="txt" title="What they asked for" showLineNumbers={false} class="mt-3" />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-2/cc-set-6">Set 6</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li><b>Kept in order</b> is the whole brief. That word is what lets you use binary search.</li>
            <li>Do not trust it. Write a check that confirms the list is sorted before you search it, and say what your program does if it is not.</li>
            <li>Report the number of checks so the box office can see the difference.</li>
            <li>Handle a seat number that was never sold.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code code={SampleOutput} frame="terminal" title="Sample Output" lang="txt" showLineNumbers={false} class="mt-3" />

          <p class="mt-3">
            Eight seats, and every one of these took three checks or fewer.
            Notice that seat 12 is <i>first</i> in the list and still took
            three &mdash; binary search does not reward being at the front.
          </p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-seat-finder</b>.
          </p>
        </section>

        <h1 class="text-center mt-5 text-sn-theme border border-primary slow-flash">
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

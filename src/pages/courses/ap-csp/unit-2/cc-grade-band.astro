---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Brief = `I want a procedure I can drop into any of my programs
that turns a percent into a letter. Just the letter back,
nothing printed. I will decide what to do with it.`;

const SampleOutput = `95 -> A
89.5 -> B
72 -> C
59 -> F`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/ap-csp/unit-2/cc-set-5" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back to Set 5
        </a>

        <h1>Code Challenge: Grade Band</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="brief">
          <h2>The Brief</h2>

          <Code code={Brief} frame="code" lang="txt" title="What they asked for" showLineNumbers={false} class="mt-3" />

          <p class="mt-4">
            <b>Write your requirements list before you write any code.</b> Input,
            calculate, output, and anything you had to decide for yourself. See{" "}
            <a href="/courses/ap-csp/unit-2/cc-set-5">Set 5</a> for what that looks like.
          </p>
        </section>

        <hr />

        <section id="notes">
          <h2>Notes</h2>

          <ul>
            <li><b>Just the letter back, nothing printed</b> is the whole specification. Honor it.</li>
            <li>Test it by calling it inside a <code>console.log</code>, which proves it returned something.</li>
            <li>The bands are the standard ones. Boundaries are yours to decide &mdash; record the decision.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code code={SampleOutput} frame="terminal" title="Sample Output" lang="txt" showLineNumbers={false} class="mt-3" />

          <p class="mt-3">89.5 is there deliberately. Whatever you decide, it must be a decision you can defend.</p>
        </section>

        <hr />

        <section id="submit">
          <h2>Submit</h2>

          <p>
            Your requirements list and your program file, named{" "}
            <b class="text-sn-theme">cc-grade-band</b>.
          </p>
        </section>

        <h1 class="text-center mt-5 text-sn-theme border border-primary slow-flash">
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

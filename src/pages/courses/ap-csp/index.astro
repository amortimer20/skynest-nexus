---
import Layout from "../../../layouts/Layout.astro";
import ListItem from "../../../components/ui/ListItem.astro";
import ChallengeItem from "../../../components/ui/ChallengeItem.astro";

import ApCspIcon from "../../../assets/courses/ap-csp/img/ap-csp-icon.svg";
---

<Layout>
  <div class="py-5 mb-3 bg-sn-darker bottom-shadow">
    <div class="p-5">
      <a href="/#course-content" class="btn btn-sm btn-outline-light"
        ><i class="si-arrow-left"></i> Back</a
      >
    </div>
    <div class="container pb-5">
      <div class="text-center">
        <h1>AP Computer Science Principles</h1>
        <ApCspIcon width={128} height={128} />
      </div>
    </div>
  </div>

  <div class="container">
    <h3>Course Content</h3>
    <div class="accordion mb-5" id="courseAccordion">
      <!-- Quarter 1 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseOne"
            aria-expanded="true"
            aria-controls="flush-collapseOne"
          >
            Quarter 1: Foundations + Programming Fundamentals
          </button>
        </h2>
        <div
          id="flush-collapseOne"
          class="accordion-collapse collapse"
          data-bs-parent="#courseAccordion"
        >
          <div class="accordion-body">
            <h6 class="text-sn-theme mt-2">Programming Foundations</h6>
            <ListItem><a href="./unit-1/1-1">Activity 1.1: Welcome to AP CSP</a></ListItem>
            <ListItem><a href="./unit-1/1-2">Activity 1.2: Console Output and Comments</a></ListItem>
            <ListItem><a href="./unit-1/1-3">Activity 1.3: Variables and Data Types</a></ListItem>
            <ListItem><a href="./unit-1/1-4">Activity 1.4: Arithmetic and Precedence</a></ListItem>
            <ChallengeItem
              href="./unit-1/dc-arithmetic"
              icon="si-bug"
              srLabel="Debug challenge">Arithmetic</ChallengeItem>
            <ChallengeItem
              href="./unit-1/pc-arithmetic"
              icon="si-pencil"
              srLabel="Pseudocode challenge">Arithmetic</ChallengeItem>
            <ListItem><a href="./unit-1/1-5">Activity 1.5: p5 Lab 1 &mdash; The Canvas</a></ListItem>
            <ListItem><a href="./unit-1/1-6">Activity 1.6: Styled Output</a></ListItem>
            <ListItem><a href="./unit-1/1-7">Activity 1.7: Console Input</a></ListItem>
            <ListItem><a href="./unit-1/1-8">Activity 1.8: Type Casting</a></ListItem>
            <ListItem><a href="./unit-1/mcq-1">Question Set 1</a></ListItem>
            <ListItem><a href="./unit-1/1-9">Activity 1.9: p5 Lab 2 &mdash; Variables That Draw</a></ListItem>
            <ListItem><a href="./unit-1/1-10">Activity 1.10: Booleans and Comparison</a></ListItem>
            <ListItem><a href="./unit-1/1-11">Activity 1.11: Making Decisions</a></ListItem>
            <ListItem><a href="./unit-1/1-12">Activity 1.12: Chains of Decisions</a></ListItem>
            <ListItem><a href="./unit-1/1-13">Activity 1.13: p5 Lab 3 &mdash; Decisions You Can See</a></ListItem>
            <ListItem><a href="./unit-1/1-14">Activity 1.14: Combining Conditions</a></ListItem>
            <ListItem><a href="./unit-1/1-15">Activity 1.15: Nested Conditions and Randomness</a></ListItem>
            <ListItem><a href="./unit-1/1-16">Activity 1.16: Repeating With while</a></ListItem>
            <ListItem><a href="./unit-1/1-17">Activity 1.17: p5 Lab 4 &mdash; The Loop You Didn't Write</a></ListItem>
            <ListItem><a href="./unit-1/1-18">Activity 1.18: Counting With for</a></ListItem>
            <ListItem><a href="./unit-1/1-19">Activity 1.19: Loop Patterns</a></ListItem>
            <ListItem><a href="./unit-1/1-20">Activity 1.20: Loops Inside Loops</a></ListItem>
            <ListItem><a href="./unit-1/1-21">Activity 1.21: p5 Lab 5 &mdash; Grids</a></ListItem>
            <ListItem><a href="./unit-1/1-22">Activity 1.22: Arrays</a></ListItem>
            <ListItem><a href="./unit-1/1-23">Activity 1.23: Length and Safe Access</a></ListItem>
            <ListItem><a href="./unit-1/1-24">Activity 1.24: Walking Through an Array</a></ListItem>
            <ListItem><a href="./unit-1/1-25">Activity 1.25: p5 Lab 6 &mdash; Drawing From Data</a></ListItem>
            <ListItem><a href="./unit-1/1-26">Activity 1.26: Quarter 1 Review</a></ListItem>
          </div>
        </div>
      </div>
      <!-- Quarter 2 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseTwo"
            aria-expanded="false"
            aria-controls="flush-collapseTwo"
          >
            Quarter 2: Abstraction, Lists &amp; Transition to Graphics
          </button>
        </h2>
        <div
          id="flush-collapseTwo"
          class="accordion-collapse collapse"
          data-bs-parent="#courseAccordion"
        >
          <div class="accordion-body">
            <ListItem><a href="./TBD">TBD</a></ListItem>
          </div>
        </div>
      </div>
      <!-- Quarter 3 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseThree"
            aria-expanded="false"
            aria-controls="flush-collapseThree"
          >
            Quarter 3: Create Performance Task
          </button>
        </h2>
        <div
          id="flush-collapseThree"
          class="accordion-collapse collapse"
          data-bs-parent="#courseAccordion"
        >
          <div class="accordion-body">
            <ListItem><a href="./TBD">TBD</a></ListItem>
          </div>
        </div>
      </div>
      <!-- Quarter 4 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseFour"
            aria-expanded="false"
            aria-controls="flush-collapseFour"
          >
            Quarter 4: Close Content &amp; Exam Prep
          </button>
        </h2>
        <div
          id="flush-collapseFour"
          class="accordion-collapse collapse"
          data-bs-parent="#courseAccordion"
        >
          <div class="accordion-body">
            <ListItem><a href="./TBD">TBD</a></ListItem>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

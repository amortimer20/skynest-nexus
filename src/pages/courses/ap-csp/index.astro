---
import Layout from "../../../layouts/Layout.astro";
import ListItem from "../../../components/ui/ListItem.astro";
import ChallengeItem from "../../../components/ui/ChallengeItem.astro";

import ApCspIcon from "../../../assets/courses/ap-csp/img/ap-csp-icon.svg";
---

<Layout>
  <div class="py-5 mb-3 bg-sn-darker bottom-shadow">
    <div class="p-5">
      <a href="/#course-content" class="btn btn-sm btn-outline-light"
        ><i class="si-arrow-left"></i> Back</a
      >
    </div>
    <div class="container pb-5">
      <div class="text-center">
        <h1>AP Computer Science Principles</h1>
        <ApCspIcon width={128} height={128} />
      </div>
    </div>
  </div>

  <div class="container">
    <h3>Course Content</h3>
    <div class="accordion mb-5" id="courseAccordion">
      <!-- Quarter 1 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseOne"
            aria-expanded="true"
            aria-controls="flush-collapseOne"
          >
            Quarter 1: Foundations + Programming Fundamentals
          </button>
        </h2>
        <div
          id="flush-collapseOne"
          class="accordion-collapse collapse"
          data-bs-parent="#courseAccordion"
        >
          <div class="accordion-body">
            <h6 class="text-sn-theme mt-2">Part 0: Before the Code</h6>
            <ListItem><a href="./unit-1/1-1">Activity 1.1: Welcome to AP CSP</a></ListItem>
            <ListItem><a href="./unit-1/1-2">Activity: Data and What It Costs</a></ListItem>
            <ListItem><a href="./unit-1/1-3">Activity: Who Computing Helps, and Who It Hurts</a></ListItem>
            <ListItem><a href="./unit-1/mcq-passage"><b>Question Set: Reading Passage</b></a></ListItem>

            <h6 class="text-sn-theme mt-4">Part 1: Data, Input, and Output</h6>
            <ListItem><a href="./unit-1/1-4">Activity 1.4: Console Output and Comments</a></ListItem>
            <ChallengeItem href="./unit-1/cc-name-card">Name Card</ChallengeItem>
            <ListItem><a href="./unit-1/1-5">Activity 1.5: Variables and Data Types</a></ListItem>
            <ChallengeItem href="./unit-1/cc-receipt-line">Receipt Line</ChallengeItem>
            <ListItem><a href="./unit-1/1-6">Activity 1.6: Arithmetic and Precedence</a></ListItem>
            <ChallengeItem href="./unit-1/cc-time-split">Time Split</ChallengeItem>
            <ChallengeItem href="./unit-1/cc-pizza-split">Pizza Split</ChallengeItem>
            <ChallengeItem
              href="./unit-1/dc-arithmetic"
              icon="si-bug"
              srLabel="Debug challenge">Arithmetic</ChallengeItem>
            <ChallengeItem
              href="./unit-1/pc-arithmetic"
              icon="si-pencil"
              srLabel="Pseudocode challenge">Arithmetic</ChallengeItem>
            <ListItem><a href="./unit-1/1-7">Activity 1.7: p5 Lab 1 &mdash; The Canvas</a></ListItem>
            <ListItem><a href="./unit-1/1-8">Activity 1.8: Console Input</a></ListItem>
            <ChallengeItem href="./unit-1/cc-trip-cost">Trip Cost</ChallengeItem>
            <ChallengeItem href="./unit-1/cc-locker-combo">Locker Combo</ChallengeItem>
            <ListItem><a href="./unit-1/1-9">Activity 1.9: Type Casting</a></ListItem>

---
import Layout from "../../../layouts/Layout.astro";
import ListItem from "../../../components/ui/ListItem.astro";

import GameDesignIcon from "../../../assets/courses/game-design/img/game-design-icon.svg";
---

<Layout>
  <div class="py-5 mb-3 bg-sn-darker bottom-shadow">
    <div class="p-5">
      <a href="/#course-content" class="btn btn-sm btn-outline-light"
        ><i class="si-arrow-left"></i> Back</a
      >
    </div>
    <div class="container pb-5">
      <div class="text-center">
        <h1>Fundamentals of Game Design</h1>
        <GameDesignIcon width={128} height={128} />
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <h3>About This Course</h3>

        <p>
          <b class="text-sn-theme">Build games in Godot 4, and understand what
          the engine is doing underneath.</b> Unit 1 starts with a physics
          sandbox you can knock over before you have written a line of code,
          teaches GDScript by making that sandbox do more, and ends with an
          arcade shooter you redesign into your own. Unit 2 builds a platformer
          from the ground up &mdash; jump feel, tilemaps, enemies &mdash; then
          adds pixel art and sound, and finishes with a game of your own
          design.
        </p>

        <p>
          <b>No experience needed.</b> Everything you build runs in a web
          browser and gets played by someone other than you, because a game
          nobody has played is not finished yet.
        </p>

        <h3 class="mt-5">Course Content</h3>

        <h4 class="mt-2">Unit 1: Foundations &amp; Arcade Games</h4>
        <div class="accordion mb-5" id="unit1Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g1"
                aria-expanded="false"
                aria-controls="u1g1"
              >
                Getting Started
              </button>
            </h2>
            <div
              id="u1g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem><a href="./conventions">How This Course Uses Godot</a></ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g2"
                aria-expanded="false"
                aria-controls="u1g2"
              >
                Junkyard
              </button>
            </h2>
            <div
              id="u1g2"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Play"><a href="./unit-1/play-junkyard">Play Junkyard</a></ListItem>
                <ListItem><a href="./unit-1/1-1">Activity 1.1: Getting Started with Godot</a></ListItem>
                <ListItem tag="Soon">Activity 1.2: Transforms and the 2D Coordinate System</ListItem>
                <ListItem tag="Soon">Activity 1.3: Gravity and Collision</ListItem>
                <ListItem tag="Soon">Activity 1.4: Scenes You Can Reuse</ListItem>
                <ListItem tag="Soon">Activity 1.5: The Wrecking Ball</ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g3"
                aria-expanded="false"
                aria-controls="u1g3"
              >
                GDScript Fundamentals
              </button>
            </h2>
            <div
              id="u1g3"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g4"
                aria-expanded="false"
                aria-controls="u1g4"
              >
                Space Shooter
              </button>
            </h2>
            <div
              id="u1g4"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g5"
                aria-expanded="false"
                aria-controls="u1g5"
              >
                Project 1: Make It Yours
              </button>
            </h2>
            <div
              id="u1g5"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Redesign Your Shooter (End-of-Quarter Summative)</ListItem>
              </div>
            </div>
          </div>
        </div>

        <h4 class="mt-2">Unit 2: Platformers &amp; Original Design</h4>
        <div class="accordion mb-5" id="unit2Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u2g1"
                aria-expanded="false"
                aria-controls="u2g1"
              >
                Movement and Jump Feel
              </button>
            </h2>
            <div
              id="u2g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit2Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u2g2"
                aria-expanded="false"
                aria-controls="u2g2"
              >
                Building a World
              </button>
            </h2>
            <div
              id="u2g2"
              class="accordion-collapse collapse"
              data-bs-parent="#unit2Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u2g3"
                aria-expanded="false"
                aria-controls="u2g3"
              >
                Art and Audio
              </button>
            </h2>
            <div
              id="u2g3"
              class="accordion-collapse collapse"
              data-bs-parent="#unit2Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u2g4"
                aria-expanded="false"
                aria-controls="u2g4"
              >
                Project 2: Your Own Game
              </button>
            </h2>
            <div
              id="u2g4"
              class="accordion-collapse collapse"
              data-bs-parent="#unit2Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Capstone (End-of-Quarter Summative)</ListItem>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from "../../../layouts/Layout.astro";
import ListItem from "../../../components/ui/ListItem.astro";

import GameDesignIcon from "../../../assets/courses/game-design/img/game-design-icon.svg";
---

<Layout>
  <div class="py-5 mb-3 bg-sn-darker bottom-shadow">
    <div class="p-5">
      <a href="/#course-content" class="btn btn-sm btn-outline-light"
        ><i class="si-arrow-left"></i> Back</a
      >
    </div>
    <div class="container pb-5">
      <div class="text-center">
        <h1>Fundamentals of Game Design</h1>
        <GameDesignIcon width={128} height={128} />
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <h3>About This Course</h3>

        <p>
          <b class="text-sn-theme">Make games in Godot 4, and understand what
          the engine is doing.</b> Quarter 1 covers scenes, the node tree,
          coordinate space and physics. Quarter 2 puts those systems together
          into a full game.
        </p>

        <h3 class="mt-5">Course Content</h3>

        <h4 class="mt-2">Quarter 1: Foundations &amp; Physics</h4>
        <div class="accordion mb-5" id="unit1Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g1"
                aria-expanded="false"
                aria-controls="u1g1"
              >
                Week 1: Concepts + Setup
              </button>
            </h2>
            <div
              id="u1g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem><a href="./unit-1/1-1">Activity 1.1: Getting Started with Godot</a></ListItem>
                <ListItem><a href="./unit-1/1-2">Activity 1.2: Transforms and Your First Scene</a></ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g2"
                aria-expanded="false"
                aria-controls="u1g2"
              >
                Week 2: Nodes, Scenes &amp; the Scene Tree
              </button>
            </h2>
            <div
              id="u1g2"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem><a href="./unit-2/2-1">Activity 2.1: Building a Scene from Nodes</a></ListItem>
                <ListItem><a href="./unit-2/2-2">Activity 2.2: The Scene Tree, Coordinate Space, and Draw Order</a></ListItem>
              </div>
            </div>
          </div>
        </div>

        <h4 class="mt-2">Quarter 2: Systems, Events &amp; a Full Game</h4>
        <div class="accordion mb-5" id="unit2Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u2g1"
                aria-expanded="false"
                aria-controls="u2g1"
              >
                Coming Soon
              </button>
            </h2>
            <div
              id="u2g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit2Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

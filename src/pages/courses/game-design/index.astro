---
import Layout from "../../../layouts/Layout.astro";
import ListItem from "../../../components/ui/ListItem.astro";

import GameDesignIcon from "../../../assets/courses/game-design/img/game-design-icon.svg";
---

<Layout>
  <div class="py-5 mb-3 bg-sn-darker bottom-shadow">
    <div class="p-5">
      <a href="/#course-content" class="btn btn-sm btn-outline-light"
        ><i class="si-arrow-left"></i> Back</a
      >
    </div>
    <div class="container pb-5">
      <div class="text-center">
        <h1>Fundamentals of Game Design</h1>
        <GameDesignIcon width={128} height={128} />
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <h3>About This Course</h3>

        <p>
          <b class="text-sn-theme">Make games in Godot 4, and understand what
          the engine is doing.</b> Quarter 1 builds up to a complete arcade
          shooter. Quarter 2 builds a platformer, then turns you loose on a
          game of your own.
        </p>

        <h3 class="mt-5">Course Content</h3>

        <h4 class="mt-2">Quarter 1</h4>
        <div class="accordion mb-5" id="unit1Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g1"
                aria-expanded="false"
                aria-controls="u1g1"
              >
                Coming Soon
              </button>
            </h2>
            <div
              id="u1g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
        </div>

        <h4 class="mt-2">Quarter 2</h4>
        <div class="accordion mb-5" id="unit2Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u2g1"
                aria-expanded="false"
                aria-controls="u2g1"
              >
                Coming Soon
              </button>
            </h2>
            <div
              id="u2g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit2Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

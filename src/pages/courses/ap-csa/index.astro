---
import Layout from "../../../layouts/Layout.astro";
import ListItem from "../../../components/ui/ListItem.astro";

import ApCsaIcon from "../../../assets/courses/ap-csa/img/ap-csa-icon.svg";
---

<Layout>
  <div class="mb-3 bg-sn-darker bottom-shadow">
    <div class="p-5">
      <a href="/#course-content" class="btn btn-sm btn-outline-light"
        ><i class="si-arrow-left"></i> Back</a
      >
    </div>
    <div class="container pb-5">
      <div class="text-center">
        <h1>AP Computer Science A</h1>
        <ApCsaIcon width={110} />
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <h3>About This Course</h3>

        <p>
          <b class="text-sn-theme">This is a self-study course.</b> Nobody is
          grading it and there is no dropbox. It exists so that a student who
          wants to sit the AP Computer Science A exam can prepare for it
          properly, on their own schedule, in Java.
        </p>

        <p>
          <b>You should already have written code in something.</b> Python,
          JavaScript, Lua &mdash; any of them is enough. This course spends its
          time on what makes Java <i>different</i>: types you declare, integers
          that divide strangely, and objects you have to build before you can
          use them. It does not spend a page explaining what a loop is.
        </p>

        <p>
          Every unit here matches a unit of the College Board's course
          framework, so anything you read in a prep book or answer in the online
          question bank lines up with where you are.
        </p>

        <h3 class="mt-5">Course Content</h3>

        <h4 class="mt-2">Unit 1: Using Objects and Methods</h4>
        <div class="accordion mb-5" id="unit1Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g1"
                aria-expanded="false"
                aria-controls="u1g1"
              >
                Getting Started
              </button>
            </h2>
            <div
              id="u1g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <h6 class="text-sn-theme mt-2">Setup</h6>
                <ListItem>
                  <a href="./setup">Setting Up and Running Java</a>
                </ListItem>
                <ListItem>
                  <a href="./exam">The Exam, and How to Pace Yourself</a>
                </ListItem>

                <h6 class="text-sn-theme mt-3">Java Basics</h6>
                <ListItem tag="Soon">
                  Activity 1.1: How Java Runs
                </ListItem>
                <ListItem tag="Soon">
                  Activity 1.2: Static Types and Primitives
                </ListItem>
                <ListItem tag="Soon">
                  Activity 1.3: Expressions, Integer Division, and Output
                </ListItem>
                <ListItem tag="Soon">
                  Activity 1.4: Assignment and Compound Operators
                </ListItem>
                <ListItem tag="Soon">
                  Activity 1.5: Casting, Range, and Overflow
                </ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g2"
                aria-expanded="false"
                aria-controls="u1g2"
              >
                Methods and Objects
              </button>
            </h2>
            <div
              id="u1g2"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">
                  Activity 1.6: The API, Libraries, and Documentation
                </ListItem>
                <ListItem tag="Soon">
                  Activity 1.7: Method Signatures and the Math Class
                </ListItem>
                <ListItem tag="Soon">
                  Activity 1.8: Objects and Instance Methods
                </ListItem>
                <ListItem tag="Soon">
                  Activity 1.9: Strings and String Manipulation
                </ListItem>
              </div>
            </div>
          </div>
        </div>

        <h4 class="mt-2">Unit 2: Selection and Iteration</h4>
        <div class="accordion mb-5" id="unit2Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u2g1"
                aria-expanded="false"
                aria-controls="u2g1"
              >
                Making Decisions
              </button>
            </h2>
            <div
              id="u2g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit2Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u2g2"
                aria-expanded="false"
                aria-controls="u2g2"
              >
                Loops and Analysis
              </button>
            </h2>
            <div
              id="u2g2"
              class="accordion-collapse collapse"
              data-bs-parent="#unit2Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
        </div>

        <h4 class="mt-2">Unit 3: Class Creation</h4>
        <div class="accordion mb-5" id="unit3Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u3g1"
                aria-expanded="false"
                aria-controls="u3g1"
              >
                Writing Your Own Classes
              </button>
            </h2>
            <div
              id="u3g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit3Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
        </div>

        <h4 class="mt-2">Unit 4: Data Collections</h4>
        <div class="accordion mb-5" id="unit4Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u4g1"
                aria-expanded="false"
                aria-controls="u4g1"
              >
                Arrays and ArrayLists
              </button>
            </h2>
            <div
              id="u4g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit4Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u4g2"
                aria-expanded="false"
                aria-controls="u4g2"
              >
                Searching, Sorting, and Recursion
              </button>
            </h2>
            <div
              id="u4g2"
              class="accordion-collapse collapse"
              data-bs-parent="#unit4Accordion"
            >
              <div class="accordion-body">
                <ListItem tag="Soon">Activities are still being written</ListItem>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

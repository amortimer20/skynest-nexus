---
import Layout from "../../../layouts/Layout.astro";
import ListItem from "../../../components/ui/ListItem.astro";
import ChallengeItem from "../../../components/ui/ChallengeItem.astro";

import ApCspIcon from "../../../assets/courses/ap-csp/img/ap-csp-icon.svg";
---

<Layout>
  <div class="py-5 mb-3 bg-sn-darker bottom-shadow">
    <div class="p-5">
      <a href="/#course-content" class="btn btn-sm btn-outline-light"
        ><i class="si-arrow-left"></i> Back</a
      >
    </div>
    <div class="container pb-5">
      <div class="text-center">
        <h1>AP Computer Science Principles</h1>
        <p class="text-secondary mb-0">Lua and LÖVE</p>
        <ApCspIcon width={128} height={128} />
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <h3>About This Course</h3>

        <p>
          <b class="text-sn-theme">A full year of computer science that starts
          from nothing.</b> You will write Lua, draw and animate with LÖVE,
          build the Create Performance Task you submit to the College Board, and
          prepare for the AP exam. No prior programming experience is assumed.
        </p>

        <p>
          Most of what you write this year puts something on a screen. You open
          a window in the second session and keep drawing from there &mdash;
          shapes, motion, collisions, and eventually a game you design yourself.
          The rest of the time you work in text, where text is genuinely the
          point.
        </p>

        <h3 class="mt-5">Course Content</h3>

        <h4 class="mt-2">Quarter 1: Creative Development, and the Language</h4>
        <div class="accordion mb-5" id="unit1Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g1"
                aria-expanded="false"
                aria-controls="u1g1"
              >
                Part 1: Getting Started
              </button>
            </h2>
            <div
              id="u1g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem><a href="./setup">Setting Up Your Workspace</a></ListItem>
                <ListItem><a href="./unit-1/1-1">Activity 1.1: Welcome to AP CSP</a></ListItem>
                <ListItem><a href="./unit-1/1-2">Activity 1.2: Your First Window</a></ListItem>
                <ListItem><a href="./unit-1/1-3">Activity 1.3: Naming Your Numbers</a></ListItem>
                <ListItem><a href="./unit-1/1-4">Activity 1.4: Asking a Question</a></ListItem>
                <ListItem><a href="./unit-1/1-5">Activity 1.5: Doing the Math</a></ListItem>
                <ListItem><a href="./unit-1/1-6">Activity 1.6: Ask, Compute, Answer</a></ListItem>
                <ChallengeItem
                  href="./unit-1/cc-set-1"
                  srLabel="Code challenge set"
                  tag="Any 2 of 4">Code Challenge Set 1</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-tip-split"
                  srLabel="Code challenge"
                  className="ms-5">Tip Split</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-recipe-scaler"
                  srLabel="Code challenge"
                  className="ms-5">Recipe Scaler</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-screen-time"
                  srLabel="Code challenge"
                  className="ms-5">Screen Time</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-fuel-range"
                  srLabel="Code challenge"
                  className="ms-5">Fuel Range</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/mcq-1"
                  icon="si-check"
                  srLabel="Question set">Question Set 1</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/dc-basics"
                  icon="si-bug"
                  srLabel="Debug challenge">Values and Arithmetic</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/pc-arithmetic"
                  icon="si-pencil"
                  srLabel="Pseudocode challenge">Arithmetic</ChallengeItem>
                <ListItem tag="Review"><a href="./unit-1/sum-getting-started">Section Summary: Getting Started</a></ListItem>
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g2"
                aria-expanded="false"
                aria-controls="u1g2"
              >
                Part 2: Motion and Decisions
              </button>
            </h2>
            <div
              id="u1g2"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem><a href="./unit-1/1-7">Activity 1.7: Making It Move</a></ListItem>
                <ListItem><a href="./unit-1/1-8">Activity 1.8: True or False</a></ListItem>
                <ListItem><a href="./unit-1/1-9">Activity 1.9: Deciding at the Edges</a></ListItem>
                <ListItem><a href="./unit-1/1-10">Activity 1.10: More Than Two Choices</a></ListItem>
                <ListItem><a href="./unit-1/1-11">Activity 1.11: Asking Two Things at Once</a></ListItem>
                <ListItem><a href="./unit-1/1-12">Activity 1.12: The Crossing</a></ListItem>
                <ChallengeItem
                  href="./unit-1/cc-set-2"
                  srLabel="Code challenge set"
                  tag="Any 2 of 4">Code Challenge Set 2</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-traffic-light"
                  srLabel="Code challenge"
                  className="ms-5">Traffic Light</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-click-target"
                  srLabel="Code challenge"
                  className="ms-5">Click Target</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-paddle-and-catch"
                  srLabel="Code challenge"
                  className="ms-5">Paddle and Catch</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-dodge"
                  srLabel="Code challenge"
                  className="ms-5">Dodge</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/mcq-2"
                  icon="si-check"
                  srLabel="Question set">Question Set 2</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/dc-conditionals"
                  icon="si-bug"
                  srLabel="Debug challenge">Decisions</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/pc-conditionals"
                  icon="si-pencil"
                  srLabel="Pseudocode challenge">Decisions</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/pc-logic"
                  icon="si-pencil"
                  srLabel="Pseudocode challenge">Combining Conditions</ChallengeItem>
                <ListItem><a href="./unit-1/1-13">Activity 1.13: Taking Control</a></ListItem>
                <ListItem><a href="./unit-1/1-14">Activity 1.14: Touching, and Remembering</a></ListItem>
                <ListItem tag="Review"><a href="./unit-1/sum-motion-and-decisions">Section Summary: Motion and Decisions</a></ListItem>
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g3"
                aria-expanded="false"
                aria-controls="u1g3"
              >
                Part 3: Loops and Tables
              </button>
            </h2>
            <div
              id="u1g3"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem><a href="./unit-1/1-15">Activity 1.15: Doing It Again</a></ListItem>
                <ListItem><a href="./unit-1/1-16">Activity 1.16: Counting Loops</a></ListItem>
                <ListItem><a href="./unit-1/1-17">Activity 1.17: Loops Inside Loops</a></ListItem>
                <ChallengeItem
                  href="./unit-1/mcq-3"
                  icon="si-check"
                  srLabel="Question set">Question Set 3</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/dc-loops"
                  icon="si-bug"
                  srLabel="Debug challenge">Loops</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/pc-loops"
                  icon="si-pencil"
                  srLabel="Pseudocode challenge">Loops</ChallengeItem>
                <ListItem><a href="./unit-1/1-18">Activity 1.18: Tables as Lists</a></ListItem>
                <ListItem><a href="./unit-1/1-19">Activity 1.19: How Long, and What Is Not There</a></ListItem>
                <ListItem><a href="./unit-1/1-20">Activity 1.20: Going Through a Table</a></ListItem>
                <ChallengeItem
                  href="./unit-1/mcq-4"
                  icon="si-check"
                  srLabel="Question set">Question Set 4</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/dc-tables"
                  icon="si-bug"
                  srLabel="Debug challenge">Tables</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/pc-lists"
                  icon="si-pencil"
                  srLabel="Pseudocode challenge">Lists</ChallengeItem>
                <ListItem tag="Review"><a href="./unit-1/sum-loops-and-tables">Section Summary: Loops and Tables</a></ListItem>
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g4"
                aria-expanded="false"
                aria-controls="u1g4"
              >
                Part 4: Functions and the Creative Artifact
              </button>
            </h2>
            <div
              id="u1g4"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <ListItem><a href="./unit-1/1-21">Activity 1.21: Making Your Own Box</a></ListItem>
                <ListItem><a href="./unit-1/1-22">Activity 1.22: Handing an Answer Back</a></ListItem>
                <ListItem><a href="./unit-1/1-23">Activity 1.23: The Fleet, and Who Calls What</a></ListItem>
                <ChallengeItem
                  href="./unit-1/cc-set-3"
                  srLabel="Code challenge set"
                  tag="Any 2 of 4">Code Challenge Set 3</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-grade-book"
                  srLabel="Code challenge"
                  className="ms-5">Grade Book</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-health-bar"
                  srLabel="Code challenge"
                  className="ms-5">Health Bar</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-star-field"
                  srLabel="Code challenge"
                  className="ms-5">Star Field</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/cc-constellation"
                  srLabel="Code challenge"
                  className="ms-5">Constellation</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/mcq-5"
                  icon="si-check"
                  srLabel="Question set">Question Set 5</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/dc-functions"
                  icon="si-bug"
                  srLabel="Debug challenge">Functions</ChallengeItem>
                <ChallengeItem
                  href="./unit-1/pc-traversal"
                  icon="si-pencil"
                  srLabel="Pseudocode challenge">Walking a List</ChallengeItem>
                <ListItem tag="Review"><a href="./unit-1/sum-functions">Section Summary: Functions</a></ListItem>
                <ListItem><a href="./unit-1/1-24">Activity 1.24: Creative Artifact &mdash; The Plan</a></ListItem>
                <ListItem><a href="./unit-1/1-25">Activity 1.25: Creative Artifact &mdash; Build</a></ListItem>
                <ChallengeItem
                  href="./unit-1/wr-artifact"
                  icon="si-pencil"
                  srLabel="Written response">Your Creative Artifact</ChallengeItem>
                <ListItem><a href="./unit-1/1-26">Activity 1.26: Quarter 1 Exam</a></ListItem>
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g5"
                aria-expanded="false"
                aria-controls="u1g5"
              >
                Bonus Projects
              </button>
            </h2>
            <div
              id="u1g5"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <p class="text-body-secondary small">
                  <b>Optional, and worth extra credit.</b> Nothing later depends
                  on them. The badge is the last activity you need to have
                  finished &mdash; anything at or below where you are now is
                  fair game.
                </p>

                <ChallengeItem
                  href="./unit-1/bp-bouncing-logo"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Needs 1.9"
                  tone="gold">Bouncing Logo</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-pong"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Needs 1.14"
                  tone="gold">Pong</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-dodger"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Needs 1.16"
                  tone="gold">Dodger</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-starfield"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Needs 1.20"
                  tone="gold">Starfield</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-game-of-life"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Needs 1.20"
                  tone="gold">Conway&rsquo;s Game of Life</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-snake"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Needs 1.20"
                  tone="gold">Snake</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-breakout"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Needs 1.23"
                  tone="gold">Breakout</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-sprite-animation"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Needs 1.23"
                  tone="gold">Sprite Animation</ChallengeItem
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

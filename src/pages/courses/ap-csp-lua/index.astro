---
import Layout from "../../../layouts/Layout.astro";
import ListItem from "../../../components/ui/ListItem.astro";
import ChallengeItem from "../../../components/ui/ChallengeItem.astro";

import ApCspIcon from "../../../assets/courses/ap-csp/img/ap-csp-icon.svg";
---

<Layout>
  <div class="py-5 mb-3 bg-sn-darker bottom-shadow">
    <div class="p-5">
      <a href="/#course-content" class="btn btn-sm btn-outline-light"
        ><i class="si-arrow-left"></i> Back</a
      >
    </div>
    <div class="container pb-5">
      <div class="text-center">
        <h1>AP Computer Science Principles</h1>
        <p class="text-secondary mb-0">Lua and LÖVE</p>
        <ApCspIcon width={128} height={128} />
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <h3>About This Course</h3>

        <p>
          <b class="text-sn-theme">A full year of computer science that starts
          from nothing.</b> You will write Lua, draw and animate with LÖVE,
          build the Create Performance Task you submit to the College Board, and
          prepare for the AP exam. No prior programming experience is assumed.
        </p>

        <p>
          Most of what you write this year puts something on a screen. You open
          a window in the second session and keep drawing from there &mdash;
          shapes, motion, collisions, and eventually a game you design yourself.
          The rest of the time you work in text, where text is genuinely the
          point.
        </p>

        <h3 class="mt-5">Course Content</h3>

        <h4 class="mt-2">Quarter 1: Creative Development, and the Language</h4>
        <div class="accordion mb-5" id="unit1Accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g1"
                aria-expanded="false"
                aria-controls="u1g1"
              >
                Part 1: Getting Started
              </button>
            </h2>
            <div
              id="u1g1"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <h6 class="text-sn-theme mt-2">Setup</h6>
                <ListItem>
                  <a href="./setup">Setting Up Your Workspace</a>
                </ListItem>

                <h6 class="text-sn-theme mt-3">Getting Started</h6>
                <ListItem>
                  <a href="./unit-1/1-1">Activity 1.1: Welcome to AP CSP</a>
                </ListItem>

                <h6 class="text-sn-theme mt-3">Drawing and Variables</h6>
                <ListItem>
                  <a href="./unit-1/1-2">Activity 1.2: Your First Window</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-3">Activity 1.3: Naming Your Numbers</a>
                </ListItem>

                <h6 class="text-sn-theme mt-3">Input and Arithmetic</h6>
                <ListItem>
                  <a href="./unit-1/1-4">Activity 1.4: Asking a Question</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-5">Activity 1.5: Doing the Math</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-6">Activity 1.6: Ask, Compute, Answer</a>
                </ListItem>
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g2"
                aria-expanded="false"
                aria-controls="u1g2"
              >
                Part 2: Motion and Decisions
              </button>
            </h2>
            <div
              id="u1g2"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <h6 class="text-sn-theme mt-2">Motion</h6>
                <ListItem>
                  <a href="./unit-1/1-7">Activity 1.7: Making It Move</a>
                </ListItem>

                <h6 class="text-sn-theme mt-3">Decisions</h6>
                <ListItem>
                  <a href="./unit-1/1-8">Activity 1.8: True or False</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-9">Activity 1.9: Deciding at the Edges</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-10">Activity 1.10: More Than Two Choices</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-11"
                    >Activity 1.11: Asking Two Things at Once</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-12">Activity 1.12: The Crossing</a>
                </ListItem>

                <h6 class="text-sn-theme mt-3">Control and Collision</h6>
                <ListItem>
                  <a href="./unit-1/1-13">Activity 1.13: Taking Control</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-14"
                    >Activity 1.14: Touching, and Remembering</a
                  >
                </ListItem>
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g3"
                aria-expanded="false"
                aria-controls="u1g3"
              >
                Part 3: Loops and Tables
              </button>
            </h2>
            <div
              id="u1g3"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <h6 class="text-sn-theme mt-2">Loops</h6>
                <ListItem>
                  <a href="./unit-1/1-15">Activity 1.15: Doing It Again</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-16">Activity 1.16: Counting Loops</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-17">Activity 1.17: Loops Inside Loops</a>
                </ListItem>

                <h6 class="text-sn-theme mt-3">Tables</h6>
                <ListItem>
                  <a href="./unit-1/1-18">Activity 1.18: Tables as Lists</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-19"
                    >Activity 1.19: How Long, and What Is Not There</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-20"
                    >Activity 1.20: Going Through a Table</a
                  >
                </ListItem>
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g4"
                aria-expanded="false"
                aria-controls="u1g4"
              >
                Part 4: Functions and the Creative Artifact
              </button>
            </h2>
            <div
              id="u1g4"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <h6 class="text-sn-theme mt-2">Functions</h6>
                <ListItem>
                  <a href="./unit-1/1-21">Activity 1.21: Making Your Own Box</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-22"
                    >Activity 1.22: Handing an Answer Back</a
                  >
                </ListItem>

                <ListItem>
                  <a href="./unit-1/1-23"
                    >Activity 1.23: The Fleet, and Who Calls What</a
                  >
                </ListItem>

                <h6 class="text-sn-theme mt-3">Creative Artifact</h6>
                <ListItem>
                  <a href="./unit-1/1-24"
                    >Activity 1.24: Creative Artifact &mdash; The Plan</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-25"
                    >Activity 1.25: Creative Artifact &mdash; Build</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/wr-artifact"
                    >Written Response: Your Creative Artifact</a
                  >
                </ListItem>

                <h6 class="text-sn-theme mt-3">Review and Exam</h6>
                <ListItem>
                  <a href="./unit-1/sum-getting-started"
                    >Section Summary: Getting Started</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/sum-motion-and-decisions"
                    >Section Summary: Motion and Decisions</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/sum-loops-and-tables"
                    >Section Summary: Loops and Tables</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/sum-functions">Section Summary: Functions</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/1-26">Activity 1.26: Quarter 1 Exam</a>
                </ListItem>

                <h6 class="text-sn-theme mt-3">Code Challenges</h6>
                <ListItem>
                  <a href="./unit-1/cc-set-1">Code Challenge Set 1</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/cc-set-2">Code Challenge Set 2</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/cc-set-3">Code Challenge Set 3</a>
                </ListItem>

                <h6 class="text-sn-theme mt-3">Question Sets</h6>
                <ListItem><a href="./unit-1/mcq-1">Question Set 1</a></ListItem>
                <ListItem><a href="./unit-1/mcq-2">Question Set 2</a></ListItem>
                <ListItem><a href="./unit-1/mcq-3">Question Set 3</a></ListItem>
                <ListItem><a href="./unit-1/mcq-4">Question Set 4</a></ListItem>
                <ListItem><a href="./unit-1/mcq-5">Question Set 5</a></ListItem>

                <h6 class="text-sn-theme mt-3">Debug Challenges</h6>
                <ListItem>
                  <a href="./unit-1/dc-basics"
                    >Debug Challenge: Values and Arithmetic</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/dc-conditionals">Debug Challenge: Decisions</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/dc-loops">Debug Challenge: Loops</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/dc-tables">Debug Challenge: Tables</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/dc-functions">Debug Challenge: Functions</a>
                </ListItem>

                <h6 class="text-sn-theme mt-3">Pseudocode Challenges</h6>
                <ListItem>
                  <a href="./unit-1/pc-arithmetic"
                    >Pseudocode Challenge: Arithmetic</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/pc-conditionals"
                    >Pseudocode Challenge: Decisions</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/pc-logic"
                    >Pseudocode Challenge: Combining Conditions</a
                  >
                </ListItem>
                <ListItem>
                  <a href="./unit-1/pc-loops">Pseudocode Challenge: Loops</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/pc-lists">Pseudocode Challenge: Lists</a>
                </ListItem>
                <ListItem>
                  <a href="./unit-1/pc-traversal"
                    >Pseudocode Challenge: Walking a List</a
                  >
                </ListItem>
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#u1g5"
                aria-expanded="false"
                aria-controls="u1g5"
              >
                Bonus Projects
              </button>
            </h2>
            <div
              id="u1g5"
              class="accordion-collapse collapse"
              data-bs-parent="#unit1Accordion"
            >
              <div class="accordion-body">
                <p class="text-body-secondary small">
                  Optional and worth extra credit. Nothing later depends on
                  them, and each one says which activity you need to have
                  finished first.
                </p>

                <ChallengeItem
                  href="./unit-1/bp-bouncing-logo"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Extra Credit">Bouncing Logo</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-pong"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Extra Credit">Pong</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-dodger"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Extra Credit">Dodger</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-starfield"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Extra Credit">Starfield</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-game-of-life"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Extra Credit">Conway&rsquo;s Game of Life</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-snake"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Extra Credit">Snake</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-breakout"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Extra Credit">Breakout</ChallengeItem
                >
                <ChallengeItem
                  href="./unit-1/bp-sprite-animation"
                  icon="si-flask"
                  srLabel="Bonus project"
                  tag="Extra Credit">Sprite Animation</ChallengeItem
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

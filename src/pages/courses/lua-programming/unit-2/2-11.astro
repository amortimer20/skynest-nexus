---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";
import { Code as CodeSnippet } from "astro:components";

const HEAD = `-- main.lua

local Enemy = require("enemy")
local collision = require("collision")
`;

const STATE1 = `
local ship
local font
local titleFont
local sounds
local spawnEvery = 0.8
local gameState = "menu"

local player
local bullets
local fireCooldown
local enemies
local spawnTimer
local score
local lives
local invuln

local function resetGame()
  player = { x = 400, y = 500, size = 40, speed = 300 }
  bullets = {}
  fireCooldown = 0
  enemies = {}
  spawnTimer = 0
  score = 0
  lives = 3
  invuln = 0
end
`;

const STATE3 = `
local ship
local font
local titleFont
local sounds
local spawnEvery = 0.8
local gameState = "menu"

local player
local bullets
local fireCooldown
local enemies
local spawnTimer
local score
local lives
local invuln
local shake

local function resetGame()
  player = { x = 400, y = 500, size = 40, speed = 300 }
  bullets = {}
  fireCooldown = 0
  enemies = {}
  spawnTimer = 0
  score = 0
  lives = 3
  invuln = 0
  shake = 0
end
`;

const LOAD = `
function love.load()
  love.graphics.setBackgroundColor(0.05, 0.05, 0.1)
  math.randomseed(os.time())
  ship = love.graphics.newImage("ship.png")
  font = love.graphics.newFont(20)
  titleFont = love.graphics.newFont(48)
  love.graphics.setFont(font)

  sounds = {
    shoot = love.audio.newSource("shoot.wav", "static"),
    hit = love.audio.newSource("hit.wav", "static"),
    explode = love.audio.newSource("explode.wav", "static"),
  }
  sounds.shoot:setVolume(0.35)
  sounds.hit:setVolume(0.6)

  resetGame()
end
`;

const KEY = `
function love.keypressed(key)
  if key == "escape" then
    love.event.quit()
  elseif key == "space" and gameState ~= "playing" then
    resetGame()
    gameState = "playing"
  end
end
`;

const U_GATE1 = `
function love.update(dt)
  if gameState ~= "playing" then
    return
  end

  if love.keyboard.isDown("left", "a") then
    player.x = player.x - player.speed * dt
  end
  if love.keyboard.isDown("right", "d") then
    player.x = player.x + player.speed * dt
  end

  local half = player.size / 2
  player.x = math.max(half, math.min(love.graphics.getWidth() - half, player.x))
`;

const U_GATE3 = `
function love.update(dt)
  shake = shake - dt

  if gameState ~= "playing" then
    return
  end

  if love.keyboard.isDown("left", "a") then
    player.x = player.x - player.speed * dt
  end
  if love.keyboard.isDown("right", "d") then
    player.x = player.x + player.speed * dt
  end

  local half = player.size / 2
  player.x = math.max(half, math.min(love.graphics.getWidth() - half, player.x))
`;

const U_TIMERS1 = `
  fireCooldown = fireCooldown - dt
  invuln = invuln - dt

  if love.keyboard.isDown("space") and fireCooldown <= 0 then
    table.insert(bullets, { x = player.x, y = player.y - 30, size = 6, speed = 500 })
    fireCooldown = 0.15
    sounds.shoot:play()
  end

  for i = #bullets, 1, -1 do
    local b = bullets[i]
    b.y = b.y - b.speed * dt
    if b.y < -20 then
      table.remove(bullets, i)
    end
  end
`;

const U_TIMERS2 = `
  fireCooldown = fireCooldown - dt
  invuln = invuln - dt

  if love.keyboard.isDown("space") and fireCooldown <= 0 then
    table.insert(bullets, { x = player.x, y = player.y - 30, size = 6, speed = 500 })
    fireCooldown = 0.15
    sounds.shoot:clone():play()
  end

  for i = #bullets, 1, -1 do
    local b = bullets[i]
    b.y = b.y - b.speed * dt
    if b.y < -20 then
      table.remove(bullets, i)
    end
  end
`;

const U_SPAWN = `
  spawnTimer = spawnTimer - dt
  if spawnTimer <= 0 then
    table.insert(enemies, Enemy.new(math.random(40, love.graphics.getWidth() - 40)))
    spawnTimer = spawnEvery
  end

  for i = #enemies, 1, -1 do
    local e = enemies[i]
    e:update(dt)
    if e.y > love.graphics.getHeight() + 20 then
      table.remove(enemies, i)
    end
  end
`;

const U_HIT1 = `
  if invuln <= 0 then
    for i = #enemies, 1, -1 do
      if collision.overlaps(enemies[i], player) then
        table.remove(enemies, i)
        lives = lives - 1
        invuln = 2
        sounds.explode:play()
        if lives <= 0 then
          gameState = "gameover"
        end
        break
      end
    end
  end
`;

const U_HIT3 = `
  if invuln <= 0 then
    for i = #enemies, 1, -1 do
      if collision.overlaps(enemies[i], player) then
        table.remove(enemies, i)
        lives = lives - 1
        invuln = 2
        shake = 0.4
        sounds.explode:play()
        if lives <= 0 then
          gameState = "gameover"
        end
        break
      end
    end
  end
`;

const U_TAIL1 = `
  for i = #enemies, 1, -1 do
    for j = #bullets, 1, -1 do
      if collision.overlaps(enemies[i], bullets[j]) then
        table.remove(bullets, j)
        sounds.hit:play()
        enemies[i].hp = enemies[i].hp - 1
        if enemies[i].hp <= 0 then
          table.remove(enemies, i)
          score = score + 1
        end
        break
      end
    end
  end
end
`;

const U_TAIL2 = `
  for i = #enemies, 1, -1 do
    for j = #bullets, 1, -1 do
      if collision.overlaps(enemies[i], bullets[j]) then
        table.remove(bullets, j)

        local thud = sounds.hit:clone()
        thud:setPitch(0.9 + math.random() * 0.3)
        thud:play()

        enemies[i].hp = enemies[i].hp - 1
        if enemies[i].hp <= 0 then
          table.remove(enemies, i)
          score = score + 1
        end
        break
      end
    end
  end
end
`;

const HUD = `
local function drawHud()
  love.graphics.setColor(1, 1, 1)
  love.graphics.print("Score: " .. score, 10, 12)

  for i = 1, lives do
    local x = love.graphics.getWidth() - 24 - (i - 1) * 30
    love.graphics.draw(ship, x, 24, 0, 1, 1, ship:getWidth() / 2, ship:getHeight() / 2)
  end
end
`;

const OVERLAY_FN = `
local function drawOverlay(title, subtitle)
  love.graphics.setColor(0, 0, 0, 0.7)
  love.graphics.rectangle("fill", 0, 0, love.graphics.getWidth(), love.graphics.getHeight())

  love.graphics.setColor(1, 1, 1)
  love.graphics.setFont(titleFont)
  love.graphics.printf(title, 0, 220, love.graphics.getWidth(), "center")

  love.graphics.setFont(font)
  love.graphics.printf(subtitle, 0, 300, love.graphics.getWidth(), "center")
end
`;

const D_WORLD1 = `
function love.draw()
  local blink = invuln > 0 and math.floor(invuln * 10) % 2 == 1

  if not blink then
    love.graphics.setColor(1, 1, 1)
    love.graphics.draw(ship, player.x, player.y, 0, 2, 2, ship:getWidth() / 2, ship:getHeight() / 2)
  end

  love.graphics.setColor(1, 0.9, 0.3)
  for _, b in ipairs(bullets) do
    love.graphics.rectangle("fill", b.x - 2, b.y - 8, 4, 16)
  end

  for _, e in ipairs(enemies) do
    e:draw()
  end

  drawHud()
`;

const D_WORLD3 = `
function love.draw()
  love.graphics.push()
  if shake > 0 then
    love.graphics.translate(math.random(-6, 6), math.random(-6, 6))
  end

  local blink = invuln > 0 and math.floor(invuln * 10) % 2 == 1

  if not blink then
    love.graphics.setColor(1, 1, 1)
    love.graphics.draw(ship, player.x, player.y, 0, 2, 2, ship:getWidth() / 2, ship:getHeight() / 2)
  end

  love.graphics.setColor(1, 0.9, 0.3)
  for _, b in ipairs(bullets) do
    love.graphics.rectangle("fill", b.x - 2, b.y - 8, 4, 16)
  end

  for _, e in ipairs(enemies) do
    e:draw()
  end

  love.graphics.pop()

  drawHud()
`;

const D_TEXT = `
  if gameState == "menu" then
    drawOverlay("SKYNEST", "Press space to play")
  elseif gameState == "gameover" then
    drawOverlay("GAME OVER", "Score " .. score .. " - press space to play again")
  end
end`;

//#region CodeSnippets
const EnemyModule = `-- enemy.lua

local Enemy = {}
Enemy.__index = Enemy

function Enemy.new(x)
  return setmetatable({ x = x, y = -20, size = 30, speed = 120, hp = 2 }, Enemy)
end

function Enemy:update(dt)
  self.y = self.y + self.speed * dt
end

function Enemy:draw()
  love.graphics.setColor(1, 0.3, 0.4)
  love.graphics.rectangle("fill", self.x - self.size / 2, self.y - self.size / 2, self.size, self.size)
end

return Enemy`;

const CollisionModule = `-- collision.lua

local collision = {}

function collision.overlaps(a, b)
  return a.x - a.size / 2 < b.x + b.size / 2
     and a.x + a.size / 2 > b.x - b.size / 2
     and a.y - a.size / 2 < b.y + b.size / 2
     and a.y + a.size / 2 > b.y - b.size / 2
end

return collision`;

const Figure1 = `sounds = {
  shoot = love.audio.newSource("shoot.wav", "static"),
  hit = love.audio.newSource("hit.wav", "static"),
  explode = love.audio.newSource("explode.wav", "static"),
}`;

const Figure2 = `-- Fires thirty times. Fifteen of them make no sound at all.
sounds.shoot:play()

-- Fires thirty times. Thirty of them are heard.
sounds.shoot:clone():play()`;

const Figure3 = `local thud = sounds.hit:clone()
thud:setPitch(0.9 + math.random() * 0.3)
thud:play()`;

const Figure4 = `love.graphics.push()
love.graphics.translate(math.random(-6, 6), math.random(-6, 6))

-- everything drawn here is offset

love.graphics.pop()

-- and everything drawn here is not`;

const Figure5 = `function love.update(dt)
  shake = shake - dt

  if gameState ~= "playing" then
    return
  end

  -- the rest of the timers live down here
end`;

const Task1 =
  HEAD + STATE1 + LOAD + KEY + U_GATE1 + U_TIMERS1 + U_SPAWN + U_HIT1 +
  U_TAIL1 + HUD + OVERLAY_FN + D_WORLD1 + D_TEXT;
const Task2 =
  HEAD + STATE1 + LOAD + KEY + U_GATE1 + U_TIMERS2 + U_SPAWN + U_HIT1 +
  U_TAIL2 + HUD + OVERLAY_FN + D_WORLD1 + D_TEXT;
const Task3 =
  HEAD + STATE3 + LOAD + KEY + U_GATE3 + U_TIMERS2 + U_SPAWN + U_HIT3 +
  U_TAIL2 + HUD + OVERLAY_FN + D_WORLD3 + D_TEXT;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a
          href="/courses/lua-programming/"
          class="btn btn-sm btn-outline-light mb-3"
        >
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Activity 2.11: Sound and Polish</h1>
        <Divider variant="8" classes="mb-5" />

        <!-- Concept -->
        <section id="concept">
          <h2>The Idea</h2>

          <p>
            Your game works and it feels like nothing. Shots leave silently,
            enemies vanish without complaint, and losing a life looks the same
            as not losing one until you count the icons.
          </p>

          <p>
            <b class="text-sn-theme">Feedback is not decoration.</b> It is how
            the game confirms that what you did registered, and it is the
            difference between a program that responds and a program that merely
            changes. This activity adds three sounds and one shaking screen, and
            it is the shortest distance between what you have and something that
            feels like a game.
          </p>

          <h3 class="mt-5">Loading a sound</h3>

          <p>
            <b>Download all three and put them in your skynest folder</b>, next
            to main.lua and ship.png.
          </p>

          <p class="my-4">
            <a
              class="btn btn-outline-primary me-2 mb-2"
              href="/courses/lua-programming/shoot.wav"
              download="shoot.wav"
            >
              <i class="si-download"></i> shoot.wav &mdash; 0.18s
            </a>
            <a
              class="btn btn-outline-primary me-2 mb-2"
              href="/courses/lua-programming/hit.wav"
              download="hit.wav"
            >
              <i class="si-download"></i> hit.wav &mdash; 0.12s
            </a>
            <a
              class="btn btn-outline-primary mb-2"
              href="/courses/lua-programming/explode.wav"
              download="explode.wav"
            >
              <i class="si-download"></i> explode.wav &mdash; 0.55s
            </a>
          </p>

          <Code
            code={Figure1}
            frame="code"
            lang="lua"
            title="main.lua"
            showLineNumbers={false}
          />

          <p class="mt-3">
            The second argument is <b>required</b>, and it is a real decision.{" "}
            <CodeSnippet
              code={`"static"`}
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            decodes the whole file into memory at load, which is right for short
            effects you will play hundreds of times.{" "}
            <CodeSnippet
              code={`"stream"`}
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            decodes as it plays, which is right for a three-minute music track
            you would rather not unpack into RAM.
          </p>

          <p>
            A table keyed by name beats three separate locals, and it is the
            record table from Activity 1.10 doing ordinary work. Loading goes in{" "}
            <CodeSnippet
              code="love.load"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            for the third time on this course, for the third identical reason.
          </p>

          <h3 class="mt-5">The thing about play() that will confuse you</h3>

          <p>
            Here is the behavior nobody warns you about, taken from LÖVE's own
            source rather than from folklore:{" "}
            <b class="text-sn-theme">calling play() on a Source that is already
            playing does nothing at all.</b> It does not restart the sound and it
            does not layer a second copy over it. The call is simply lost, and
            nothing tells you.
          </p>

          <p>
            That matters immediately, because your fire cooldown is 0.15 seconds
            and shoot.wav is 0.18 seconds long.{" "}
            <b>Hold the fire button for five seconds and you fire thirty shots
            and hear fifteen of them.</b> I ran exactly that under a harness: 15
            heard, 15 silently discarded. The game is not broken, the gun just
            sounds wrong and you cannot see why.
          </p>

          <Code
            code={Figure2}
            frame="code"
            lang="lua"
            title="main.lua"
            showLineNumbers={false}
          />

          <p class="mt-3">
            <CodeSnippet
              code="clone()"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            hands back a new Source pointing at the <i>same decoded audio</i>{" "}
            &mdash; LÖVE's copy constructor shares the buffer and copies the
            pitch, volume and loop settings &mdash; so cloning a{" "}
            <CodeSnippet
              code={`"static"`}
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            sound is cheap. Same five seconds, same thirty shots, thirty heard.
            Note that cloning a{" "}
            <CodeSnippet
              code={`"stream"`}
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            source is <i>not</i> cheap, because it has to clone the decoder too.
          </p>

          <p>
            There is a second reason to clone, and it is the more interesting
            one. <b>Pitch and volume belong to the Source, not to the sound.</b>{" "}
            If you want every hit slightly detuned so a burst of them does not
            sound mechanical, each hit needs a Source of its own.
          </p>

          <Code
            code={Figure3}
            frame="code"
            lang="lua"
            title="main.lua"
            showLineNumbers={false}
          />

          <p class="mt-3">
            <b>There is a ceiling.</b> LÖVE keeps a pool of 64 simultaneous
            voices; past that,{" "}
            <CodeSnippet
              code="play()"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            returns false and the sound is dropped. Thirty shots over five
            seconds is nowhere near it, and a clone every frame would be. Since{" "}
            <CodeSnippet
              code="play()"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            returns a boolean, you can find out rather than wonder.
          </p>

          <h3 class="mt-5">Not everything should clone</h3>

          <p>
            The explode sound stays a single shared Source on purpose. You can
            only lose one life at a time, and if two losses ever did coincide,
            one explosion is what you would want to hear.{" "}
            <b class="text-sn-theme">Deciding which sounds clone is a design
            question, not a mechanical one</b>, and "clone everything" is the
            wrong answer as reliably as "clone nothing".
          </p>

          <p>
            Volume is the same kind of judgment. Shooting happens constantly and
            belongs underneath everything else, so it is set to 0.35 once at load
            and every clone inherits it.
          </p>

          <h3 class="mt-5">Screen shake, and the transform stack</h3>

          <Code
            code={Figure4}
            frame="code"
            lang="lua"
            title="main.lua"
            showLineNumbers={false}
          />

          <p class="mt-3">
            <CodeSnippet
              code="translate"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            moves the coordinate system rather than any object, which is why one
            call shakes the entire world and none of your drawing code has to
            know about it.{" "}
            <CodeSnippet
              code="push"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            saves the current transform and{" "}
            <CodeSnippet
              code="pop"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            restores it, so the offset applies to exactly what you put between
            them.
          </p>

          <p>
            <b class="text-sn-theme">The HUD goes after the pop.</b> A score that
            jitters is a bug, not an effect, and the world-versus-screen split
            from Activity 2.9 is finally the difference between two lines of code
            rather than a distinction on paper.
          </p>

          <h3 class="mt-5">One place the countdown cannot go</h3>

          <p>
            The shake timer is the same accumulator you have written four times.
            It is also the first one that cannot live with the others.
          </p>

          <Code
            code={Figure5}
            frame="code"
            lang="lua"
            title="main.lua"
            showLineNumbers={false}
          />

          <p class="mt-3">
            The reason is the guard from Activity 2.10. The last shake of a run
            starts on the hit that <i>ends</i> the run, and one frame later
            update returns early forever &mdash; so a countdown below the guard
            never runs again, and{" "}
            <b>the screen shakes behind the game-over text until you quit.</b>
          </p>

          <p>
            I measured both versions over the same ten-second run. Above the
            guard: 75 shaking frames, three neat bursts. Below it: 184, still
            going when the run ended.{" "}
            <b class="text-sn-theme">The guard is a decision about which work
            belongs to a run, not a gate on all work</b>, and this is the first
            time the difference bites.
          </p>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Build -->
        <section id="build">
          <h2>Build</h2>

          <p>
            The three .wav files go beside main.lua. enemy.lua and collision.lua
            are untouched.
          </p>

          <hr class="my-4" />

          <h3>Task 1: Three sounds</h3>
          <ul>
            <li>
              Add a{" "}
              <CodeSnippet
                code="sounds"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />{" "}
              local to the top group of the state block &mdash; it belongs to the
              program, not to a run &mdash; and fill it in{" "}
              <CodeSnippet
                code="love.load"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />.
            </li>
            <li>
              Turn the shooting down to 0.35 and the hit to 0.6. <b>The loudest
              sound in a game is rarely the one that happens most.</b>
            </li>
            <li>
              Play shoot when a bullet is created, hit when a bullet lands, and
              explode when a life is lost.
            </li>
            <li>
              <b class="text-sn-theme">Hold the fire button and listen.</b> The
              gun stutters, because half the shots are landing on a Source that
              is still busy. Nothing is broken; you are hearing exactly what the
              code asked for.
            </li>
          </ul>

          <Code
            code={Task1}
            frame="code"
            lang="lua"
            title="main.lua"
            ins={{ range: "9, 40-48, 82, 113, 126" }}
          />

          <hr class="my-4" />

          <h3>Task 2: Clone the ones that overlap</h3>
          <ul>
            <li>
              Shooting becomes{" "}
              <CodeSnippet
                code="sounds.shoot:clone():play()"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />. One character of thought, and the stutter is gone.
            </li>
            <li>
              Give the hit sound its own clone and a random pitch between 0.9 and
              1.2, so a run of hits does not sound like a machine.
            </li>
            <li>
              <b>Leave explode alone.</b> One shared Source is correct there, and
              being able to say why is the point of the task.
            </li>
            <li>
              Hold fire again. Every shot now speaks, and the two sounds sit on
              top of each other the way they should.
            </li>
          </ul>

          <Code
            code={Task2}
            frame="code"
            lang="lua"
            title="main.lua"
            ins={{ range: "82, 126-130" }}
          />

          <hr class="my-4" />

          <h3>Task 3: Make the screen flinch</h3>
          <ul>
            <li>
              Add{" "}
              <CodeSnippet
                code="shake"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />{" "}
              to the per-run group and zero it in{" "}
              <CodeSnippet
                code="resetGame"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />. Set it to 0.4 when a life is lost.
            </li>
            <li>
              Count it down <b class="text-sn-theme">above the early return</b>,
              on its own, for the reason above.
            </li>
            <li>
              Wrap the world in{" "}
              <CodeSnippet
                code="push"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />{" "}
              and{" "}
              <CodeSnippet
                code="pop"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />{" "}
              and translate by a small random offset while the timer runs. Leave
              the HUD and the overlay outside.
            </li>
            <li>
              Die on purpose. The world lurches for four tenths of a second, the
              score sits perfectly still, and then it stops.
            </li>
          </ul>

          <Code
            code={Task3}
            frame="code"
            lang="lua"
            title="main.lua"
            ins={{ range: "21, 32, 64-65, 117, 170-174, 190-191" }}
          />

          <hr class="my-4" />

          <h3>Challenge (Optional)</h3>
          <ul>
            <li>
              <b>A scrolling starfield.</b> Build a table of sixty stars with an
              x, a y and a speed in{" "}
              <CodeSnippet
                code="resetGame"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />, move them down in update, and wrap them to the top when they
              pass the bottom. Draw them first, before anything else. It is
              entirely Unit 1 &mdash; a list of tables and a loop &mdash; and it
              transforms how the game looks. Give the faster ones a brighter
              color and you have parallax for free.
            </li>
            <li>
              <b>Flash an enemy white when it is hit.</b> Give it a{" "}
              <CodeSnippet
                code="flash"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />{" "}
              field, set it to 0.06 on a hit, count it down in{" "}
              <CodeSnippet
                code="Enemy:update"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />{" "}
              and pick the color in{" "}
              <CodeSnippet
                code="Enemy:draw"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />. <b>All of it lands in enemy.lua</b>, which is Activity 2.8
              paying you back.
            </li>
            <li>
              <b>Add music.</b> Find a loop you like, load it with{" "}
              <CodeSnippet
                code={`"stream"`}
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />{" "}
              rather than{" "}
              <CodeSnippet
                code={`"static"`}
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />, call{" "}
              <CodeSnippet
                code="setLooping(true)"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />, and start it in{" "}
              <CodeSnippet
                code="love.load"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />. It must not be cloned and it must not be restarted on every
              new game.
            </li>
            <li>
              <b>Mute on the m key.</b>{" "}
              <CodeSnippet
                code="love.audio.setVolume(0)"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />{" "}
              silences everything at once, including clones that do not exist
              yet. Keep a boolean and flip it in{" "}
              <CodeSnippet
                code="love.keypressed"
                lang={"lua"}
                theme={"material-theme-ocean"}
                inline
              />{" "}
              &mdash; and note this is one of the few times a boolean really is
              the right shape, because there is no timer underneath it to derive
              the answer from.
            </li>
          </ul>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Checkpoint -->
        <section id="checkpoint">
          <h2>Check Your Work</h2>

          <ul>
            <li>
              Held fire is a steady stream of shots, not a stutter. Every trigger
              pull makes a noise.
            </li>
            <li>
              Hits are audibly different from each other, because each one is a
              clone with its own pitch.
            </li>
            <li>
              Losing a life sounds heavy and the world lurches for four tenths of
              a second. <b class="text-sn-theme">The score and the life icons do
              not move.</b>
            </li>
            <li>
              The shaking <i>stops</i>, including on the hit that ends the run.
            </li>
          </ul>

          <p>
            If half your shots are silent, you skipped{" "}
            <CodeSnippet
              code="clone()"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />. If the game will not start at all, check that all three .wav
            files are beside main.lua and that both arguments are present in{" "}
            <CodeSnippet
              code="newSource"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            &mdash; the type is not optional. If the HUD shakes with the world,
            it is inside the{" "}
            <CodeSnippet
              code="push"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />{" "}
            and{" "}
            <CodeSnippet
              code="pop"
              lang={"lua"}
              theme={"material-theme-ocean"}
              inline
            />. And if the screen never stops shaking after the last life, the
            countdown is below the early return.
          </p>
        </section>

        <div class="d-flex justify-content-between mt-5">
          <a
            class="btn btn-outline-light"
            href="/courses/lua-programming/unit-2/2-10"
          >
            <i class="si-arrow-left"></i> Previous
          </a>
          <a
            class="btn btn-outline-primary"
            href="/courses/lua-programming/unit-2/2-12"
          >
            Next: Shipping Your Game <i class="si-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </div>

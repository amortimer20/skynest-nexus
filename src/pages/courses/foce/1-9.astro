---
import Presentation from "../../../components/Presentation.astro";
import Divider from "../../../components/ui/Divider.astro";
import Layout from "../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Figure1 = `radius = float(input("Enter radius: "))
circumference = 2 * math.pi * radius

print(f"Circumference: {circumference}")`;
const Figure2 = `Enter radius: 42
Circumference: 263.89378290154264`;
const Figure3 = `print(round(263.8938))
print(round(263.8938, 2))`;
const Figure4 = `264
263.89`;
const Figure5 = `side = 2

print(side ** 3)
print(math.pow(side, 3))`;
const Figure6 = `8
8.0`;
const Figure7 = `print(math.sqrt(45))`;
const Figure8 = `6.708203932499369`;
const Task1 = `import math

radius = float(input("Enter radius: "))
circumference = 2 * math.pi * radius

print(f"Circumference: {circumference}")
print(f"Rounded: {round(circumference, 2)}")
`;
const Task2 = `import math

radius = float(input("Enter radius: "))
circumference = 2 * math.pi * radius

print(f"Circumference: {circumference}")
print(f"Rounded: {round(circumference, 2)}")

side = float(input("Enter a side length: "))
exponent = int(input("Enter an exponent: "))

print(f"{side} ** {exponent} is {side ** exponent}")
print(f"math.pow({side}, {exponent}) is {math.pow(side, exponent)}")
`;
const Task3 = `import math

radius = float(input("Enter radius: "))
circumference = 2 * math.pi * radius

print(f"Circumference: {circumference}")
print(f"Rounded: {round(circumference, 2)}")

side = float(input("Enter a side length: "))
exponent = int(input("Enter an exponent: "))

print(f"{side} ** {exponent} is {side ** exponent}")
print(f"math.pow({side}, {exponent}) is {math.pow(side, exponent)}")

number = float(input("Enter a positive number: "))
print(f"Square root of {number} is {math.sqrt(number)}")
`;
const SampleOutput = `Enter radius: 42
Circumference: 263.89378290154264
Rounded: 263.89
Enter a side length: 2
Enter an exponent: 3
2.0 ** 3 is 8.0
math.pow(2.0, 3) is 8.0
Enter a positive number: 45
Square root of 45.0 is 6.708203932499369`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/foce/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Activity 1.9: Math Functions</h1>
        <Divider variant="8" classes="mb-5" />

        <!-- Launch / Concept -->
        <section id="launch">
          <Presentation>
            <section>
              <h2>Activity 1.9</h2>
              <h3 class="text-sn-theme">Math Functions</h3>
            </section>

            <section>
              <h2>Key Concepts</h2>
              <p>Modules</p>
              <p>The <code>math</code> module</p>
            </section>

            <section data-auto-animate>
              <h2>Not Everything Is Built In</h2>
              <p>
                Some tools aren't part of core Python &mdash; you bring
                them in with <code>import</code>. A collection of tools you
                import like this is called a <b class="text-sn-theme">module</b>.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Today's Module: math</h2>
              <p>
                Constants and functions for more advanced math than{" "}
                <code>+</code>, <code>-</code>, <code>*</code>, and{" "}
                <code>/</code> can do alone.
              </p>
              <p class="fragment"><code>import math</code></p>
            </section>

            <section data-auto-animate>
              <h2>math.pi</h2>
              <p>
                A constant &mdash; no parentheses, because you're not
                calling a function, just reading a stored value.
              </p>
              <Code code={Figure1} frame="code" lang="python" showLineNumbers={false} />
            </section>

            <section data-auto-animate>
              <h2>math.pi</h2>
              <Code code={Figure2} frame="terminal" lang="txt" showLineNumbers={false} />
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>That Number Is Ugly. Fix It With round()</h2>
              <p>
                <code>round()</code> is built in &mdash; no <code>math.</code>
                needed. One argument rounds to a whole number; a second
                argument rounds to that many decimal places.
              </p>
              <Code code={Figure3} frame="code" lang="python" showLineNumbers={false} />
            </section>

            <section data-auto-animate>
              <h2>That Number Is Ugly. Fix It With round()</h2>
              <Code code={Figure4} frame="terminal" lang="txt" showLineNumbers={false} />
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Wait &mdash; Haven't We Done Exponents Already?</h2>
              <p>
                Activity 1.4 taught <code>**</code> for exponents.
                <code>math.pow()</code> does the exact same job.
              </p>
              <Code code={Figure5} frame="code" lang="python" showLineNumbers={false} />
            </section>

            <section data-auto-animate>
              <h2>One Real Difference</h2>
              <Code code={Figure6} frame="terminal" lang="txt" showLineNumbers={false} />
              <p class="fragment">
                <code>math.pow()</code> always returns a <code>float</code>,
                even when the answer is a whole number. <code>**</code>
                doesn't. In your own code, <code>**</code> is still the more
                common choice &mdash; but you'll see <code>math.pow()</code>
                in other people's code, so it's worth recognizing.
              </p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>math.sqrt()</h2>
              <p>Square roots &mdash; no exponent trick required.</p>
              <Code code={Figure7} frame="code" lang="python" showLineNumbers={false} />
            </section>

            <section data-auto-animate>
              <h2>math.sqrt()</h2>
              <Code code={Figure8} frame="terminal" lang="txt" showLineNumbers={false} />
            </section>

            <section>
              <h2>Today's Objectives</h2>
              <ul>
                <li>Importing a module for the first time</li>
                <li>Using the <code>math.pi</code> constant</li>
                <li>Rounding with <code>round()</code></li>
                <li>Comparing <code>math.pow()</code> to <code>**</code></li>
                <li>Calculating square roots with <code>math.sqrt()</code></li>
              </ul>
            </section>

            <section>
              <h2>Key Terms</h2>
              <div class="text-start">
                <dl>
                  <dt>Module</dt>
                  <dd>A collection of tools not built directly into Python &mdash; you bring it in with <code>import</code>.</dd>
                  <dt>Constant</dt>
                  <dd>A named value, like <code>math.pi</code>, that doesn't change &mdash; read directly, not called with <code>()</code>.</dd>
                  <dt>round()</dt>
                  <dd>Built-in function that rounds a number, optionally to a specific number of decimal places.</dd>
                  <dt>math.pow()</dt>
                  <dd>Raises a number to a power, same job as <code>**</code>, but always returns a <code>float</code>.</dd>
                  <dt>math.sqrt()</dt>
                  <dd>Returns the square root of a non-negative number.</dd>
                </dl>
              </div>
            </section>
          </Presentation>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Build -->
        <section id="build">
          <h2>Build</h2>

          <p>
            Create a new Python script named <b class="text-sn-theme">1-9-math-functions.py</b>.
          </p>

          <hr class="my-4" />

          <h3>Task 1: Circumference Calculator</h3>
          <ul>
            <li>Import the <code>math</code> module.</li>
            <li>Ask the user for a radius, then calculate and print the circumference using <code>math.pi</code>.</li>
            <li>Print the circumference again, rounded to 2 decimal places with <code>round()</code>.</li>
          </ul>

          <Code code={Task1} frame="code" lang="python" title="1-9-math-functions.py" mark="8" />

          <hr class="my-4" />

          <h3>Task 2: ** vs. math.pow()</h3>
          <ul>
            <li>Ask for a side length and an exponent.</li>
            <li>Print the result using <code>**</code>, then print the result using <code>math.pow()</code>, each labeled.</li>
          </ul>

          <Code code={Task2} frame="code" lang="python" title="1-9-math-functions.py" mark="13-14" ins="10-14" />

          <hr class="my-4" />

          <h3>Task 3: Square Roots</h3>
          <ul>
            <li>Ask for a positive number and print its square root using <code>math.sqrt()</code>.</li>
          </ul>

          <Code code={Task3} frame="code" lang="python" title="1-9-math-functions.py" mark="17" ins="16-17" />

          <hr class="my-4" />

          <h3>Challenge (Optional): Ceiling and Floor</h3>
          <ul>
            <li>
              Look up <code>math.ceil()</code> and <code>math.floor()</code>
              in the <a href="https://docs.python.org/3/library/math.html" target="_blank" rel="noopener">Python docs</a>.
            </li>
            <li>Print a decimal number three ways: rounded, ceiling, and floor, and compare all three.</li>
          </ul>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Checkpoint -->
        <section id="checkpoint">
          <h2>Checkpoint</h2>

          <p>Verify your program works correctly.</p>

          <Code
            code={SampleOutput}
            frame="terminal"
            lang="txt"
            showLineNumbers={false}
            title="Example Output"
          />
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Reflection -->
        <section id="reflection">
          <h2>Reflection</h2>

          <p>Answer the following questions before submitting your work.</p>

          <ol>
            <li>What is a module, and why does <code>math</code> need to be imported when <code>round()</code> doesn't?</li>
            <li>What's the one real difference between <code>**</code> and <code>math.pow()</code>, since they do the same job?</li>
            <li>Why does <code>math.pi</code> get used without parentheses, while <code>math.sqrt()</code> needs them?</li>
          </ol>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Submit -->
        <section id="submit">
          <h2>Submit</h2>

          <p>Submit the required files to the appropriate dropbox.</p>

          <h1
            class="text-center mt-5 text-sn-theme border border-primary slow-flash"
          >
            Activity Complete
          </h1>
        </section>
      </div>
    </div>
  </div>
</Layout>

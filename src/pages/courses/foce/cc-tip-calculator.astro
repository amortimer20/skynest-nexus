---
import Divider from "../../../components/ui/Divider.astro";
import Layout from "../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const SampleOutput = `
--- Tip Calculator ---
Enter the bill subtotal: 50.00 [Enter]
Enter the tip percentage: 15 [Enter]

Tip amount: $7.50
Total amount: $57.50
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/foce/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Code Challenge: Tip Calculator</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="objective">
          <h2>Objective</h2>

          <p>
            Calculate a tip amount and a bill total from a subtotal and a tip
            percentage.
          </p>

          <h5>Terms</h5>

          <ul>
            <li><b>Subtotal</b> &mdash; the cost of your food and drink</li>
            <li><b>Tip</b> (gratuity) &mdash; additional payment given for a service</li>
            <li><b>Total</b> &mdash; the sum of the subtotal and the tip</li>
          </ul>

          <p>
            A $10 bill with a 20% tip is a $2 tip and a $12 total. A $25 bill
            with an 18% tip is a $4.50 tip and a $29.50 total.
          </p>


          <h4>Skills to Practice</h4>

          <ul>
            <li>Prompting a user for input</li>
            <li>Saving user input to variables</li>
            <li>Converting input to the correct data type</li>
            <li>Performing arithmetic calculations</li>
            <li>Formatting custom output using variables</li>
          </ul>
        </section>

        <hr />

        <section id="tasks">
          <h2>Tasks</h2>

          <ul>
            <li>Create a new <b>Python</b> program named <b class="text-sn-theme">cc-tip-calculator.py</b>.</li>
            <li>Prompt the user to enter the bill subtotal.</li>
            <li>Prompt the user to enter the tip percentage as a whole number &mdash; 20 means 20%.</li>
            <li>Calculate the tip. Formula: <b class="text-sn-cyan">Tip = Subtotal &times; (Percentage &divide; 100)</b></li>
            <li>Calculate the total.</li>
            <li>Display the tip and the total in a clear, formatted way.</li>
            <li>To always show two decimal places on a dollar amount, look up how string formatting works in Python.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

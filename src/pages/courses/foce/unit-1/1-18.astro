---
import Presentation from "../../../../components/Presentation.astro";
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const Figure1 = `score1 = 84
score2 = 91
score3 = 76
score4 = 88
score5 = 95`;
const Figure2 = `scores = [84, 91, 76, 88, 95]`;
const Figure3 = `scores = [84, 91, 76, 88, 95]

print(scores[0])
print(scores[2])`;
const Figure4 = `84
76`;
const Figure5 = `scores = [84, 91, 76, 88, 95]

scores[1] = 100
print(scores)`;
const Figure6 = `[84, 100, 76, 88, 95]`;
const Task1 = `foods = ["pizza", "tacos", "sushi", "pasta", "burgers"]

print(f"First food: {foods[0]}")
print(f"Third food: {foods[2]}")
print(f"Last food: {foods[4]}")
`;
const Task2 = `foods = ["pizza", "tacos", "sushi", "pasta", "burgers"]

print(f"First food: {foods[0]}")
print(f"Third food: {foods[2]}")
print(f"Last food: {foods[4]}")

foods[0] = "ramen"
foods[4] = "waffles"

print(f"Updated foods: {foods}")
`;
const SampleOutput = `First food: pizza
Third food: sushi
Last food: burgers
Updated foods: ['ramen', 'tacos', 'sushi', 'pasta', 'waffles']`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/foce/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Activity 1.18: Intro to Lists</h1>
        <Divider variant="8" classes="mb-5" />

        <!-- Launch / Concept -->
        <section id="launch">
          <Presentation>
            <section>
              <h2>Activity 1.18</h2>
              <h3 class="text-sn-theme">Intro to Lists</h3>
            </section>

            <section>
              <h2>Key Concepts</h2>
              <p>Lists</p>
              <p>Indexing</p>
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>The Problem With Separate Variables</h2>
              <p>
                Storing five related scores as five separate variables
                works &mdash; but what about 30 scores? Or 100?
              </p>
              <Code code={Figure1} frame="code" lang="python" showLineNumbers={false} />
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Lists: One Variable, Many Values</h2>
              <p>
                A <b class="text-sn-theme">list</b> stores many related
                values under one variable name, in order, using square
                brackets.
              </p>
              <Code code={Figure2} frame="code" lang="python" showLineNumbers={false} />
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Accessing by Index</h2>
              <p>
                Each value in a list has a position called an{" "}
                <b class="text-sn-theme">index</b>. Python is{" "}
                <b class="text-sn-theme">zero-based</b> &mdash; the first
                value is at index <code>0</code>, not <code>1</code>.
              </p>
              <Code code={Figure3} frame="code" lang="python" showLineNumbers={false} />
            </section>

            <section data-auto-animate>
              <h2>Accessing by Index</h2>
              <Code code={Figure4} frame="terminal" lang="txt" showLineNumbers={false} />
            </section>

            <section data-auto-animate data-auto-animate-restart>
              <h2>Updating an Element</h2>
              <p>
                Assigning to <code>list[index]</code> replaces the value
                already there.
              </p>
              <Code code={Figure5} frame="code" lang="python" showLineNumbers={false} />
            </section>

            <section data-auto-animate>
              <h2>Updating an Element</h2>
              <Code code={Figure6} frame="terminal" lang="txt" showLineNumbers={false} />
            </section>

            <section>
              <h2>Today's Objectives</h2>
              <ul>
                <li>Creating a list with <code>[ ]</code></li>
                <li>Accessing elements by index, starting at <code>0</code></li>
                <li>Updating an element by assigning to its index</li>
              </ul>
            </section>

            <section>
              <h2>Key Terms</h2>
              <div class="text-start">
                <dl>
                  <dt>List</dt>
                  <dd>A single variable that stores multiple values in order.</dd>
                  <dt>Element</dt>
                  <dd>One value stored inside a list.</dd>
                  <dt>Index</dt>
                  <dd>The position of an element in a list.</dd>
                  <dt>Zero-Based Indexing</dt>
                  <dd>The first element of a list is at index <code>0</code>, not <code>1</code>.</dd>
                </dl>
              </div>
            </section>
          </Presentation>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Build -->
        <section id="build">
          <h2>Build</h2>

          <p>
            Create a new Python program named <b class="text-sn-theme">1-18-intro-to-lists</b>.
          </p>

          <hr class="my-4" />

          <h3>Task 1: Create + Access</h3>
          <ul>
            <li>Create a list named <code>foods</code> with 5 favorite foods.</li>
            <li>Print the first, third, and last foods, each with a label.</li>
          </ul>

          <Code code={Task1} frame="code" lang="python" title="Intro to Lists" mark={{ range: "3-5" }} />

          <hr class="my-4" />

          <h3>Task 2: Update Elements</h3>
          <ul>
            <li>Update the first and last foods to new values.</li>
            <li>Print the whole updated list.</li>
          </ul>

          <Code code={Task2} frame="code" lang="python" title="Intro to Lists" mark={{ range: "7-8" }} ins={{ range: "7-10" }} />
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Checkpoint -->
        <section id="checkpoint">
          <h2>Checkpoint</h2>

          <p>Verify your program works correctly.</p>

          <Code
            code={SampleOutput}
            frame="terminal"
            lang="txt"
            showLineNumbers={false}
            title="Example Output"
          />
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Reflection -->
        <section id="reflection">
          <h2>Reflection</h2>

          <p>Answer the following questions before submitting your work.</p>

          <ol>
            <li>What is an index? What is an element?</li>
            <li>Why does the first food live at index <code>0</code> instead of index <code>1</code>?</li>
            <li>If a list has 5 elements, what is the index of the last one?</li>
          </ol>
        </section>

        <Divider variant="8" classes="my-5" />

        <!-- Submit -->
        <section id="submit">
          <h2>Submit</h2>

          <p>Submit the required files to the appropriate dropbox.</p>

          <h1
            class="text-center mt-5 text-sn-theme border border-primary slow-flash"
          >
            Activity Complete
          </h1>
        </section>
      </div>
    </div>
  </div>
</Layout>

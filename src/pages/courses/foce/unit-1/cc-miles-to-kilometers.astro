---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const SampleOutput = `
--- Miles to Kilometers Calculator ---
Enter the distance in miles: 12.5 [Enter]
12.5 miles is equal to 20.11 kilometers
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/foce/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Code Challenge: Miles to Kilometers</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="objective">
          <h2>Objective</h2>

          <p>
            Convert a distance from miles to kilometers based on user input.
          </p>


          <h4>Skills to Practice</h4>

          <ul>
            <li>Prompting a user for input</li>
            <li>Saving user input to variables</li>
            <li>Converting input to the correct data type</li>
            <li>Performing arithmetic calculations</li>
            <li>Formatting custom output using variables</li>
          </ul>
        </section>

        <hr />

        <section id="tasks">
          <h2>Tasks</h2>

          <ul>
            <li>Create a new <b>Python</b> program named <b class="text-sn-theme">cc-miles-to-kilometers.py</b>.</li>
            <li>Prompt the user to enter a distance in miles.</li>
            <li>Convert that value to kilometers. Formula: <b class="text-sn-cyan">Km = Mi &times; 1.609</b></li>
            <li>Optionally, round the answer to two decimal places.</li>
            <li>Display the result in a clear, formatted way.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

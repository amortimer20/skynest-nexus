---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const SampleOutput = `
--- Circle Area Calculator ---
Enter the radius of the circle: 5 [Enter]
The area of the circle is 78.54
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/foce/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Code Challenge: Area of a Circle</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="objective">
          <h2>Objective</h2>

          <p>
            Calculate the area of a circle from a radius entered by the user.
          </p>

          <p>
            Use <b class="text-sn-cyan">math.pi</b> from Activity 1.9 rather
            than typing out 3.14159 &mdash; that is exactly what the{" "}
            <b>math</b> module is for.
          </p>


          <h4>Skills to Practice</h4>

          <ul>
            <li>Prompting a user for input</li>
            <li>Saving user input to variables</li>
            <li>Converting input to the correct data type</li>
            <li>Performing arithmetic calculations</li>
            <li>Formatting custom output using variables</li>
            <li>Using a constant from the <b>math</b> module</li>
          </ul>
        </section>

        <hr />

        <section id="tasks">
          <h2>Tasks</h2>

          <ul>
            <li>Create a new <b>Python</b> program named <b class="text-sn-theme">cc-area-of-a-circle</b>.</li>
            <li>Prompt the user to enter the radius of the circle.</li>
            <li>Calculate the area. Formula: <b class="text-sn-cyan">Area = &pi; &times; radius<sup>2</sup></b></li>
            <li>Optionally, round the answer to two decimal places.</li>
            <li>Display the calculated area in a clear, formatted way.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

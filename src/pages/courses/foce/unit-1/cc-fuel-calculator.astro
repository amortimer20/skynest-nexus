---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const SampleOutput = `
--- Fuel Calculator ---
How many miles are you traveling? 150 [Enter]
What is your vehicle's gas mileage (mpg)? 34 [Enter]
What is the current price of gas per gallon? $2.95 [Enter]

For your trip, you will need 4.4 gallons of gas costing $12.98 total.
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/foce/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Code Challenge: Fuel Calculator</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="objective">
          <h2>Objective</h2>

          <p>
            Work out how much gas a trip needs and what it will cost, from the
            distance, the vehicle's gas mileage, and the price of gas.
          </p>


          <h4>Skills to Practice</h4>

          <ul>
            <li>Prompting a user for input</li>
            <li>Saving user input to variables</li>
            <li>Converting input to the correct data type</li>
            <li>Performing arithmetic calculations</li>
            <li>Formatting custom output using variables</li>
            <li>Rounding decimal numbers</li>
          </ul>
        </section>

        <hr />

        <section id="tasks">
          <h2>Tasks</h2>

          <ul>
            <li>Create a new <b>Python</b> program named <b class="text-sn-theme">cc-fuel-calculator</b>.</li>
            <li>Prompt the user for three values &mdash; the distance, the vehicle's gas mileage in mpg, and the price of gas per gallon.</li>
            <li>Calculate the total gallons of gas needed.</li>
            <li>Round the gallons to one decimal place <i>before</i> you calculate the cost &mdash; that is how the sample output arrives at $12.98.</li>
            <li>Calculate the total cost of that gas.</li>
            <li>Display both results in a clear, formatted way.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

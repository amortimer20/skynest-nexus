---
import Divider from "../../../../components/ui/Divider.astro";
import Layout from "../../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const SampleOutput = `
Enter your birth month (1-12): 12 [Enter]
You're a Winter baby!
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/foce/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Code Challenge: Birth Seasons</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="objective">
          <h2>Objective</h2>

          <p>
            Ask the user for their birth month as a number, then tell them which
            season they were born in.
          </p>

          <h4>Skills to Practice</h4>

          <ul>
            <li>Prompting a user for input</li>
            <li>Converting input to the correct data type</li>
            <li>Writing boolean expressions with ranges</li>
            <li>
              Branching with <code>if</code> / <code>elif</code> / <code>else</code>
            </li>
          </ul>
        </section>

        <hr />

        <section id="tasks">
          <h2>Tasks</h2>

          <ul>
            <li>
              Create a new <b>Python</b> program named <b class="text-sn-theme"
                >cc-birth-seasons.py</b
              >.
            </li>
            <li>Prompt for a birth month as a number from 1 to 12.</li>
            <li>Display the matching message from the table below.</li>
            <li>
              Watch Winter carefully &mdash; it is <b>not</b> one continuous range,
              so it needs <code>or</code>.
            </li>
          </ul>

          <table class="table table-sm table-dark w-auto mt-4">
            <thead><tr><th>Month</th><th>Message</th></tr></thead>
            <tbody>
              <tr><td>1, 2, or 12</td><td>You're a Winter baby!</td></tr>
              <tr><td>3&ndash;5</td><td>You're a Spring baby!</td></tr>
              <tr><td>6&ndash;8</td><td>You're a Summer baby!</td></tr>
              <tr><td>9&ndash;11</td><td>You're a Fall baby!</td></tr>
            </tbody>
          </table>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

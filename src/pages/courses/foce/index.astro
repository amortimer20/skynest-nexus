---
import Layout from "../../../layouts/Layout.astro";
import ListItem from "../../../components/ui/ListItem.astro";
import ChallengeItem from "../../../components/ui/ChallengeItem.astro";

import FoCEIcon from "../../../assets/courses/foce/img/foce-icon.svg";
---

<Layout>
  <div class="py-5 mb-3 bg-sn-darker bottom-shadow">
    <div class="p-5">
      <a href="/#course-content" class="btn btn-sm btn-outline-light"
        ><i class="si-arrow-left"></i> Back</a
      >
    </div>
    <div class="container pb-5">
      <div class="text-center">
        <h1>Fundamentals of Computer Engineering</h1>
        <FoCEIcon width={128} height={128} />
      </div>
    </div>
  </div>

  <div class="container">
    <h3>Course Content</h3>

    <h4 class="mt-2">Unit 1: Computational Thinking</h4>
    <div class="accordion mb-5" id="courseAccordion">
      <!-- Foundations -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseOne"
            aria-expanded="true"
            aria-controls="flush-collapseOne"
          >
            Foundations
          </button>
        </h2>
        <div
          id="flush-collapseOne"
          class="accordion-collapse collapse"
          data-bs-parent="#courseAccordion"
        >
          <div class="accordion-body">
            <h6 class="text-sn-theme mt-2">Programming Basics</h6>
            <ListItem><a href="./1-1">Activity 1.1: Computer Architecture</a></ListItem>
            <ListItem><a href="./1-2">Activity 1.2: Console Output</a></ListItem>
            <ChallengeItem href="./cc-chain-letter">Chain Letter</ChallengeItem>
            <ChallengeItem href="./cc-mail-call">Mail Call</ChallengeItem>
            <ChallengeItem href="./cc-ascii-art">ASCII Art</ChallengeItem>
            <ListItem><a href="./1-3">Activity 1.3: Variables and Data Types</a></ListItem>
            <ListItem><a href="./1-4">Activity 1.4: Arithmetic Operations</a></ListItem>
            <ListItem><a href="./1-5">Activity 1.5: Variable Reassignment</a></ListItem>
            <ListItem><a href="./1-6">Activity 1.6: String Interpolation</a></ListItem>
            <ListItem><a href="./1-7">Activity 1.7: Console Input</a></ListItem>
            <ChallengeItem href="./cc-display-clock">Display Clock</ChallengeItem>
            <ChallengeItem href="./cc-mad-lib">Mad Lib</ChallengeItem>
            <ListItem><a href="./1-8">Activity 1.8: Console Input and Type Casting</a></ListItem>
            <ChallengeItem href="./cc-simple-math">Simple Math</ChallengeItem>
            <ChallengeItem href="./cc-grocery-grab">Grocery Grab</ChallengeItem>
            <ChallengeItem href="./cc-backpack-weight">Backpack Weight</ChallengeItem>
            <ChallengeItem href="./cc-miles-to-kilometers">Miles to Kilometers</ChallengeItem>
            <ChallengeItem href="./cc-celsius-to-fahrenheit">Celsius to Fahrenheit</ChallengeItem>
            <ChallengeItem href="./cc-tip-calculator">Tip Calculator</ChallengeItem>
            <ChallengeItem href="./cc-line-slope">Line Slope Calculator</ChallengeItem>
            <ChallengeItem href="./cc-change-calculator">Change Calculator</ChallengeItem>
            <ChallengeItem href="./cc-height-converter">Height Converter</ChallengeItem>
            <ListItem><a href="./1-9">Activity 1.9: Math Functions</a></ListItem>
            <ChallengeItem href="./cc-area-of-a-circle">Area of a Circle</ChallengeItem>
            <ChallengeItem href="./cc-fuel-calculator">Fuel Calculator</ChallengeItem>

            <h6 class="text-sn-theme mt-3">Debug Challenges</h6>
            <ChallengeItem
              href="./dc-syntax-arithmetic"
              icon="si-bug"
              srLabel="Debug challenge">Syntax &amp; Arithmetic</ChallengeItem
            >
            <ChallengeItem
              href="./dc-runtime-and-casting"
              icon="si-bug"
              srLabel="Debug challenge">Runtime &amp; Casting</ChallengeItem
            >

            <h6 class="text-sn-theme mt-3">Control Flow</h6>
            <ListItem><a href="./1-10">Activity 1.10: Booleans and If Statements</a></ListItem>
            <ListItem><a href="./1-11">Activity 1.11: If, Elif, and Else</a></ListItem>
            <ChallengeItem href="./cc-traffic-light">Traffic Light</ChallengeItem>
            <ChallengeItem href="./cc-birth-seasons">Birth Seasons</ChallengeItem>
            <ChallengeItem href="./cc-hat-size-checker">Hat Size Checker</ChallengeItem>
            <ChallengeItem href="./cc-magic-8-ball">Magic 8-Ball</ChallengeItem>
            <ChallengeItem href="./cc-bmi-calculator">BMI Calculator</ChallengeItem>
            <ChallengeItem href="./cc-quadratics">Quadratics</ChallengeItem>
            <ListItem><a href="./1-12">Activity 1.12: Nested Conditionals</a></ListItem>
            <ChallengeItem href="./cc-build-your-own-dungeon-crawler"
              >Build Your Own Dungeon Crawler</ChallengeItem
            >
            <ListItem><a href="./1-13">Activity 1.13: While Loops</a></ListItem>
            <ListItem><a href="./1-14">Activity 1.14: Number Guessing Game</a></ListItem>
            <ListItem><a href="./1-15">Activity 1.15: Rock, Paper, Scissors</a></ListItem>
            <ChallengeItem href="./cc-heads-or-tails">Heads or Tails</ChallengeItem>
            <ListItem><a href="./1-16">Activity 1.16: For Loops</a></ListItem>
            <ChallengeItem href="./cc-coin-flip-simulation"
              >Coin Flip Simulation</ChallengeItem
            >
            <ChallengeItem
              href="./dc-conditionals"
              icon="si-bug"
              srLabel="Debug challenge">Conditionals</ChallengeItem
            >
            <ChallengeItem href="./dc-loops" icon="si-bug" srLabel="Debug challenge"
              >Loops</ChallengeItem
            >
            <ListItem tag="Optional"
              ><a href="./1-17">Activity 1.17: Nested Loops</a></ListItem
            >

            <h6 class="text-sn-theme mt-3">Lists</h6>
            <ListItem><a href="./1-18">Activity 1.18: Intro to Lists</a></ListItem>
            <ListItem><a href="./1-19">Activity 1.19: len() and Safe Access</a></ListItem>
            <ListItem><a href="./1-20">Activity 1.20: Traversal and append()</a></ListItem>
            <ChallengeItem href="./cc-raffle">Raffle</ChallengeItem>
            <ChallengeItem href="./cc-playlist-builder">Playlist Builder</ChallengeItem>
            <ListItem><a href="./1-21">Activity 1.21: Processing Lists</a></ListItem>
            <ListItem><a href="./1-22">Activity 1.22: Checking Membership</a></ListItem>
            <ListItem><a href="./1-23">Activity 1.23: Parallel Lists</a></ListItem>

            <h6 class="text-sn-theme mt-3">Debug Challenges</h6>
            <ChallengeItem href="./dc-lists" icon="si-bug" srLabel="Debug challenge"
              >Lists</ChallengeItem
            >

            <h6 class="text-sn-theme mt-3">Library Explorations</h6>
            <ChallengeItem
              href="./le-turtle-graphics"
              icon="si-flask"
              srLabel="Library exploration"
              tag="Extra Credit"
              tone="gold">Turtle Graphics</ChallengeItem
            >
            <ChallengeItem
              href="./le-rich-terminal"
              icon="si-flask"
              srLabel="Library exploration"
              tag="Extra Credit"
              tone="gold">Rich</ChallengeItem
            >
          </div>
        </div>
      </div>
      <!-- Group Project 1 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseTwo"
            aria-expanded="false"
            aria-controls="flush-collapseTwo"
          >
            Group Project 1: Terminal Applications
          </button>
        </h2>
        <div
          id="flush-collapseTwo"
          class="accordion-collapse collapse"
          data-bs-parent="#courseAccordion"
        >
          <div class="accordion-body">
            <ListItem><a href="./gp-1">Terminal Applications (End-of-Quarter Summative)</a></ListItem>
          </div>
        </div>
      </div>
    </div>

    <h4 class="mt-2">Unit 2: Physical Computing</h4>
    <div class="accordion mb-5" id="unit2Accordion">
      <!-- Foundations -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseThree"
            aria-expanded="true"
            aria-controls="flush-collapseThree"
          >
            Foundations
          </button>
        </h2>
        <div
          id="flush-collapseThree"
          class="accordion-collapse collapse"
          data-bs-parent="#unit2Accordion"
        >
          <div class="accordion-body">
            <h6 class="text-sn-theme mt-2">Electronics Primer</h6>
            <ListItem><a href="./2-1">Activity 2.1: What Is Electricity?</a></ListItem>
            <ListItem><a href="./2-2">Activity 2.2: Reading Circuits</a></ListItem>
            <ListItem><a href="./2-3">Activity 2.3: Ohm's Law and Meet the Microcontroller</a></ListItem>

            <h6 class="text-sn-theme mt-3">LED Projects</h6>
            <ListItem><a href="./2-4">Activity 2.4: Rocket Launch Countdown</a></ListItem>
            <ListItem><a href="./2-5">Activity 2.5: Writing Your Own Functions</a></ListItem>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
import Divider from "../../../components/ui/Divider.astro";
import Layout from "../../../layouts/Layout.astro";
import { Code } from "astro-expressive-code/components";

//#region CodeSnippets
const SampleOutput = `
--- The Wonderful Journey ---
Enter a noun: Nintendo Entertainment System [Enter]
Enter an adjective: smelly [Enter]
Enter a verb: jump [Enter]
Enter another noun: hot dog [Enter]
Enter an adverb: suspiciously [Enter]

Here is your story:
Once upon a time, a smelly Nintendo Entertainment System decided to jump.
On its journey, it found a mysterious hot dog.
The Nintendo Entertainment System and the hot dog became friends.
Together, they jumped suspiciously into the sunset and lived happily ever
after.
`;
//#endregion
---

<Layout>
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-sm-12 col-md-10">
        <a href="/courses/foce/" class="btn btn-sm btn-outline-light mb-3">
          <i class="si-arrow-left"></i> Back
        </a>

        <h1>Code Challenge: Mad Lib</h1>

        <h4>
          Difficulty&nbsp;&nbsp;
          <i class="si-star text-sn-green"></i>
        </h4>

        <Divider variant="8" classes="mb-5" />

        <section id="objective">
          <h2>Objective</h2>

          <p>Build a console-based mad lib game.</p>

          <p>
            A mad lib is a word game where players fill in blanks with random
            words &mdash; like nouns, verbs, or places &mdash; to complete a
            silly story. The result is often weird, funny, and totally
            unexpected.
          </p>


          <h4>Skills to Practice</h4>

          <ul>
            <li>Asking the user for input</li>
            <li>Storing input in a variable</li>
            <li>Using variables to format and display output</li>
          </ul>
        </section>

        <hr />

        <section id="tasks">
          <h2>Tasks</h2>

          <ul>
            <li>Create a new <b>Python</b> program named <b class="text-sn-theme">cc-mad-lib.py</b>.</li>
            <li>Print a story title at the start of your program.</li>
            <li>Ask the user to enter at least 5 words (for example: a noun, a verb, an adjective).</li>
            <li>Insert those words into a pre-written story template.</li>
            <li>Print the completed story in a fun, readable format.</li>
          </ul>
        </section>

        <hr />

        <section id="sample-output">
          <h2>Sample Output</h2>

          <Code
            code={SampleOutput}
            frame="terminal"
            title="Sample Output"
            lang="txt"
            showLineNumbers={false}
            class="mt-3"
          />
        </section>

        <h1
          class="text-center mt-5 text-sn-theme border border-primary slow-flash"
        >
          Commence Challenge
        </h1>
      </div>
    </div>
  </div>
</Layout>

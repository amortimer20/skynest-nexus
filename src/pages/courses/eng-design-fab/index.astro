---
import Layout from "../../../layouts/Layout.astro";
import ListItem from "../../../components/ui/ListItem.astro";

import EngDesignFabIcon from "../../../assets/courses/eng-design-fab/img/eng-design-fab-icon.svg";
---

<Layout>
  <div class="py-5 mb-3 bg-sn-darker bottom-shadow">
    <div class="p-5">
      <a href="/#course-content" class="btn btn-sm btn-outline-light"
        ><i class="si-arrow-left"></i> Back</a
      >
    </div>
    <div class="container pb-5">
      <div class="text-center">
        <h1>Engineering: Design and Fabrication</h1>
        <EngDesignFabIcon width={128} height={128} />
      </div>
    </div>
  </div>

  <div class="container">
    <h3>How You'll Work</h3>

    <p>
      You'll work in <b>teams</b> for almost everything in this course &mdash;
      every build, every lab, and both major projects. Assume team work unless a
      session says otherwise.
    </p>

    <p class="mb-5">
      Three things are always <b>yours alone</b>, even on a team session:
      the <b>reflection</b> at the end of every session, every{" "}
      <b>quiz and practical</b>, and your <b>safety certifications</b>. Those are
      how you're graded as an individual, so a teammate can't do them for you and
      you can't do them for a teammate.
    </p>

    <h3>Course Content</h3>

    <h4 class="mt-2">Unit 1: Design &amp; Empirical Testing</h4>
    <div class="accordion mb-5" id="courseAccordion">
      <!-- Foundations -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseOne"
            aria-expanded="true"
            aria-controls="flush-collapseOne"
          >
            Foundations
          </button>
        </h2>
        <div
          id="flush-collapseOne"
          class="accordion-collapse collapse"
          data-bs-parent="#courseAccordion"
        >
          <div class="accordion-body">
            <h6 class="text-sn-theme mt-2">Part 1: The Design Cycle</h6>
            <ListItem><a href="./session-1">Session 1: Intro to the Design Cycle</a></ListItem>
            <ListItem><a href="./session-2">Session 2: Problem Framing &amp; Notebook Setup</a></ListItem>
            <ListItem><a href="./session-3">Session 3: Design &amp; Ideation</a></ListItem>

            <h6 class="text-sn-theme mt-3">Part 2: Safety &amp; Precision</h6>
            <ListItem><a href="./session-4">Session 4: Makerspace Safety I</a></ListItem>
            <ListItem><a href="./session-5">Session 5: Makerspace Safety II</a></ListItem>
            <ListItem><a href="./session-6">Session 6: Caliper Use &amp; Precision</a></ListItem>
            <ListItem><a href="./session-7">Session 7: Unit Conversion I</a></ListItem>
            <ListItem><a href="./session-8">Session 8: Unit Conversion II &mdash; Applied Dimensional Analysis</a></ListItem>

            <h6 class="text-sn-theme mt-3">Part 3: Tolerance</h6>
            <ListItem><a href="./session-9">Session 9: Tolerance Concepts</a></ListItem>
            <ListItem><a href="./session-10">Session 10: The Mismatch Activity + Debrief</a></ListItem>

            <h6 class="text-sn-theme mt-3">Part 4: Measurement &amp; Data</h6>
            <ListItem><a href="./session-11">Session 11: Measurement &amp; Data Collection Lab</a></ListItem>
            <ListItem><a href="./session-12">Session 12: Functions &amp; Data Quality in Sheets</a></ListItem>
            <ListItem><a href="./session-13">Session 13: Charting &amp; Trendlines</a></ListItem>
          </div>
        </div>
      </div>
      <!-- Racquet Ball Launcher Project -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseTwo"
            aria-expanded="false"
            aria-controls="flush-collapseTwo"
          >
            Racquet Ball Launcher Project
          </button>
        </h2>
        <div
          id="flush-collapseTwo"
          class="accordion-collapse collapse"
          data-bs-parent="#courseAccordion"
        >
          <div class="accordion-body">
            <ListItem><a href="./session-14-15">Sessions 14&ndash;15: Research &amp; Design</a></ListItem>
            <ListItem><a href="./session-16-19">Sessions 16&ndash;19: Build (Iteration 1)</a></ListItem>
            <ListItem><a href="./session-20-22">Sessions 20&ndash;22: Test &amp; Calibrate</a></ListItem>
            <ListItem><a href="./session-23-24">Sessions 23&ndash;24: Iterate &amp; Re-calibrate</a></ListItem>
            <ListItem><a href="./session-25">Session 25: Field Test Day</a></ListItem>
            <ListItem><a href="./session-26">Session 26: Reflect &amp; Defend</a></ListItem>
          </div>
        </div>
      </div>
    </div>

    <h4 class="mt-2">Unit 2: Digital Manufacturing</h4>
    <div class="accordion mb-5" id="unit2Accordion">
      <!-- Manufacturing Foundations -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseThree"
            aria-expanded="false"
            aria-controls="flush-collapseThree"
          >
            Manufacturing Foundations
          </button>
        </h2>
        <div
          id="flush-collapseThree"
          class="accordion-collapse collapse"
          data-bs-parent="#unit2Accordion"
        >
          <div class="accordion-body">
            <ListItem><a href="./unit-2/session-1">Session 1: Welcome to Digital Manufacturing</a></ListItem>
            <ListItem><a href="./unit-2/session-2">Session 2: Materials for Subtractive Manufacturing</a></ListItem>
            <ListItem><a href="./unit-2/session-3">Session 3: Additive Manufacturing</a></ListItem>
            <ListItem><a href="./unit-2/session-4">Session 4: CNC Safety Certification</a></ListItem>
            <ListItem><a href="./unit-2/session-5">Session 5: CAD Leveling-Up I &mdash; Assemblies</a></ListItem>
            <ListItem><a href="./unit-2/session-6">Session 6: CAD Leveling-Up II &mdash; A Full Practice Assembly</a></ListItem>
            <ListItem><a href="./unit-2/session-7">Session 7: Toolpath Types &amp; Profile Offset</a></ListItem>
            <ListItem><a href="./unit-2/session-8">Session 8: Pockets, Step-Over &amp; Step-Down</a></ListItem>
            <ListItem><a href="./unit-2/session-9">Session 9: Apply CAM to a Practice Piece</a></ListItem>
            <ListItem><a href="./unit-2/session-10">Session 10: Post-Processing &amp; Troubleshooting</a></ListItem>
            <ListItem><a href="./unit-2/session-11">Session 11: Design Your Practice Build</a></ListItem>
            <ListItem><a href="./unit-2/session-12">Session 12: Program Your Practice Build's CAM</a></ListItem>
            <ListItem><a href="./unit-2/session-13">Session 13: Cut Your Practice Build</a></ListItem>
            <ListItem><a href="./unit-2/session-14">Session 14: Evaluate &amp; Reflect</a></ListItem>
          </div>
        </div>
      </div>
      <!-- Arcade Cabinet Project -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-collapseFour"
            aria-expanded="false"
            aria-controls="flush-collapseFour"
          >
            Arcade Cabinet Project
          </button>
        </h2>
        <div
          id="flush-collapseFour"
          class="accordion-collapse collapse"
          data-bs-parent="#unit2Accordion"
        >
          <div class="accordion-body">
            <ListItem><a href="./unit-2/session-15-16">Sessions 15&ndash;16: Receive &amp; Translate the Brief</a></ListItem>
            <ListItem><a href="./unit-2/session-17-20">Sessions 17&ndash;20: Concept, Material &amp; CAD</a></ListItem>
            <ListItem><a href="./unit-2/session-21-22">Sessions 21&ndash;22: CAM Programming</a></ListItem>
            <ListItem><a href="./unit-2/session-23-26">Sessions 23&ndash;26: Fabrication &amp; Build</a></ListItem>
            <ListItem><a href="./unit-2/session-27-28">Sessions 27&ndash;28: Present Back &amp; Reflect</a></ListItem>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
